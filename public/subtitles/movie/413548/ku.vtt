987
01:00:17.966 --> 01:00:20.925
" سەربەخۆیی "

988
01:00:21.050 --> 01:00:24.841
" سەربەخۆیی "

989
01:00:24.966 --> 01:00:28.216
" سەربەخۆیی "

990
01:00:28.341 --> 01:00:31.091
" سەربەخۆیی "

991
01:00:31.216 --> 01:00:33.466
" سەربەخۆیی "

992
