کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ کچ

693
00:49:40.441 --> 00:49:41.688
-ئەی، ئەی.

694
00:49:41.816 --> 00:49:43.801
- زۆر دڵسۆزە.

695
00:49:44.217 --> 00:49:45.752
تکایە چیتر ئازاری مەدا، پیاوە.

696
00:49:45.881 --> 00:49:48.440
ئێستا، ئەوە بە تۆوە دەبێت، فڕید.

697
00:49:48.568 --> 00:49:51.577
ئەوە دەکەوێتە ئەستۆی تۆ و خوشکەکەت.

698
00:49:52.312 --> 00:49:54.106
من تێناگەم

699
00:49:54.232 --> 00:49:56.312
ڕەیچێل منی دوورخستەوە

700
00:49:56.441 --> 00:49:58.232
وەک بێ نرخترین گەندەڵ کە تا ئێستا ئەم سیارەیەدا ڕۆیشتووە.

701
00:49:58.361 --> 00:50:00.056
دەزانیت چی، فرێد؟

702
00:50:01.848 --> 00:50:03.928
من پێشمەرگ نیم.

703
00:50:05.497 --> 00:50:08.473
هەموو هەوڵ و قوربانییەک کە لە ژیانی نادیارمدا داوە

704
00:50:08.600 --> 00:50:11.608
لە بری کارکردن و دادگاییکردنی...

705
00:50:12.057 --> 00:50:13.306
پشتگوێخراو.

706
00:50:14.009 --> 00:50:17.401
من چوم و چووم و هەڵم و هەڵم.

707
00:50:19.865 --> 00:50:21.689
بۆیە پێم وایە "با چێژ بدە" فڕید.

708
00:50:21.817 --> 00:50:25.241
من بەم شێوەیە بەشداری خۆم دەکەم، لە ڕێگەی توندوتیژی و تۆڵەکردنەوە.

709
00:50:25.369 --> 00:50:27.032
چونکە ئەوە هەموو شتێکم ماوە

710
00:50:27.161 --> 00:50:30.393
سەیرکەر، چێشتخانەم هەیە و 10 دۆلارم هەیە.

711
00:50:30.521 --> 00:50:33.049
من بۆ پارەکەت لێرە نیم، فڕید.

712
00:50:34.616 --> 00:50:36.858
من لێرەم بۆ ئەوەی خوشکەکەت بزانێت

713
00:50:36.985 --> 00:50:39.673
کە قسەکان و کردەوەکانی دەرئەنجامیان هەیە.

714
00:50:39.801 --> 00:50:42.010
تکایە با خۆشەویستەکەم بڕوات - باشه ، ده که م -

715
00:50:42.136 --> 00:50:44.248
تکایە - دەكەم -

716
00:50:48.920 --> 00:50:50.361
بینی چی کردووە، ئەو خوشکەی تۆ؟

717
00:50:50.489 --> 00:50:52.409
سەیری ئەوە بکە کە ئێستا چی کردووە، فڕید!

718
00:50:57.752 --> 00:51:00.440
باشە، هاوڕێیان، دەتوانن ئەم دەروازانە دابخەن؟

719
00:51:04.185 --> 00:51:05.497
چییه ؟

720
00:51:14.329 --> 00:51:15.417
ئەی خودایە

721
00:51:18.041 --> 00:51:20.505
دایک و باوکێکە، باشە، خانم فلین؟

722
00:51:27.416 --> 00:51:29.658
ئەمە ئەو بابەتەی نەبوو کە باسیمان کرد.

723
00:51:30.200 --> 00:51:31.993
بەڵێ، باشە، سەرسوڕپییە لعنەکە.

724
00:51:32.409 --> 00:51:34.201
<i>پولیسم بانگکرد.</i>

725
00:51:34.329 --> 00:51:36.088
بێگومان بوو.

726
00:51:36.537 --> 00:51:38.425
تکایە، تەنها...

727
00:51:39.513 --> 00:51:41.145
تەنها بیبەخشە، باشه؟

728
00:51:41.593 --> 00:51:43.001
تۆ لە ناویت یان لە دەرەوە؟

729
00:51:43.321 --> 00:51:45.241
تکایە، با بڕۆن.

730
00:51:45.370 --> 00:51:47.961
قسەکردن بسە. ئایا تۆ لە ناو ئەو قوتابخانەیە یان لە دەرەوەی ئەو قوتابخانەیە؟

731
00:51:48.889 --> 00:51:49.881
من لە دەرەوەم

732
00:51:50.360 --> 00:51:54.553
بڕۆ ژوورەوە، کوڕەکەت وەرگرە، کاتێک گەیشتویت بۆ ئۆتۆمبێل، تەلەفۆنم بکە.

733
00:51:54.841 --> 00:51:58.136
<i>با باشترە بە خێرایی و دوورتر لە قوتابخانە بکەویت.</i>

734
00:51:58.265 --> 00:51:59.641
بۆ کەس مەکە.

735
00:51:59.770 --> 00:52:02.425
سێ خولەکت هەیە، یان فڕید دەمرێت.

736
00:52:03.768 --> 00:52:05.145
ئێستا، فریدی...

737
00:52:06.105 --> 00:52:07.704
فریدی، هەستانەوە، با بڕۆ.

738
00:52:07.833 --> 00:52:09.913
نامەیەک بۆ خوشکەکەت بنووسە، باشه؟

739
00:52:10.041 --> 00:52:12.281
<i>زانستانی دەروون و پسپۆڕانی تر دەڵێن</i>

740
00:52:12.408 --> 00:52:15.673
<i> کە رووداوەکانی توڕەیی لەڕێگەی هاتوچۆدا زیاتر و زیاتر دەکوژرێن.</i>

741
00:52:15.801 --> 00:52:17.881
<i>پێویستە دەوڵەمەند و بەهێز و جوان بین</i>

742
00:52:18.009 --> 00:52:19.929
<i>و پیرۆزبایی بوونی لە کولتوورەکەماندا.</i>

743
00:52:20.056 --> 00:52:23.289
<i>ئەوانەی لەدوای خۆیان ماوەتەوە، وەکوو ڤاڵکان لە توڕەیی هەڵدێن.</i>

744
00:52:23.418 --> 00:52:25.944
تکایە، لێرە چاوەڕێی بکە!

745
00:52:27.832 --> 00:52:28.953
ئەتوانیت هێور بمێنیتەوە، تکایە؟

746
00:52:29.081 --> 00:52:30.489
بێنە ناو ئینترۆکە و بانگی بکە!

747
00:52:30.616 --> 00:52:33.273
- پێشتر ناردنیان بانگکرا.

748
00:52:33.401 --> 00:52:34.905
ئێمە ڕێکارەکانمان هەیە، باشە؟

749
00:52:35.033 --> 00:52:37.368
ئێمە لە ئێستادا کاری بە داخستنی نەرم دەکەین.

750
00:52:37.496 --> 00:52:39.001
من هۆکاری ئەوەم، باشه؟

751
00:52:39.384 --> 00:52:41.049
ببینە

752
00:52:41.721 --> 00:52:43.256
ئەوە براکەمە، باشه؟

753
00:52:44.345 --> 00:52:47.865
ئه م مه جنانه ش ئه گه ر نه بێیت بۆ كوڕه كه م ئازار ده دات

754
00:52:47.992 --> 00:52:50.105
لەماوەی دوو خولەکدا

755
00:52:50.233 --> 00:52:52.696
ببین، ئەو ئەو پەیامەی بۆ دەنووسیم.

756
00:52:54.233 --> 00:52:55.608
ببینە، ببینە.

757
00:52:56.217 --> 00:52:57.945
ببین، هەمان پیاو.

758
00:53:00.089 --> 00:53:01.625
خانم ئیرز...

759
00:53:02.489 --> 00:53:03.961
دەمەوێت بچیت بۆ کوڕەکەم.

760
00:53:05.689 --> 00:53:07.737
شەیتان، من پێویستم بە تۆیە بچیتە لای کوڕەکەم!

761
00:53:07.865 --> 00:53:09.209
ڕیشێل خۆشەویست

762
00:53:09.337 --> 00:53:13.305
تۆ ئێستا بەرپرسیاریت لە مردنی مریەم.

763
00:53:13.433 --> 00:53:14.681
باشه ؟

764
00:53:14.808 --> 00:53:16.889
با نامەکە بنووسە

765
00:53:17.017 --> 00:53:19.385
وریا، با بچین.

766
00:53:19.513 --> 00:53:21.496
بیرت لە بارزەی تۆپڕفینگر لە یاد بوو؟

767
00:53:21.624 --> 00:53:22.937
بچۆ ژوورەوە!

768
00:53:25.529 --> 00:53:26.873
پشتێنی کورسی

769
00:53:35.928 --> 00:53:37.241
تۆ منی دەترسم

770
00:53:37.369 --> 00:53:39.289
-ئەوە هەموو شتێک باشە.

771
00:53:39.417 --> 00:53:41.913
-تاوانم لێ نابێ -چی ڕوو دەدات؟

772
00:53:42.648 --> 00:53:43.608
دایك.

773
00:53:51.481 --> 00:53:53.465
دایكم بۆچی قسە لەگەڵم ناكەیت؟

774
00:53:57.337 --> 00:53:58.968
کایلت هەیە؟

775
00:53:59.577 --> 00:54:00.601
<i>بەڵێ.</i>

776
00:54:02.681 --> 00:54:03.929
با سڵاو بکات.

777
00:54:06.265 --> 00:54:08.121
کایل، سڵاو بکە.

778
00:54:08.793 --> 00:54:10.809
-ئایا باوکە؟

779
00:54:11.257 --> 00:54:12.537
تەنها سڵاو بکە

780
00:54:13.849 --> 00:54:14.809
سڵاو؟

781
00:54:15.641 --> 00:54:17.208
ئێستا براکەم بخە تەلەفۆنەوە.

782
00:54:23.801 --> 00:54:25.113
قسە بکە

783
00:54:28.921 --> 00:54:30.201
ڕاشێل؟

784
00:54:30.841 --> 00:54:32.185
-ئەی باشە؟

785
00:54:32.729 --> 00:54:34.073
(فرید)

786
00:54:35.257 --> 00:54:36.729
مری ڕۆیشتووە.

787
00:54:37.368 --> 00:54:39.032
مری مُردووە مری...

788
00:54:39.161 --> 00:54:41.561
- نه خێر، نه خێر، نه خێر.

789
00:54:41.689 --> 00:54:43.737
- ڕاست دەکەیت، من نەمدەتوانی.

790
00:54:43.865 --> 00:54:45.080
تۆی کرد

791
00:54:45.209 --> 00:54:47.257
- چی؟

792
00:54:47.737 --> 00:54:49.433
<i>لەگەڵ کێ قسە دەکەیت؟</i>

793
00:54:54.713 --> 00:54:56.985
تکایە، تەنها... تەنها بیبەخشە.

794
00:54:57.849 --> 00:54:59.480
من بخە سەر دەنگدانەوە.

795
00:55:01.817 --> 00:55:03.001
منداڵت هەیە؟

796
00:55:03.929 --> 00:55:05.241
خێزان؟

797
00:55:06.745 --> 00:55:09.657
ڕەیچڵ، براکەم لە ناو زەوزەیەکی شلەی سووکتر دانیشتووە

798
00:55:09.785 --> 00:55:11.193
و پشیلەی خۆی.

799
00:55:11.865 --> 00:55:13.561
من بخە سەر دەنگدانەوەیەکە

800
00:55:15.768 --> 00:55:17.017
باشه ، باشه

801
00:55:18.744 --> 00:55:22.265
- کایل، گوێم لێ ده که یت؟

802
00:55:22.393 --> 00:55:26.041
من ئەو پیاوەم کە ئەم بەیانییە دایکت بۆ زەنگی خۆی هەڵدابوو، تۆت لەبیرم؟

803
00:55:27.577 --> 00:55:28.409
بەڵێ، بەڵێ.

804
00:55:28.537 --> 00:55:30.136
مام فریدی،

805
00:55:30.264 --> 00:55:32.473
نامەیەک بۆ دایکت نووسیوە و دەیەوێت بە دەنگێکی بەرز بخوێنێتەوە.

806
00:55:32.601 --> 00:55:35.801
زۆر گرنگە کە هێمنی و ڕێزگرتن بێت

807
00:55:35.928 --> 00:55:38.169
و گوێ لە هەموو وشەیەک دەدات، باشه؟

808
00:55:38.681 --> 00:55:40.120
باشه ، باشه

809
00:55:44.473 --> 00:55:46.041
با بڕۆ فڕید

810
00:55:46.553 --> 00:55:47.897
بخوێنەوە

811
00:55:48.313 --> 00:55:49.977
با بخوێنەوە

812
00:56:01.753 --> 00:56:04.824
"ڕەیشل خۆشەویست،

813
00:56:05.401 --> 00:56:08.057
<i>ئێستا تۆ... res...</i>

814
00:56:09.465 --> 00:56:11.033
<i> بەرپرسیار...</i>

815
00:56:11.161 --> 00:56:13.305
- بەرپرسیار لە مردنی مریەم!

816
00:56:13.433 --> 00:56:15.417
نامەکە بخوێنەوە، فڕید!

817
00:56:15.961 --> 00:56:18.553
"ئێستا دەزانم خۆشەویستی...

818
00:56:19.832 --> 00:56:21.945
پەیوەندیەکە درۆیەک بووە.

819
00:56:24.089 --> 00:56:26.425
تۆ شایانی زۆرترینیت،

820
00:56:26.552 --> 00:56:29.913
<i> کەسێکی خۆڕەویستی کە من ھەرگیز ناسیوم.</i>

821
00:56:31.193 --> 00:56:32.216
هەموو شتێک...

822
00:56:33.945 --> 00:56:37.081
هەمیشە لە تۆوە بووە.

823
00:56:37.497 --> 00:56:39.929
زۆر شەرمەزارم لە تۆ

824
00:56:40.057 --> 00:56:42.233
تۆ هۆکاری...

825
00:56:42.361 --> 00:56:44.761
ئەمە بەسەرمدا دێت

826
00:56:44.889 --> 00:56:48.632
و بۆچی لە ژیانمدا هەرگیز خۆرهەڵات نابینم".

827
00:56:48.761 --> 00:56:49.721
کارێکی باش

828
00:56:49.848 --> 00:56:51.033
بسە! بسە!

829
00:56:51.160 --> 00:56:52.761
تۆ قسە لەگەڵ من دەکەیت یان لەگەڵ فریدی؟

830
00:56:52.889 --> 00:56:54.617
- تۆ مەبەستت خستووەتەڕوو.

831
00:56:54.744 --> 00:56:56.312
دەستەکانت نیشان بدە و پاشەکشەیەک بکە.

832
00:56:56.441 --> 00:56:59.609
وتم دەستەکانت بەرزبکەرەوە و پاشەکشەیەک بکە!

833
00:56:59.737 --> 00:57:02.393
شەش ئادەم سێ، ١٠-٣٣...

834
00:57:02.521 --> 00:57:04.409
- لە 1204 باکووری جاکسۆن.

835
00:57:04.537 --> 00:57:05.977
- خوه سه ر زانوێن!

836
00:57:06.106 --> 00:57:07.032
- نەخێر!

837
00:57:11.129 --> 00:57:13.240
شتێک بکە، یارمەتی بدە!

838
00:57:14.746 --> 00:57:15.929
یارمەتی بدە!

839
00:57:54.937 --> 00:57:56.184
دایك؟

840
00:58:01.944 --> 00:58:03.289
کایل...

841
00:58:03.897 --> 00:58:06.296
ببورە

842
00:58:11.769 --> 00:58:14.137
نەخێر، وەڵام مەدە.

843
00:58:14.266 --> 00:58:16.248
لەوانەیە پۆلیس بێت.

844
00:58:21.017 --> 00:58:22.681
سڵاو، ئەفسەر؟

845
00:58:23.033 --> 00:58:24.377
هێشتا منم

846
00:58:25.433 --> 00:58:26.552
براکەم لە کوێیە؟

847
00:58:26.682 --> 00:58:28.153
ببورە، ڕەیچڵ

848
00:58:29.530 --> 00:58:30.937
<i>فریدی ڕۆیشتووە.</i>

849
00:58:31.513 --> 00:58:32.728
<i>ئەگەر هەر دڵخۆشییەک بێت</i>

850
00:58:32.857 --> 00:58:35.225
پۆلیسێک شانی پێوەدا

851
00:58:35.833 --> 00:58:37.528
هیوادارم خوێنتان بڕوات.

852
00:58:37.657 --> 00:58:39.001
<i>با، ئەوە راستگۆ بوو.</i>

853
00:58:39.130 --> 00:58:40.793
ئەوە تەنها داوای لێبوردن نییە.

854
00:58:40.921 --> 00:58:44.153
زۆر کەس لە ژیانمدا شایەنی داوای لێبوردننننن.

855
00:58:44.281 --> 00:58:45.656
تۆ یەکێک نیت لەوان.

856
00:58:47.897 --> 00:58:50.008
با باسی کایل بکەین

857
00:58:50.137 --> 00:58:52.249
<i>و چۆن دەمرێت.</i>

858
00:58:53.721 --> 00:58:55.737
تۆ هێندەی هەناسە بۆ لای ئەو دەگریت،

859
00:58:55.864 --> 00:58:58.232
هیچ هێزێک لەم زەوییە ڕێگری ناکەم لە کوشتنی تۆ.

860
00:58:58.362 --> 00:58:59.386
گوێم لێ ده بێت؟

861
00:58:59.513 --> 00:59:01.273
وا ده بێ تۆ هه ست پێ ده كه یت.

862
00:59:01.401 --> 00:59:04.537
من زۆر بێئاگام.

863
00:59:04.985 --> 00:59:06.649
<i>ئاگا بوون</i>

864
00:59:06.776 --> 00:59:09.946
ئەوە باشە، چونکە هێشتا تەواو نەبین.

865
00:59:10.649 --> 00:59:11.833
بەڵێ، ئەمە کۆتایی هاتووە.

866
00:59:11.961 --> 00:59:14.552
ئەمە تەواو بوو، تۆی نەخۆشه!

867
00:59:19.897 --> 00:59:21.433
بگەڕێین بۆ کوێ؟

868
00:59:22.105 --> 00:59:24.824
بنکەی پۆلیس، دەبێت بچینە بنکەی پۆلیس.

869
00:59:35.770 --> 00:59:37.081
دایك؟

870
00:59:37.848 --> 00:59:39.193
- بەڵێ؟

871
00:59:39.642 --> 00:59:40.953
دەتوانم بە باوکەوە تەلەفۆن بکەم؟

872
00:59:42.137 --> 00:59:44.568
ئازیز، مۆبایلەکەم نییە، لەبیرت دێت؟

873
00:59:45.337 --> 00:59:46.809
ئەو پیاوەی بردووەتەوە.

874
00:59:47.577 --> 00:59:49.016
تۆ تابلێتەکەتت هەیە؟

875
00:59:51.640 --> 00:59:53.368
پێم وایە ئەویش دزەی کردووە.

876
00:59:53.785 --> 00:59:55.866
ئەمە لەوانەیە شتێکی باش بێت.

877
00:59:56.633 --> 01:00:00.153
ئەو مۆبایلەکەت هەیە، ئەگەر تۆ تابلێتتمان هەبووایە،

878
01:00:00.280 --> 01:00:02.008
ئه توانێ بزانێت ئێمه له کوێین

879
01:00:02.617 --> 01:00:03.864
- چی؟

880
01:00:04.666 --> 01:00:06.648
ئەو دەیزانی لە کوێین، بەڵام...

881
01:00:06.777 --> 01:00:08.824
ئەو مۆبایلە فلیپەکە بەکاردەهێنا.

882
01:00:09.337 --> 01:00:10.777
پێت وانییە؟

883
01:00:11.353 --> 01:00:13.593
بەڵێ، لەوانەیە.

884
01:00:14.744 --> 01:00:15.865
هی، هی...

885
01:00:17.017 --> 01:00:20.826
پێشتر گەڕام بۆ تابلێتەکەم، بەڵام... ئەتەوێت دیسان سەیری بکەیت؟

886
01:00:20.953 --> 01:00:22.457
- بۆ هەر حاڵێک؟

887
01:00:24.088 --> 01:00:25.593
- گیرفانی کورسییەکان پشکنین بکە.

888
01:00:26.329 --> 01:00:28.249
زۆر بە باشی سەیری بکە، باشه؟

889
01:00:31.546 --> 01:00:32.889
سەیری ژێر کورسییەکان بکە.

890
01:00:35.129 --> 01:00:37.432
- دیت؟ - پێم وانییە لێرە بێت.

891
01:00:40.600 --> 01:00:43.128
چاوەڕێ بکە، پێم وایە هەست بە شتێک دەکەم.

892
01:00:44.953 --> 01:00:46.520
- پێم وایە دەیبینم.

893
01:00:46.649 --> 01:00:48.730
- لەژێر کورسیتدا، ئەوە...

894
01:00:48.857 --> 01:00:49.881
گیرۆدە.

895
01:00:50.008 --> 01:00:51.257
چی؟

896
01:00:51.993 --> 01:00:53.401
تۆمارکرا

897
01:00:54.137 --> 01:00:55.546
ئەی خودایە

898
01:00:55.672 --> 01:00:57.688
-پێویستە لە پەنجەرەکەوە بیبەخشم؟

899
01:00:57.977 --> 01:00:59.290
- نەخێر - چی؟

900
01:00:59.417 --> 01:01:00.408
چاوەڕێ بکە، چاوەڕێ بکە، چاوەڕێ بکە.

901
01:01:00.537 --> 01:01:02.488
- بەرنامەی "دۆزەرەوە مۆبایلەکەت"

902
01:01:02.617 --> 01:01:03.993
تۆیش لەسەر تابلێتەکەی دانایت؟

903
01:01:04.122 --> 01:01:05.337
بەڵێ،

904
01:01:05.464 --> 01:01:07.833
ئەگەر هێشتا مۆبایلەکەم لە دەستیدا بێت

905
01:01:08.440 --> 01:01:10.393
دەبێت بتوانین شوێن پێی بکەوین، وانییە؟

906
01:01:10.520 --> 01:01:11.673
راستە

907
01:01:12.153 --> 01:01:14.456
- کاردەکات؟

908
01:01:15.289 --> 01:01:17.305
ده بینم

909
01:01:17.433 --> 01:01:18.904
لە کوێیە؟

910
01:01:19.450 --> 01:01:20.728
لە لای ئێمە.

911
01:01:22.040 --> 01:01:23.448
ئەی خودایە

912
01:01:25.146 --> 01:01:26.617
دەیبینیت؟

913
01:01:34.104 --> 01:01:35.353
ئەی خودایە

914
01:01:37.144 --> 01:01:39.064
لەبەردەمماندایە.

915
01:01:39.577 --> 01:01:41.752
- ئۆتۆمبێلی (ڕۆزی) ی هەیە.

916
01:01:42.904 --> 01:01:45.370
دایكم بڕوانە، پۆلیسێك هەیە.

917
01:01:46.201 --> 01:01:48.472
- دیتیت؟ - باشە، هەموو شتێک باشە.

918
01:01:48.601 --> 01:01:50.328
دەتوانێت یارمەتیمان بدات.

919
01:01:50.457 --> 01:01:52.377
پشتێنی خۆت بخۆەوە.

920
01:01:55.544 --> 01:01:59.001
- سەیری مەکە، باشه؟

921
01:02:21.946 --> 01:02:23.992
دایكم، ئەوە... ئەوە...

922
01:02:24.121 --> 01:02:25.465
دەرچوونەکە، دەزانم، دەزانم.

923
01:02:25.593 --> 01:02:29.080
کایل، بڕوام پێ بکە و سەرنجی بکێشە.

924
01:02:29.530 --> 01:02:30.872
ئەفسەر!

925
01:02:31.000 --> 01:02:32.441
هی!

926
01:02:32.568 --> 01:02:33.944
ئەفسەر، یارمەتی!

927
01:02:34.074 --> 01:02:36.985
ئەفسەر، هی!

928
01:02:39.161 --> 01:02:40.697
پەنجەرەکەت دابەزی!

929
01:02:41.017 --> 01:02:43.480
تکایە یارمەتیمان بدە!

930
01:02:43.609 --> 01:02:45.946
ئەو پیاوەى کە بەدوایدا دەگەڕێن، لە پشتتانەوەیە!

931
01:02:46.072 --> 01:02:47.384
لە پشتتان!

932
01:02:49.465 --> 01:02:50.457
تکایە یارمەتیمان بدە!

933
01:02:50.586 --> 01:02:51.450
وەستێنە!

934
01:02:57.241 --> 01:03:00.537
ناردن، داوای هاوکاری...

935
01:03:08.697 --> 01:03:10.521
ئەی خودایە

936
01:03:16.281 --> 01:03:17.370
ده توانیت ببینیت؟

937
01:03:17.497 --> 01:03:19.161
ئەو... ئەو دەستکەوت دەکات.

938
01:03:21.306 --> 01:03:22.904
بڕۆ، بڕۆ!

939
01:03:23.034 --> 01:03:25.528
کایل، تەلەفۆن بکە بۆ 911 لەسەر تابلێتەکە.

940
01:03:27.673 --> 01:03:29.304
911، فریاکەوتنەکەت چییە؟

941
01:03:29.432 --> 01:03:32.344
ئەو پیاوەی لە هەواڵەکان، لە مینیڤانێکی زیوودا بە دوای من دێت.

942
01:03:32.473 --> 01:03:34.328
- شوێنی ئێستای تۆ؟ - شۆفێری لە 95 لە باشوور.

943
01:03:34.457 --> 01:03:35.833
لە دوای دەرچوونی دەوڵەت.

944
01:03:35.961 --> 01:03:37.626
خاتوو، هەموو یەکینەکان لەو ناوچەیەدا

945
01:03:37.753 --> 01:03:39.706
<i>لە ئێستادا کاردەکەن بۆ ڕووداوی پێکدادانی ئۆتۆمبێلێکی زۆر.</i>

946
01:03:39.832 --> 01:03:43.064
ئەو ڕووداوەکەی بۆ خۆی دروستکردووە!

947
01:03:43.194 --> 01:03:44.697
خانمە، ئێستا ناتوانین پەیوەندیمان لەگەڵ بکەیت

948
01:03:44.824 --> 01:03:47.130
لە هێڵەکەدا بمێننەوە، بچینە شوێنێکی ئارام...

949
01:03:47.768 --> 01:03:49.050
دایكم، مردووە!

950
01:03:49.177 --> 01:03:50.905
- شـێـت، شـێـت، شـێـت.

951
01:03:51.737 --> 01:03:53.689
پێم بڵێ تۆ بارگرەکەیت.

952
01:03:54.681 --> 01:03:55.609
من ناڵێم

953
01:03:55.737 --> 01:03:56.857
ئەی خودایە

954
01:03:56.986 --> 01:03:58.328
ئێمە بە تەنیا.

955
01:03:58.777 --> 01:03:59.961
باشه باشه باشه

956
01:04:00.088 --> 01:04:01.848
دەبێت بچینە ناوەندە.

957
01:04:01.976 --> 01:04:05.048
هیچ رێگەیەک نییە بتوانین لێی دووربكەینەوە، دەبێت لەدەست بدەین.

958
01:04:05.177 --> 01:04:06.968
- دەبێت بچینە لای بابی.

959
01:04:07.097 --> 01:04:08.473
ئەوە ستراتیژیت، لەبیرت؟

960
01:04:08.601 --> 01:04:09.817
- لە یاری ڤیدیۆیی؟

961
01:04:09.944 --> 01:04:11.864
لە شوێنێک کە ئێمە ئاشناین، باشه؟

962
01:04:11.994 --> 01:04:14.266
ئەم شوێنە سەلامەترینە بۆ شاردنتەوە.

963
01:04:15.001 --> 01:04:17.368
و دەتوانین داوای یارمەتی بکەین لە کاتی ئاگاهکردنی بێدەنگ.

964
01:04:17.497 --> 01:04:20.121
و ئەوە شەریکی ئەو کەسەیە کە پێشتر لەوێ نەبووە.

965
01:04:20.248 --> 01:04:22.489
راستە، وەک مام فریدی دەیگوت

966
01:04:22.617 --> 01:04:25.304
هێشتا لەوێدا ون دەبێت، وەک لەشاری سپاجێتی.

967
01:04:25.434 --> 01:04:26.585
بەڵێ، هەروا.

968
01:04:26.713 --> 01:04:27.768
تۆ پێتوایە هەڵدێت؟

969
01:04:27.896 --> 01:04:29.337
بۆ ماوەیەکی زۆر.

970
01:04:43.770 --> 01:04:44.697
شۆفێر!

971
01:04:44.825 --> 01:04:46.521
خێراتر بڕۆ!

972
01:05:44.377 --> 01:05:45.848
لە پشتمانەوەیە.

973
01:05:46.744 --> 01:05:48.153
دەست پێدەکات.

974
01:05:57.976 --> 01:05:59.288
ئەتوانیت خێراتر بڕۆیت؟

975
01:06:34.105 --> 01:06:35.353
- چاوەڕێ بکە!

976
01:06:43.769 --> 01:06:44.697
- چیا!

977
01:06:56.953 --> 01:06:59.576
-ئەی باشە؟

978
01:07:13.657 --> 01:07:15.353
- ئەتوانیت ببینیت؟

979
01:07:15.481 --> 01:07:17.656
پێم وایە هێشتا بەرەو دەروازەیە.

980
01:08:11.898 --> 01:08:12.921
کایل

981
01:08:14.265 --> 01:08:16.089
لەئێستاوە، ئێمە پابەندین بە پلانەکەمان.

982
01:08:16.216 --> 01:08:17.433
پلانی پشتیوانمان

983
01:08:17.561 --> 01:08:20.377
بەڵێ، ئەگەر ئەوە بکەین، بەڵێنی دەدەم...

984
01:08:21.016 --> 01:08:24.153
ئێمە پێکەوە ئەمەمان بەسەردا دەبەین، باشە، ئێمە و تۆ.

985
01:08:24.441 --> 01:08:25.561
- بەڵێ.

986
01:08:29.465 --> 01:08:31.065
بڕۆ، بڕۆ

987
01:11:23.577 --> 01:11:26.041
سەیری من بکە

988
01:11:26.169 --> 01:11:28.248
سەیری من بکە، منی دەبینیت؟

989
01:11:28.729 --> 01:11:30.329
هەمیشە دەبینی من

990
01:11:30.457 --> 01:11:33.144
من هەمیشە لە ناو مێشکتدا دەبم.

991
01:11:33.433 --> 01:11:35.609
هەرکاتێک بیر لە کوڕە بچووکەکەت دەکەیتەوە...

992
01:11:35.737 --> 01:11:39.768
و ئەوەی کە ئەتوانی بیکرد بۆ ڕزگارکردنی.

993
01:12:17.049 --> 01:12:18.489
کایل؟

994
01:12:19.736 --> 01:12:21.144
کایل فلین؟

995
01:12:22.841 --> 01:12:24.601
پۆلیسن

996
01:12:25.337 --> 01:12:27.097
تۆ بە سەلامیتەوە، کوڕم، با بچۆ دەرەوە.

997
01:12:30.329 --> 01:12:31.673
با بچێ، کوڕم.

998
01:12:41.304 --> 01:12:44.569
دایکت بریندارە، بەڵام باشە.

999
01:12:46.809 --> 01:12:48.569
داوای کردین بیین بۆ تۆ.

1000
01:13:08.313 --> 01:13:09.721
با بچێ، کوڕم.

1001
01:13:10.681 --> 01:13:11.993
-ئەوە باشە.

1002
01:13:16.441 --> 01:13:17.849
هاتە دەرەوە، کوڕم.

1003
01:13:47.865 --> 01:13:50.009
زۆر دەنگم دروستکرد - باشە -

1004
01:13:51.288 --> 01:13:53.689
نەخێر، نەخێر، نەخێر

1005
01:14:10.777 --> 01:14:12.985
نەخێر، نەخێر!

1006
01:14:13.497 --> 01:14:16.313
لێم دوور بکەوە!

1007
01:14:22.649 --> 01:14:24.632
دایكم!

1008
01:14:24.762 --> 01:14:26.873
- نەخێر!

1009
01:14:28.280 --> 01:14:29.305
دایكم!

1010
01:14:49.369 --> 01:14:51.289
نەخێر، نەخێر، دایكم!

1011
01:15:08.088 --> 01:15:09.400
هی!

1012
01:15:21.080 --> 01:15:23.737
ئەمە کاری ڕێزییە لعنەکەی تۆیە!

1013
01:15:32.184 --> 01:15:33.656
تۆ باشە، تۆ باشە.

1014
01:15:35.672 --> 01:15:36.921
دایك.

1015
01:15:51.513 --> 01:15:55.866
ئێمە دەزانین کە لەوانەیە لە ئەنجامی ڕووداوێکی دوو ئۆتۆمبێلەوە دەستی پێکردبێت...

1016
01:16:17.753 --> 01:16:18.873
خانم فلین؟

1017
01:16:19.736 --> 01:16:21.529
ئایا دەتوانم ساتێک بمێنمەوە؟

1018
01:16:22.553 --> 01:16:24.569
هەرچی باشە، هەر لەپاشدا دەگەڕینەوە.

1019
01:16:25.209 --> 01:16:26.264
باشه ؟

1020
01:16:28.120 --> 01:16:32.216
زۆر ببورە

1021
01:16:45.337 --> 01:16:46.968
مام فرێد زیندووە.

1022
01:16:48.248 --> 01:16:49.337
- ئەو؟

1023
01:16:49.977 --> 01:16:51.385
-ئەوە باشە؟

1024
01:16:51.513 --> 01:16:52.409
ده توانین بچین بۆ لای؟

1025
01:16:52.537 --> 01:16:54.617
بەڵێ، بەڵێ.

1026
01:16:54.744 --> 01:16:57.528
ئێمە قسەکەتمان وەرگرتووە، بۆیە ئازادیت بڕۆ.

1027
01:17:41.144 --> 01:17:42.426
کێشەکەت چییە؟

1028
01:17:51.897 --> 01:17:53.497
هەڵبژاردنی باش
