{
  "headers": [
    {
      "source": "/subtitles/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/subtitles",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/subtitles",
      "destination": "/api/subtitles"
    },
    {
      "source": "/subtitles/(.*)",
      "destination": "/api/subtitles?file=$1"
    },
    {
      "source": "/vidlink/(.*)",
      "destination": "/api/vidlink"
    },
    {
      "source": "/((?!api/tmdb|api/football|api/subtitles|subtitles/|assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*vidlink.*"
        }
      ],
      "destination": "/api/vidlink"
    },
    {
      "source": "/(vidcore|movie|tv|embed|_next|stream-proxy)/(.*)",
      "destination": "/api/vidcore"
    },
    {
      "source": "/(APA91ywF.*|wyzie.*|servers.*)",
      "destination": "/api/vidcore"
    },
    {
      "source": "/(gtag-shield\\.js|script\\.js|fu\\.wasm|decrypter-worker\\.js|hls\\.worker\\.js)",
      "destination": "/api/vidcore"
    },
    {
      "source": "/api/b/(.*)",
      "destination": "/api/vidcore"
    },
    {
      "source": "/api/skip-events",
      "destination": "/api/vidcore"
    },
    {
      "source": "/((?!api/tmdb|api/football|api/subtitles|subtitles/|assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*vidcore.*"
        }
      ],
      "destination": "/api/vidcore"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
