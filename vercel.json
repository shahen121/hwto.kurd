{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/subtitles/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    },
    {
      "source": "/api/subtitles",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/subtitles",
      "destination": "/api/subtitles"
    },
    {
      "source": "/subtitles/(.*)",
      "destination": "/api/subtitles?file=$1"
    },
    {
      "source": "/vidlink/:path*",
      "destination": "/api/vidlink?__orig_path=/vidlink/:path*"
    },
    {
      "source": "/vidlink/(.*)",
      "destination": "/api/vidlink?__orig_path=/vidlink/$1"
    },
    {
      "source": "/vidcore/:path*",
      "destination": "/api/vidcore?__orig_path=/vidcore/:path*"
    },
    {
      "source": "/vidcore/(.*)",
      "destination": "/api/vidcore?__orig_path=/vidcore/$1"
    },
    {
      "source": "/APA91/:path*",
      "destination": "/api/vidcore?__orig_path=/APA91/:path*"
    },
    {
      "source": "/APA91(.*)",
      "destination": "/api/vidcore?__orig_path=/APA91$1"
    },
    {
      "source": "/servers(.*)",
      "destination": "/api/vidcore?__orig_path=/servers$1"
    },
    {
      "source": "/wyzie(.*)",
      "destination": "/api/vidcore?__orig_path=/wyzie$1"
    },
    {
      "source": "/stream-proxy/(.*)",
      "destination": "/api/vidcore?__orig_path=/stream-proxy/$1"
    },
    {
      "source": "/gtag-shield.js",
      "destination": "/api/vidcore?__orig_path=/gtag-shield.js"
    },
    {
      "source": "/hwto-subtitles.js",
      "destination": "/api/vidcore?__orig_path=/hwto-subtitles.js"
    },
    {
      "source": "/api/b/(.*)",
      "destination": "/api/vidcore?__orig_path=/api/b/$1"
    },
    {
      "source": "/api/skip-events",
      "destination": "/api/vidcore?__orig_path=/api/skip-events"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
