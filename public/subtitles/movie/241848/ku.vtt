<font color="#808080">(بەھاتنی قورس)</font>

945
00:58:31.842 --> 00:58:33.116
<font color="#808080">(EXHALES)</font>

946
00:58:34.711 --> 00:58:35.712
<font color="#808080">(SIGHS)</font>

947
00:58:35.879 --> 00:58:37.790
<font color="#808080">(بەدەرەکە دەنکێنن)</font>

948
00:58:38.015 --> 00:58:39.016
<font color="#808080">(SNIFFLES)</font>

949
