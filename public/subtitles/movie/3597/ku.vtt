*واواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواوا

44
00:06:35.525 --> 00:06:38.194
* منداڵەکەم چەند شێوازێکی سەیر هەیە بۆ گوتن *

45
00:06:38.262 --> 00:06:41.030
*واواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواوا

46
00:06:41.098 --> 00:06:44.000
♪ پڵێپێکی درێژ و تەنک ♪

47
00:06:44.068 --> 00:06:46.535
* بە لایەکی خراپەوە خزمەت بکە *

48
00:06:46.603 --> 00:06:49.105
* منداڵەکەم چەند شێوازێکی سەیر هەیە بۆ گوتن *

49
00:06:49.173 --> 00:06:51.740
*واواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواواوا

50
00:06:51.808 --> 00:06:54.410
قژم چۆنە؟

51
00:06:54.478 --> 00:06:57.447
هی، هەموو شتێک لەسەر قژە، ئەوە لەبیر مەکەرەوە.

52
00:06:57.514 --> 00:07:00.083
بەتایبەتی کاتێک دەبیتە پارێزەرێکی گەورە و پڕ لە سەرسوڕمان.

53
00:07:00.150 --> 00:07:02.852
ئەو ژنە پیشەسازییانە پێیان وایە هەموو شتێک دەربارەی مێشک و توانایە...

54
00:07:02.919 --> 00:07:05.121
و بەتەواوی پشتگوێ بخەن لە "بکە".

55
00:07:05.189 --> 00:07:07.656
کەواتە "کارد" گرنگە.

56
00:07:10.461 --> 00:07:14.063
هەی، تۆ لەگەڵم دەبیت؟

57
00:07:14.131 --> 00:07:17.867
ئەمشەو خانمە کراکەرەکە دەشێوێت؟

58
00:07:17.934 --> 00:07:21.804
هۆ، گێلێکی پڕ لە عەقڵ، خۆرم بخۆ.

59
00:07:25.142 --> 00:07:27.110
جولی، تەقەکەرێکی بۆ هێناوم بۆ ماڵەکەت.

60
00:07:27.177 --> 00:07:30.246
زۆر سوپاس، ماکس، بەڵام دەزانی چی، من ئەم کۆشکە دەروونیەم هەیە.

61
00:07:30.314 --> 00:07:33.816
ناتوانم لە زەمینەکە تێپەڕم، ئەی چۆن پێش ئەوەی شار بەجێبهێڵیت، دەرتێنم؟

62
00:07:33.884 --> 00:07:36.252
دەزانیت، جۆرێک لە گەشتێکی خۆش.

63
00:07:36.320 --> 00:07:38.821
-ئەی، ئەی...

64
00:07:40.690 --> 00:07:43.959
دەزانی چی... من، پێم وانییە، ماکس.

65
00:07:44.028 --> 00:07:45.995
ئێمە لە هەموو سەردەمێکەوە دۆستانین.

66
00:07:46.063 --> 00:07:49.665
ئێستا ناتوانیت بێ ماڵئاوایی بڕۆیت، باشه؟

67
00:07:49.733 --> 00:07:53.536
ناله ی بۆ ئێمه

68
00:07:53.603 --> 00:07:55.905
بۆ هاوینی رابردوومان لە...

69
00:07:55.972 --> 00:07:59.742
ناڕەحەت و تێکچوونی مێرمنداڵ.

70
00:07:59.809 --> 00:08:01.911
کەسێک زومەر دەکات

71
00:08:04.048 --> 00:08:08.251
هاورێ، با بچیت بە سەفەر!

72
00:08:08.318 --> 00:08:11.054
هێواش!

73
00:08:11.121 --> 00:08:14.623
هی، با بڕۆ، هاوڕێ، ئەوان تەنها هاوڕێیەن.

74
00:08:14.691 --> 00:08:16.659
ئه م کاره ماندوویه

75
00:08:18.795 --> 00:08:20.729
ئەی ڕەی، تەنها چاودێری کچەکەت دەکەم وەک بەڵێنم داوە.

76
00:08:20.797 --> 00:08:24.967
سوپاس هاورێ با هەڵبکەین

77
00:08:25.035 --> 00:08:30.005
با بۆ کەناری دۆسۆن بگێڕین، گەشتێکی ئازیز.

78
00:08:34.311 --> 00:08:36.512
ماڵئاوایی

79
00:08:49.859 --> 00:08:52.695
کوڕ و کچەکە خەریکی پێکەنینن، باشە؟

80
00:08:52.762 --> 00:08:57.333
کاتێک لە ڕادیۆدا گوێیان لێدەگرێت کە ئەم بکوژە شێتە لە نەخۆشخانەی شێتەکان هەڵهاتووە.

81
00:08:57.401 --> 00:09:00.369
ئەو قاقەی درێژ و تیژەیە بۆ دەستەکەی، وانییە؟

82
00:09:00.437 --> 00:09:02.972
هاوڕێ، تۆ هەڵە دەڵێی.

83
00:09:03.039 --> 00:09:07.610
بێدەنگ بیت، ئەو کچە زۆر دەترسێت، وانییە؟

84
00:09:07.677 --> 00:09:10.646
دەیەوێت بچێتە ماڵەوە و کوڕەکە، زۆر گەرم و بێزارە،

85
00:09:10.714 --> 00:09:13.216
- نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا، نا

86
00:09:13.283 --> 00:09:15.884
ئەمە بەو شێوەیە نییە، کوڕەکە داوای یارمەتی دەکات،

87
00:09:15.952 --> 00:09:19.722
کچەکە لە ئۆتۆمبێلدا دەمێنێتەوە و ئەو دەنگەش دەناسێت کە وەک،

88
00:09:19.789 --> 00:09:24.260
ئەوە دەنگی خراسان نییە، بەڵکو دڵۆپێکە.

89
00:09:24.328 --> 00:09:26.795
نەخێر، ئەو دەمە شڕدە، چونکە ئەو پیاوە هەڵواسراوە...

90
00:09:26.863 --> 00:09:29.865
لە دارێکەوە و پێی لەسەر ئۆتۆمبێلەکە هەڵدەچڕێت.

91
00:09:29.933 --> 00:09:32.668
سەری بڕدراوە و خوێنی لێبڕراوی ملی...

92
00:09:32.736 --> 00:09:36.139
کە لە ئۆتۆمبێلەکە دەڕژێت و دەڕژێت، دەڕژێت، دەڕژێت، دەڕژێت.

93
00:09:36.206 --> 00:09:41.043
نەخێر، سەری نەبڕراوە بەڵکو بە قەڵەمێک لێبڕراوە.

94
00:09:43.247 --> 00:09:45.681
من وا گوێم لێبوو.

95
00:09:45.749 --> 00:09:48.217
ببین، ئێوە هەموو هەڵەن.

96
00:09:48.285 --> 00:09:50.553
گه ڕایه وه بۆ ماڵی کچەکە و ده یبینن...

97
00:09:50.621 --> 00:09:54.690
ئەو شێتە لە دەرگای ئۆتۆمبێلدا لە قەڵەمدا بووە

98
00:09:54.758 --> 00:09:58.494
ئەمە چیرۆکی ئەسڵییە، ئەمە چۆن بوو.

99
00:09:58.562 --> 00:10:01.464
هی، هی، هیچ شتێک بە ڕاستی ڕوویدا.

100
00:10:01.532 --> 00:10:05.067
- ئەمە چیرۆکی شوحە و گەمژانە بۆ دەستپێک.

101
00:10:05.135 --> 00:10:07.236
- بەڵێ، پێم وانییە، ڕەی.

102
00:10:07.304 --> 00:10:09.872
سوێندم خواردووە، تکایە.

103
00:10:09.939 --> 00:10:12.007
چیرۆکێکی خەیاڵییە بۆ ئاگادارکردنەوەی کچانی گەنج...

104
00:10:12.075 --> 00:10:14.577
مەترسی سێکسی پێش هاوسەرگیری

105
00:10:14.645 --> 00:10:16.912
لە ڕاستیدا، خۆشەویست...

106
00:10:16.980 --> 00:10:19.382
تۆ دەزانی چەند لە ئیتلاعاتی زیرەکت دەترسێم، بەڵام...

107
00:10:19.449 --> 00:10:22.985
<i>ئەمە ئەفسانەیەکی شارەوانییە، فۆلکلۆری ئەمریکییە.</i>

108
00:10:23.053 --> 00:10:28.057
هەموویان بە شێوەیەکی گشتی لە ڕووداوێکی ڕاستەقینەی ژیانەوە سەرچاوەی گرتووە.

109
00:10:42.206 --> 00:10:45.040
بۆیە لەو کاتەدا

110
00:10:45.108 --> 00:10:49.378
<i>من تەنها کۆتایی بە گرێبەستەکەم بە دوو ساڵە لە بواری ڕووناکی ڕێنمایی دەبەم،</i>

111
00:10:49.446 --> 00:10:53.516
کە هاوکاتە لەگەڵ یەکەم ساڵی تۆ وەک وەرزشکاری دەستپێک بۆ Steelers.

112
00:10:53.584 --> 00:10:55.951
كاوبایەكان، هەركەسێك

113
00:10:56.019 --> 00:11:00.956
پاشان، دەتوانین بەرەو ئەوروپا هەڵبچین، یان قەیمانەکان،

114
00:11:01.024 --> 00:11:04.694
لە هەر شوێنێک کە بتەوێ منی هەڵبگرێ...

115
00:11:04.761 --> 00:11:07.029
له گه ڵ یه كه مین له سێ منداڵدا...

116
00:11:07.097 --> 00:11:09.599
پێش ئەوەی بڕۆیت بۆ ئاکامخوازکردن.

117
00:11:09.666 --> 00:11:12.935
ئینجا دەتوانین بە خۆشی بژین

118
00:11:13.002 --> 00:11:15.904
بلە بلە بلە

119
00:11:15.972 --> 00:11:19.942
ڕەی؟

120
00:11:20.009 --> 00:11:22.911
بۆ کوێ چوویت؟

121
00:11:22.979 --> 00:11:27.283
من دەتەمێ!

122
00:11:27.351 --> 00:11:31.053
ئەی ڕەی، تۆ باوەڕت بەو قەڵەمەیە نییە، وانییە؟

123
00:11:31.121 --> 00:11:33.188
تکایە، ئەو قوقەیە بەڕاستی سیمبولێکی فالیکەیە.

124
00:11:33.257 --> 00:11:36.425
بەڵێ، لە کۆتاییدا پەردەپۆشرا.

125
00:11:36.493 --> 00:11:39.462
خوا گیان، من لە تۆدا دوژمنی دەکەم.

126
00:11:39.529 --> 00:11:42.498
پێویست ناکات، هەمیشە دەتوانیت ئەو شتەی بۆستۆنی واز لە خۆت بهێنیت،

127
00:11:42.566 --> 00:11:45.735
و، لەگەڵم بێنە نیویۆرک.

128
00:11:45.802 --> 00:11:49.605
بەڵێ، ئێمە ناتوانین هەمووی لە قەزایەکی گوندەکە دابنیشین و بە شێوەیەکی ئاسۆری لە کۆمپیوتەرەکانماندا هەڵگەڕین.

129
00:11:49.673 --> 00:11:51.674
جێگای پێویست نییە.

130
00:11:51.742 --> 00:11:54.610
هیچ کەس وەک تۆ تێدەگات، من ئازارەکەت تێدەگەم.

131
00:11:54.678 --> 00:11:59.815
هەر وا، ڕقم لە ئەمە هەیە.

132
00:11:59.883 --> 00:12:02.217
تۆ دەتەقێنی و دەکەویتە سەری چاڵێک

133
00:12:02.286 --> 00:12:06.355
بە ڕەشەوە، تاتۆ کراو، بە جەستەی دەرچووی فەلسەفە.

134
00:12:06.423 --> 00:12:09.258
ئەوە سەرنجڕاکێشە.

135
00:12:09.326 --> 00:12:12.861
ئیتر هەرگیز نابینیتەوە

136
00:12:12.929 --> 00:12:16.799
ئایا دەزانی ڕێژەی سەرکەوتنی پەیوەندی خۆشەویستەکانی ئامادەیی...

137
00:12:16.866 --> 00:12:19.902
لە هەموو جۆرە پەیوەندیەکانی تر بەرزترە؟

138
00:12:19.969 --> 00:12:22.938
- سەرچاوەکەت بنێرە.

139
00:12:35.619 --> 00:12:38.253
دڵنیایت؟

140
00:12:39.255 --> 00:12:42.257
* پاشا و شاژانە

141
00:12:44.060 --> 00:12:49.064
♪ لە قەڵایەکی لاپەڕە ♪

142
00:12:50.900 --> 00:12:54.203
♪ سەیری تەلەفزیۆن بکە

143
00:12:56.239 --> 00:13:00.976
* له گۆڤاره كاندا ده بینن *

144
00:13:02.312 --> 00:13:04.814
باشه ، به ڵام کلیله کان بده وه تۆ تۆستیت

145
00:13:04.881 --> 00:13:07.483
ئەمە ئۆتۆمبێلی کێیە؟

146
00:13:07.551 --> 00:13:11.119
ئەزانم، ئازیز، بەڵام شاژنی کڕاکەر دەبێ ئێستا بگەڕێتەوە ماڵەوە.

147
00:13:11.187 --> 00:13:15.123
سوپاس، هی ئێوە دووتان

148
00:13:15.191 --> 00:13:17.460
کلیلەکانم بده ، تۆ پووچیت

149
00:13:17.527 --> 00:13:21.263
باشه ، به ڵێ، با له گه ڵم بگه ڕێیته ناو پشتی، ده ترسم هه موو شتێکت بۆ بكه یت

150
00:13:21.331 --> 00:13:23.799
کەس سەیارەکەم لێ ناکات جگە لە من.

151
00:13:23.867 --> 00:13:26.101
- ده زانیت، ئه و قاره ی که له سه ر ده ستدا ده ستدا؟

152
00:13:26.169 --> 00:13:28.604
بچە ناو ئۆتۆمبێل

153
00:13:36.513 --> 00:13:40.182
وەرە، عیسای گەورە!

154
00:13:40.250 --> 00:13:43.118
تۆ ناتوانیت بۆ هیچ شتێک شۆفێری بکەیت، دەزانیت؟

155
00:13:43.186 --> 00:13:47.623
- ئەتوانیت بڵێیت "الکوحولیک" ؟

156
00:13:47.691 --> 00:13:51.159
* هۆکارەکان چۆنن

157
00:13:51.227 --> 00:13:54.563
♪ لە ڕێگەی ئاوازەوە پاڵپشتی دەکرا ♪

158
00:13:54.631 --> 00:13:56.665
باشە، ئەم قەرەجەیە چیە؟

159
00:14:01.237 --> 00:14:05.207
بەڵێ!

160
00:14:09.880 --> 00:14:12.681
بارری.

161
00:14:14.551 --> 00:14:16.652
- تۆی ئەڕوو!

162
00:14:16.720 --> 00:14:19.087
چی بەسەرت هات؟

163
00:14:19.155 --> 00:14:21.123
ئاگاداری!

164
00:14:27.997 --> 00:14:30.666
<i>- ئەوە چی بوو؟ - نازانم.</i>

165
00:14:30.734 --> 00:14:33.101
هەمووان باشە؟

166
00:14:33.169 --> 00:14:35.337
پێم وایە ئاژەڵ بوو.

167
00:14:35.405 --> 00:14:38.373
ئەی خودایە، تۆ خوێنبەریت!

168
00:14:38.442 --> 00:14:43.011
من نیم، دەبێت سەگ بێت یان شتێکی وا.

169
00:14:43.079 --> 00:14:45.714
ئەی خودای مەسیح، سەیارەم!

170
00:14:50.253 --> 00:14:53.556
تۆ نەدیت بۆ کوێ دەڕۆی؟

171
00:14:53.623 --> 00:14:55.958
سەیرکەر، لەهیچ شوێنێک هات، نەمبینی!

172
00:14:56.025 --> 00:14:58.461
سەگ ناتوانێت ئەوە بکات، بەڵێ، بەڵام دێوانە دەتوانێت.

173
00:14:58.528 --> 00:15:01.363
ببینه ، تۆ بوتڵەکەت دابڕی، من هەوڵ دەدەم...

174
00:15:01.431 --> 00:15:03.833
بارری، ڕووداو بوو، هێڵێ بەلام.

175
00:15:03.900 --> 00:15:07.169
لە کوێیە؟ ئەگەر گیلێک بوو، لە کوێیە؟

176
00:15:07.236 --> 00:15:09.237
ببینه ، رەنگە هەڵاتبێت

177
00:15:09.305 --> 00:15:13.041
هیوادارم وا بێت، هیوادارم نەمکوژین، با بچین.

178
00:15:13.109 --> 00:15:15.210
ئەی خودایە!

179
00:15:19.749 --> 00:15:23.719
- هیچ شێوەیەک.

180
00:15:23.787 --> 00:15:26.021
ئەی خودایە، بەڵام بیرم کرد...

181
00:15:26.089 --> 00:15:29.492
- نەمبینیوە - نەخێر، هیچ رێگەیەک نییە!

182
00:15:29.559 --> 00:15:32.628
ئەی خودایە، ئەمە ڕوو نادات!

183
00:15:36.833 --> 00:15:38.734
ئەو لایەنە بڕوانە.

184
00:15:38.802 --> 00:15:41.770
با بڕۆ، هێلەن.

185
00:15:47.043 --> 00:15:50.078
- نەخێر!

186
00:15:50.146 --> 00:15:53.382
من نەمبینی، سوێندم خواردووە!

187
00:15:54.951 --> 00:15:57.586
ئایا مردووە؟

188
00:15:57.654 --> 00:15:59.588
- پشکنینی دڵه که ی بکه .

189
00:15:59.656 --> 00:16:02.658
تۆی ئەوی کە پێی لێدەکەیت!

190
00:16:22.412 --> 00:16:25.714
پێم وایە مردووە.

191
00:16:25.782 --> 00:16:28.450
- شێت!

192
00:16:28.518 --> 00:16:30.719
کێیە؟

193
00:16:30.787 --> 00:16:35.290
نازانم، دەموچاوەکەی تێکچووە.

194
00:16:35.358 --> 00:16:37.826
ئەو چی لە دەرەوە دەکرد؟

195
00:16:37.894 --> 00:16:40.663
دەبێت پۆلیس بانگ بکەین و فریاکەوتنێک بۆ ھێر بکەین.

196
00:16:40.730 --> 00:16:43.065
هی، هی، بۆچی خێرا؟

197
00:16:43.132 --> 00:16:45.067
ئەو پیاوە مردووە.

198
00:16:45.134 --> 00:16:48.437
تۆ دکتۆر نیت، ئەو بڕیارە خۆت نادەیت.

199
00:16:48.504 --> 00:16:52.708
مێشکی خۆت بەکاربهێنە جولی، ئێمە بانگەشەی پۆلیس دەکەین و ئێمەش تێکدەچین.

200
00:16:52.776 --> 00:16:56.511
- سەیرکە، با یەک خولەک بیر لەوە بکەینەوە.

201
00:16:56.580 --> 00:16:59.481
بیر لە چی بکەی؟

202
00:16:59.549 --> 00:17:02.451
لە ناوەڕاستی شەو هاتوچۆی شەقامەکە تێپەڕاند، باشه؟

203
00:17:02.518 --> 00:17:04.787
ڕووداو بوو، تۆ نە خواردت و نە زۆر خێرا بوویت.

204
00:17:04.854 --> 00:17:06.789
لە هەموو ئوتومبێلەکەدا شەراب هەیە بەڵام تۆ بێچاوییت

205
00:17:06.856 --> 00:17:09.224
- هەرگیز باوەڕیان بە من نابێت.

206
00:17:09.292 --> 00:17:12.427
ده ستبه سه ر ده ستم ده که ن، ئه وه ڕاسته نه بێت.

207
00:17:12.495 --> 00:17:15.030
تۆ گاڵتەم پێدەکەیت؟

208
00:17:15.098 --> 00:17:17.633
من زۆر سەرم خواردووە، من لەش بووم.

209
00:17:17.701 --> 00:17:20.135
نا، ئێمە بانگەشەی پۆلیس دەکەین، ڕاستییەکە پێمان دەڵێن!

210
00:17:20.203 --> 00:17:22.738
- باوەڕیان بە ئێمە دەکات.

211
00:17:26.442 --> 00:17:30.980
- هەرکەسێک تاوانەکەی ببەستێ، ئێمەش دەسوتین.

212
00:17:31.047 --> 00:17:33.816
مەحاڵە، شێتت؟

213
00:17:33.883 --> 00:17:38.253
گەرمیش شکاوە، لە هەموو شوێنێک خوێن هەیە، دەتوانین پاک بکەینەوە، با بچین.

214
00:17:38.321 --> 00:17:41.289
گوێ بگرن، ئێمە بۆ پۆلیس دەڕۆین!

215
00:17:41.357 --> 00:17:45.127
کاتمان نییە بۆ ئەو شتانەی تۆی، دەبێت خێرا هەنگاو بنێین!

216
00:17:45.194 --> 00:17:48.163
هی، با هەوڵبدە هێورببین.

217
00:17:48.231 --> 00:17:51.834
سەرنج بدە، تێناگات؟

218
00:17:51.901 --> 00:17:54.402
ئەگەر بەشێک لە ئۆتۆمبێلەکەشی هەبێت، بەشێک لە ئۆتۆمبێلەکەشی هەیە.

219
00:17:54.470 --> 00:17:58.306
ئەوان دەگەڕێنەوە بۆ تۆ، تۆ بەدواداچوون بۆ ڕووداوێکی هاتوچۆ دەکەیت.

220
00:17:58.374 --> 00:18:00.475
پاشان تەرمەکە دەفرۆشن.

221
00:18:00.543 --> 00:18:04.013
تۆ بێزار بوویت، گوێ بگرە، وانە کە ئێمە هەرگیز لێرە نەبین.

222
00:18:04.080 --> 00:18:06.715
ده توانین به ره و ئاو بکێشین و بیخەینه ناو ئاو.

223
00:18:07.917 --> 00:18:09.852
بۆ چەند هەفتەیەک ئەو گەندەڵە نەدەدۆزران.

224
00:18:09.919 --> 00:18:12.021
لەو کاتەدا هەموو بەڵگەکان دەڕۆن.

225
00:18:12.088 --> 00:18:14.189
ئەگەر بە هیچ شێوەیەک دۆزییانەوە.

226
00:18:17.994 --> 00:18:21.864
شەپۆلە بەهێزەکان، شەپۆلە خوارەکە دەتوانێت ببێتە دەریا.

227
00:18:21.931 --> 00:18:26.168
من هیچ بەشێک لە ئەمە نیم.

228
00:18:26.235 --> 00:18:29.571
ببین، من دەترسێم جولی من وەک ئێوە نیم

229
00:18:29.639 --> 00:18:33.441
من خێزانەکەتم نییە و پارەم نییە بۆ ئەوەی لەم دۆخە ڕزگارم بکەم.

230
00:18:33.509 --> 00:18:37.846
تکایە ئەمە داهاتوتە جولی

231
00:18:37.914 --> 00:18:40.716
بیر لەوە بکە

232
00:18:40.784 --> 00:18:44.720
کۆلێژ، ئەوەتا سکۆلەرشیۆنت هەیە.

233
00:18:44.788 --> 00:18:48.290
ئەو پیاوە لەئێستادا مردووە ئەگەر بگەڕێین بۆ پۆلیس، ئێمەش دەمرین.

234
00:18:52.495 --> 00:18:57.332
بەفرە

235
00:18:58.935 --> 00:19:01.236
چی بکەین؟

236
00:19:08.611 --> 00:19:11.714
شێت، ئەوان هێواش دەکەنەوە!

237
00:19:11.781 --> 00:19:14.783
- کێیە؟ - ماکسە.

238
00:19:14.851 --> 00:19:16.919
ڕزگاربکە!

239
00:19:23.059 --> 00:19:25.094
جولی چیت هەیە؟ کێشە لە ئۆتۆمبێل؟

240
00:19:25.161 --> 00:19:29.098
لە ڕاستیدا،

241
00:19:29.165 --> 00:19:31.433
باررییە، زۆر خواردووە.

242
00:19:31.500 --> 00:19:34.469
ئێمەش هەوڵدەدەین لە ئۆتۆمبێلی نوێدا پەرستیمان هەبێت.

243
00:19:34.537 --> 00:19:39.141
- ئیتر وا نوێ نییە، بەڵێ، مەخۆ و شۆفێر نەبێ.

244
00:19:39.209 --> 00:19:42.044
باوکم تووڕە دەبێت.

245
00:19:45.681 --> 00:19:50.485
- دەتوانم چی بکەم؟ - ئەتوانیت ئەو بزووتنەوەی "خەسارەکەم بۆنی نییە" لاببریتەوە.

246
00:19:54.791 --> 00:19:59.728
باشه ماکس، ده ست خۆش بێت، شەوی خۆش بێت

247
00:20:00.864 --> 00:20:03.999
تۆ خەریکە ئەو کوڕە دەوڵەمەندە بە زوڵمەکەیت، ڕای.

248
00:20:04.067 --> 00:20:06.168
بینین، ماکس.

249
00:20:07.237 --> 00:20:10.672
بەڵێ، وریا بیت جولی.

250
00:21:00.723 --> 00:21:04.159
تەنانەت ئەگەر لە چەند هەفتەی داهاتوودا تەرمەکەی بشۆردرێتەوە،

251
00:21:04.227 --> 00:21:07.229
لە لایەن کڕب و ماسی بچووکەوە دەدرێ.

252
00:21:09.032 --> 00:21:11.499
لەوانەیە ئێمە بەختمان هەبێت بە شارکێک.

253
00:21:13.970 --> 00:21:16.438
بێنە لایەوە.

254
00:21:19.809 --> 00:21:22.644
- دابخە خوارەوە.

255
00:21:22.712 --> 00:21:25.080
ئەوە بوو.

256
00:21:29.418 --> 00:21:31.686
با بكەین - چاوەڕێ بکە -

257
00:21:31.754 --> 00:21:33.722
- چی؟

258
00:21:33.789 --> 00:21:36.391
ئایا ده بێ پشکنین بۆ ئه و كه سه بكه ین؟

259
00:21:36.459 --> 00:21:39.694
- نازانم، باشه؟

260
00:21:39.762 --> 00:21:42.998
- تەنها بۆ زانین.

261
00:21:43.066 --> 00:21:45.367
با وانە کە ئەو شێتێکی هەڵهاتووە...

262
00:21:45.434 --> 00:21:48.036
بە دەستێک بە دەستێک، ئێمە خزمەتێک دەکەین بۆ هەمووان.

263
00:21:48.104 --> 00:21:50.538
ڕای، یارمەتیم بدە

264
00:21:51.774 --> 00:21:56.044
- پێم وانییە بتوانم، باری.

265
00:21:56.112 --> 00:21:59.214
- با بڕۆ، بارری، هێشتا دوا نییە.

266
00:21:59.282 --> 00:22:02.284
- خەبەرم، دەیکەم!

267
00:22:06.522 --> 00:22:08.723
یارمەتی، لێی دووربکە!

268
00:22:08.791 --> 00:22:12.094
دەستبەسەر بکە!

269
00:22:12.161 --> 00:22:15.730
تاجەکەم، تاجەکەم گرتووە!

270
00:22:15.798 --> 00:22:19.067
- نەخێر!

271
00:22:19.135 --> 00:22:21.970
بارری بارری

272
00:22:44.827 --> 00:22:47.529
<i>لە ئێرە!</i>

273
00:22:58.374 --> 00:23:00.342
-ئاوه!

274
00:23:02.478 --> 00:23:06.048
با بڕۆین، ئێستا دەچینە ماڵەوە،

275
00:23:06.115 --> 00:23:09.952
و هەرگیز، لە هیچ بارودۆخێکدا...

276
00:23:10.019 --> 00:23:12.321
خوا دەزانێت، دووبارە باسی ئەمە بکە.

277
00:23:12.388 --> 00:23:14.289
ڕوونە؟

278
00:23:14.357 --> 00:23:17.826
ئێستا تەنها پرۆژەیاسای چارەسەری داهاتوویە، ڕێک؟

279
00:23:17.893 --> 00:23:20.528
هێلێن!

280
00:23:22.565 --> 00:23:25.000
هەرگیز باسی ناکەمەوە

281
00:23:25.068 --> 00:23:29.904
ئێمە ڕێککەوتنێکمان هەیە، لێرە و ئێستا، ئەمەمان بۆ گۆڕەکەمان دەبەین.

282
00:23:29.973 --> 00:23:31.974
هاوڕام

283
00:23:32.041 --> 00:23:34.742
جولی؟

284
00:23:37.080 --> 00:23:39.547
سەری خۆت مەهێنە، تۆ بڵێ!

285
00:23:39.615 --> 00:23:41.816
بەڵێ، باشە.

286
00:23:41.884 --> 00:23:46.654
با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، با بیبین، بیبین، بیبین، بیبین، بی

287
00:23:46.722 --> 00:23:50.192
تۆ بڵێی

288
00:23:50.259 --> 00:23:53.095
باشه ، بارری ، ئه مه بۆ گۆڕه وه ده هێڵین

289
00:24:01.337 --> 00:24:03.838
هەموو شتێک باشە.

290
00:24:31.234 --> 00:24:33.902
*ئەو قسە دەکا*

291
00:24:33.969 --> 00:24:36.471
♪ له وه ی له ژێر باراندا بژیم ♪

292
00:24:36.539 --> 00:24:40.742
♪ هیچ تاوانێک نییە و دووبارە دەیکەیتەوە ♪

293
00:24:40.809 --> 00:24:44.946
*بە مایڵزێک جۆرێک بەختەوەری پێوان دەکرێت*

294
00:24:45.014 --> 00:24:48.683
*چی وایکرد بیرت بکەرەوە کە شتێکیت تایبەتە کاتێک بزانیت*

295
00:24:48.751 --> 00:24:51.586
<i>یۆ، کاتی ڕۆیشتنە</i>

296
00:24:53.523 --> 00:24:55.490
<i>با بڕۆ</i>

297
00:24:55.558 --> 00:24:59.227
بزانە ئەو دڕند و ناشیرینەی کە ماندوو بوویت، کچەکەم، دواداین.

298
00:24:59.295 --> 00:25:01.229
بیرم گۆڕی، ناچم.

299
00:25:01.297 --> 00:25:03.798
جولی، خۆت بکەرەوە وەک مردن،

300
00:25:03.866 --> 00:25:07.669
تەرمێکی تەنگ لە ئۆتۆمبیلەکەدا

301
00:25:11.240 --> 00:25:14.443
وتم، "با بڕۆ".

302
00:25:14.510 --> 00:25:17.112
جولی، تۆ بۆ هاوین دەچیتە ماڵەوە

303
00:25:17.180 --> 00:25:19.647
و تۆ لە پاشنەکەی تۆدا شینێکی دەبێت.

304
00:25:20.849 --> 00:25:24.319
با بڕۆین

305
00:25:47.243 --> 00:25:49.811
بیرت بێت، خۆر و خۆشی.

306
00:25:49.878 --> 00:25:52.847
بەڵێ، بەڵێ.

307
00:25:57.853 --> 00:25:59.787
جولی؟

308
00:25:59.855 --> 00:26:01.923
بەخێر هاتن بۆ ماڵ، ئازیزم.

309
00:26:05.961 --> 00:26:08.430
لەبیرت بووم

310
00:26:11.234 --> 00:26:13.735
چۆنە لە چڕکەرەکە؟

311
00:26:16.939 --> 00:26:21.843
من زۆر ویستبووم ماسی مونک بم، بەڵام وەرزی خراپ بوو و...

312
00:26:23.946 --> 00:26:26.615
ئایا تۆ ماددەی هۆشبەر بەکاردەهێنیت؟

313
00:26:26.682 --> 00:26:29.050
- چی؟

314
00:26:29.118 --> 00:26:32.487
من تەنها دەمویست سەرسوڕمانت بکەم، دەمویست کاردانەوەیەکی ڕاستگۆیان بۆ بدەم.

315
00:26:32.555 --> 00:26:34.523
- نەخێر

316
00:26:36.592 --> 00:26:38.660
نەخێر، دایكم، هیچ دەرمانێك نییە.

317
00:26:38.727 --> 00:26:44.533
باشە، چی کێشە؟

318
00:26:44.600 --> 00:26:48.403
بەڵێ، ساڵێکی سەختم بەسەرداهاتووە.

319
00:27:13.496 --> 00:27:16.231
نامه یه ک هاتینه وه ئه مڕۆ

320
00:27:16.299 --> 00:27:20.068
بەڵام ئەمە کارتەکەت نییە، هەفتەی ڕابردوو هاتووە.

321
00:27:20.135 --> 00:27:23.438
مامان، دەزانم خراپە، بەڵام وەرزی هاوین زۆر باش بەڕێوە چوو.

322
00:27:23.506 --> 00:27:27.609
دەبێت، چونکە بەگوێرەی دکان، تۆ تەنها یەک چانست هەیە.

323
00:27:27.677 --> 00:27:30.412
ئەوە زۆر جدی نییە.

324
00:27:30.479 --> 00:27:33.415
چی بەسەر کچەکەمدا هات؟

325
00:27:33.482 --> 00:27:37.752
مەبەستم ئەوەیە، ڕۆیشتیت و تەلەفۆنت نەکرد و سەردانی نەکرد.

326
00:27:39.054 --> 00:27:42.156
دەبێت باوکت لە گۆڕەکەیدا ڕووبدات.

327
00:28:11.520 --> 00:28:13.455
کێ ناردوویەتی؟

328
00:28:13.522 --> 00:28:16.891
هیچ پۆڵەتم و ناونیشانی گەڕاندنەوەی نییە.

329
00:28:16.959 --> 00:28:18.826
تۆ هەروەک من وایە، بۆچی؟

330
00:28:18.894 --> 00:28:20.895
هیچ شتێک

331
00:29:30.533 --> 00:29:34.869
* دەستت بە ژیانێکی باش دەکەیت *

332
00:29:34.937 --> 00:29:39.507
♪ ئەوە دەربارەی ژیانە لەگەڵ هاندەریدا ♪

333
00:29:39.575 --> 00:29:43.545
♪ دەست پێ بکە بە ژیانێکی باش ♪

334
00:29:49.284 --> 00:29:54.456
هاوڕێیان، هێوربکە، پێی دەڵێن شووشەی، شکێت.

335
00:29:58.060 --> 00:30:00.027
سبه ی خۆش، سڵاو

336
00:30:08.170 --> 00:30:11.706
با سەیرکەرێ، پشیلەکە چ دەرمانێکی تێدایە.

337
00:30:11.774 --> 00:30:13.941
ئەلسا، سڵاو.

338
00:30:14.009 --> 00:30:16.277
ئەزانم چی، پێویستە قسە لەگەڵ هێلین بکەم،

339
00:30:16.345 --> 00:30:20.314
ئەگەر بتوانیت ژمارەی نیویۆرکییەکەی بدەیت؟

340
00:30:20.383 --> 00:30:22.817
بەڵێ، پێویستە قسە لەگەڵیدا بکەم.

341
00:30:22.885 --> 00:30:26.020
دڵنیابە لە ڕاستییەکان، جولی، هێلین ژمارەیەکی نیویۆرکی نییە.

342
00:30:26.088 --> 00:30:28.556
ئەگەر پێویستت بە قسەکردن لەگەڵیدا هەیە، پێشنیار دەکەم بچیتە ناو بۆنەکانی ژنان،

343
00:30:28.624 --> 00:30:30.658
دە مەتر لە چەپتەوە.

344
00:30:33.496 --> 00:30:35.997
ترسناک، وانییە؟

345
00:30:37.099 --> 00:30:39.100
جولی؟

346
00:30:42.104 --> 00:30:44.572
کەی هاتتەوە ماڵ؟

347
00:30:44.640 --> 00:30:47.074
دوێنێ

348
00:30:47.142 --> 00:30:51.446
خۆشە کە تۆم بینیوە چی بەسەر نیویۆرکدا هاتووە؟

349
00:30:51.514 --> 00:30:57.184
بۆ ماوەیەک ڕۆیشتم بەڵام بە ڕاستی سەرکەوتوو نەبوو.

350
00:31:01.791 --> 00:31:04.759
کەسێک ئەمەی بۆ ناردم

351
00:31:04.827 --> 00:31:08.162
ئەی خودایە، کەسێک دەزانێت، هێڵن.

352
00:31:08.230 --> 00:31:10.498
چۆن؟

353
00:31:10.566 --> 00:31:13.568
-جولی، ئێمە زۆر وریا بووین.

354
00:31:13.636 --> 00:31:16.103
ئایا ئێمە؟

355
00:31:16.171 --> 00:31:20.608
چی ئەگەر کەسێک بینین؟

356
00:31:20.676 --> 00:31:23.244
- ساڵێک تێپەڕی - نازانم

357
00:31:27.115 --> 00:31:29.884
ئایا بارری ئەمەی بینیوە؟

358
00:31:29.952 --> 00:31:33.588
ئایا جارێ بارری لە قوتابخانە بینیوە؟

359
00:31:33.656 --> 00:31:36.223
زانکۆیه کی گه وره یه ، دڵنیایت که گه ڕانه وه ی کردۆته وه ؟

360
00:31:36.291 --> 00:31:39.060
ڕۆژێک لە ڕۆژانی ڕابردوو ئۆتۆمبیله که ی له هۆڵێکی وەرزشدا بینی.

361
00:31:40.529 --> 00:31:42.530
ئێوە جیابوونەوە؟

362
00:31:42.598 --> 00:31:45.199
هی!

363
00:31:45.267 --> 00:31:48.603
ئێوە لێرە چی دەکەن؟

364
00:31:52.575 --> 00:31:54.576
سڵاو، بار.

365
00:32:01.717 --> 00:32:04.819
ئەمە هیچ نییە. "دەزانم هاوینی ڕابردوو چی کردیت"؟

366
00:32:04.887 --> 00:32:09.791
-ئەی چ گەندەڵی، پێویستمان بە یارمەتییە.

367
00:32:09.859 --> 00:32:12.560
بەڵێ، دەڵێم، ئێوەش پێویستە جار جار ئاوێنەیەک ببینن.

368
00:32:12.628 --> 00:32:15.897
- ئێوە دوو جار وەکوو شۆکێک دواداون.

369
00:32:17.232 --> 00:32:19.667
ناتوانین بەجێی نەهێڵین.

370
00:32:19.735 --> 00:32:23.204
جولی، چۆن دەزانی ئەمە پەیوەندی هەیە؟

371
00:32:23.271 --> 00:32:25.206
<i>توانای زۆر شت لە هاوینی رابردوو کرد.</i>

372
00:32:25.273 --> 00:32:28.576
- بەڵێ، باشە، تەنیا یەک کوشتن دێتە بیرەوە.

373
00:32:32.280 --> 00:32:35.182
ئێمە کەسمان نەکوشتووە.

374
00:32:35.250 --> 00:32:38.486
هێشتا زیندووی بوو کاتێک لە ئاودا هەڵداین، ئایا دەبێت دووبارە ئەم بابەتە بکەینەوە؟

375
00:32:38.554 --> 00:32:42.123
ڕووداو بوو، ئەو پیاوە لە ناوەڕاستی ڕێگایە.

376
00:32:42.190 --> 00:32:46.093
ناوی دیڤید ئێگان بوو - کێ؟

377
00:32:46.161 --> 00:32:48.129
دەیڤید ئیگان

378
00:32:49.364 --> 00:32:51.733
دوای سێ هەفتە دۆزرایەوە

379
00:32:53.268 --> 00:32:56.704
تەرمەکەی لە تۆڕێکی کەرکوکدا گیرابوو لە نزیک دەروازەی میلەر.

380
00:32:56.772 --> 00:32:59.741
لە ڕۆژنامەکەدا بوو.

381
00:32:59.808 --> 00:33:03.110
پێموایە پۆلیس پێیوتووە خنکانێکی رووداو.

382
00:33:05.014 --> 00:33:09.116
تۆ دەتوانیت بە ڕووداو بڵێیت، بەڵام بەهۆی ئێمە گیانی لەدەستدا.

383
00:33:11.787 --> 00:33:13.855
ئەی ڕەی؟

384
00:33:15.858 --> 00:33:19.193
ئایا ئەم نامەیەت پێ نیشانداوە؟

385
00:33:19.261 --> 00:33:21.195
لە هاوینی رابردووەوە ڕای نەبینیوە.

386
00:33:21.263 --> 00:33:23.765
ئێمە جیابینەوە، دوایین جارش بیستم کە لە باکوور کار دەکات.

387
00:33:25.834 --> 00:33:29.470
باشه ، با بڵێین که سێک ئه و شه وه له وێ بوو

388
00:33:30.839 --> 00:33:33.575
بۆ یه ك ساڵ دواتر نامه یه ك بنێرێت؟

389
00:33:33.642 --> 00:33:36.644
لەوانەیە کریکێک لە ناودا بێت.

390
00:33:39.181 --> 00:33:41.182
ماکس

391
00:33:43.251 --> 00:33:45.687
ماکس، تۆ چی؟

392
00:33:45.754 --> 00:33:48.089
کێ دی؟

393
00:33:48.156 --> 00:33:50.625
ئەو پیڵەتەی دیکە بهێنن.

394
00:33:53.528 --> 00:33:56.197
ئێوەش لێرە چاوەڕێی بکەن، چی دەکەن؟

395
00:33:56.264 --> 00:33:59.400
دەزانم چی دەکەم

396
00:34:04.339 --> 00:34:06.307
با بیرت لێبکەرەوە.

397
00:34:06.374 --> 00:34:10.311
دەزانیت، من لە خۆمدا بیرم دەکردەوە، "چی بەسەر ئەو بارری کۆکسدا هاتووە؟"

398
00:34:10.378 --> 00:34:13.347
ها، ماکس.

399
00:34:13.415 --> 00:34:17.885
بیسه ر، ده توانی یه ك سات له خۆماندا قسه بكه ین؟

400
00:34:17.953 --> 00:34:20.655
چی؟ ئەمە بۆ تۆ بەسە تایبەت نییە؟

401
00:34:27.696 --> 00:34:29.731
بەڵێ، چی؟

402
00:34:29.798 --> 00:34:33.034
گوێ بیسه ، تۆی به رزه ، نامه که تمان پێوه هاتووه

403
00:34:33.102 --> 00:34:35.436
- باسی چی دەکەیت؟

404
00:34:35.504 --> 00:34:39.007
ئەو شەوە بینیمان، تۆ لە چ گیرفانێک داین؟

405
00:34:39.074 --> 00:34:41.976
عیسای من، گوێ بگرە، یەکجار دەڵێم.

406
00:34:42.044 --> 00:34:45.346
من لە تۆ دەمکوژم، من هیچ کێشەیەکم نییە.

407
00:34:45.413 --> 00:34:47.815
لێم دوور بکەوە، تێدەگەیت؟

408
00:34:47.883 --> 00:34:50.351
ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه ی، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه، ئه،

409
00:34:59.628 --> 00:35:02.830
تۆ تۆڵەی ئەشکەرە!

410
00:35:02.898 --> 00:35:05.733
تاقی مەکە، تۆڕمە!

411
00:35:05.801 --> 00:35:09.003
پۆلیس بانگ دەکەم بۆ ئەوەی تۆ تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵەی تۆڵ

412
00:35:09.071 --> 00:35:12.406
ئایا ناوبراو دان بەوەدا هێنا؟

413
00:35:12.474 --> 00:35:15.576
چی کرد؟ من خۆمم کرد، باشه؟

414
00:35:15.644 --> 00:35:18.880
چۆن؟ من ترساندم، باشه؟

415
00:35:20.916 --> 00:35:22.884
-با لە من بێ.

416
00:35:28.190 --> 00:35:30.291
کۆنتەرێکی دیکە دابنێ!

417
00:35:30.358 --> 00:35:34.562
کەواتە، ڕای گەورە بوو بۆ ئەوەی ڕاوچی بێت، ھە؟

418
00:35:34.629 --> 00:35:39.266
بەڵێ، نزیکەی ساڵێکە کار لەسەر ئەوەم دەکەم، لە کۆتایی.

419
00:35:39.334 --> 00:35:43.738
خۆشە، ژیانێکی خۆشتان هەبێت، من لێرەم.

420
00:35:49.178 --> 00:35:51.879
خولەکێکت هەیە؟

421
00:35:51.947 --> 00:35:54.381
دەبێ بگەڕێمەوە بۆ کار.

422
00:35:54.449 --> 00:35:57.785
تەلەفۆن بکە، دەتوانین پێکەوە بین.

423
00:35:57.853 --> 00:35:59.954
بەڵێ، باشە.

424
00:36:08.363 --> 00:36:10.364
ئێمە پێویستە قسە بکەین.

425
00:36:11.767 --> 00:36:15.369
پێتوایە ماکس ناردوویەتی؟

426
00:36:15.437 --> 00:36:18.339
ئێوە دەزانن ماکس چۆن هەست بە ئێوە دەکات

427
00:36:18.406 --> 00:36:21.709
ببینه ، ده بێت ته نها ده ست له گه ڵدا بێت و کاری زۆریشی نییه

428
00:36:21.777 --> 00:36:23.911
بەڵێ، لەوانەیە.

429
00:36:23.979 --> 00:36:28.449
باشە، قوتابخانە چۆنە؟

430
00:36:28.516 --> 00:36:31.185
کەواتە تۆ ڕاوچیی

431
00:36:31.253 --> 00:36:33.520
بەڵێ، پێشبینییەکە جێبەجێ بوو، وانییە؟

432
00:36:33.588 --> 00:36:37.291
من بووم بە باوکم، پێم وابوو تۆ باوکی خۆت ناناسیت.

433
00:36:37.359 --> 00:36:41.195
ئەو کەشتییەکان کاری دەکرد، ئەوە هەموو شتێکە کە من لە بارەی ئەو دەزانم.

434
00:36:41.263 --> 00:36:45.666
سەیرکەر، زۆر بیرم لە هاوینی ڕابردوو کرد.

435
00:36:45.734 --> 00:36:51.239
دەزانم کە تۆ منی بە بەرپرسیار دەزانێ، بەڵام من تۆ بە بەرپرسیار ناهێنم.

436
00:36:51.306 --> 00:36:54.776
نەخێر، من بەرپرسیارم لە کارەکانم و تۆ تۆمەت لێ ناکەم.

437
00:36:57.345 --> 00:36:59.513
بەڵام من نامەوێ تۆیش بزانیت

438
00:37:30.846 --> 00:37:33.447
ئەى، بەلاى خۆى!

439
00:38:22.364 --> 00:38:27.668
* بێدەنگی، بێدەنگی دڵی من شکاندووە*

440
00:38:27.736 --> 00:38:31.272
* زوو لە بەیانی یان ئێوارە *

441
00:38:31.340 --> 00:38:33.507
♪ ئۆ، من دەبێ باوەڕت پێ بکەم ئازیز ♪

442
00:38:51.226 --> 00:38:55.129
* هێم، هێم، پێم وابوو ئێستا گوێم لە تۆ بوو کە ناوی من بانگ دەکەیت*

443
00:38:55.197 --> 00:38:58.432
*ئێستا بێدەنگ بن، بێدەنگ بن

444
00:39:05.908 --> 00:39:07.875
سڵاو؟

445
00:39:36.771 --> 00:39:39.240
سڵاو؟

446
00:40:08.437 --> 00:40:10.804
هی!

447
00:40:23.018 --> 00:40:24.986
- چیا؟

448
00:40:29.524 --> 00:40:32.093
ژاکتی من

449
00:40:34.796 --> 00:40:38.665
هانک، کێ دیکه لێره یه ؟

450
00:40:38.733 --> 00:40:41.202
تەنها ئێمە و تۆ، هاوڕێ.

451
00:40:43.305 --> 00:40:46.440
هی، هی!

452
00:40:47.075 --> 00:40:49.377
تۆی گەندەڵ!

453
00:40:59.454 --> 00:41:01.389
ماکس، تۆ مردووی.

454
00:41:58.146 --> 00:42:00.448
یارمەتیم بدەن!

455
00:42:00.515 --> 00:42:05.652
یارمەتیم بدەن!

456
00:42:11.025 --> 00:42:13.727
چی ده ته وێت؟

457
00:42:22.370 --> 00:42:26.273
ببورە، ببورە، سوێند دەخۆم، مەبەستمان نەبوو.

458
00:42:26.341 --> 00:42:28.309
<i> تکایە مەهێڵن.</i>

459
00:42:31.646 --> 00:42:36.117
ساتێک تکایە ئەفسەر

460
00:42:36.184 --> 00:42:38.652
<i>Mm-hmm.</i>

461
00:42:43.158 --> 00:42:46.026
جولی

462
00:42:46.094 --> 00:42:48.462
چی ڕوویدا؟

463
00:42:48.530 --> 00:42:53.367
نەخێر، بۆ چرکەسەم جار نەمتوانی ڕوخساری ببینم.

464
00:42:53.435 --> 00:42:56.303
هیچ بژاردەیەکمان نییە، باشە؟

465
00:42:56.371 --> 00:43:00.441
- دەبێت بچینە پۆلیس - نەخێر، دوێنێ شەو نەیویست بمکوژێت

466
00:43:00.509 --> 00:43:03.010
ئەگەر دەیویست بمری، دەیتوانی، بەڵام خەریکی گاڵتە کردنە.

467
00:43:03.077 --> 00:43:06.247
- نازانم، کەسێک لە شانی پێستدا.

468
00:43:06.314 --> 00:43:09.716
ئەمە کەم دەکاتەوە، ئەمە گوندێکی ماسیگەری جوان و هەموو شتێکە.

469
00:43:09.784 --> 00:43:12.186
و لەبەر ئەوەی تۆ باسی دەکەیت،

470
00:43:12.254 --> 00:43:15.623
هەموومان دەزانین کە تۆ شلەکت هەیە.

471
00:43:16.958 --> 00:43:19.726
تۆ ئەمەی بەسەرمدا هەڵناگرێ

472
00:43:19.794 --> 00:43:23.564
نەخێر، تکایە ئەمە مەکەن، ئەمە هیچمان پێ نەگەیەنێت!

473
00:43:25.900 --> 00:43:30.003
ببینه ، ده بێ ئێمه ته نها ده ست خۆش بكه ین

474
00:43:30.071 --> 00:43:34.408
نەخێر، ئێمە ڕێککەوتنمان پێکردووە و بەردەوام دەبین لەسەر.

475
00:43:34.476 --> 00:43:38.579
بەڵێ، بەڵام ئەوە شێتیە، بارری سەیری ئێمە بکە، ئەم نهێنییە دەمکوژێت.

476
00:43:38.647 --> 00:43:42.183
من ناچم بۆ پۆلیس و تۆیش ناڕۆیت

477
00:43:42.250 --> 00:43:44.351
بارری تکایە، دەتوانین کۆتایی پێ بهێنین...

478
00:43:44.419 --> 00:43:47.154
و رەنگە بچینە بەشێکی بچووک لە ژیان.

479
00:43:47.222 --> 00:43:51.091
چۆن ئه وه ده كه ین؟

480
00:43:51.159 --> 00:43:56.129
ئەمە تیرۆر بوو، وتەکانت، لەبیرت نییە؟

481
00:43:56.198 --> 00:43:59.533
من دەڵێم با دۆزینەوە کێ ئەمە دەکات و یەکتریان بکەین.

482
00:43:59.601 --> 00:44:02.236
- چ، وەک دوێنێ شەو، بار؟

483
00:44:02.304 --> 00:44:05.539
نەخێر، بارری راستە، ئەوەی ئەمە بکات، نەچێتە پۆلیس.

484
00:44:05.607 --> 00:44:09.076
دەتوانین ئەو پیاوە بدۆزینەوە و قسە لەگەڵدا بکەین.

485
00:44:09.143 --> 00:44:12.546
چۆن ده یبینین؟

486
00:44:12.614 --> 00:44:16.817
دەبێت هاوڕێی یان ئەندامێکی بنەماڵەی ئەو کەسە بێت کە لێداین.

487
00:44:16.884 --> 00:44:19.353
ناوی چی بوو؟

488
00:44:21.590 --> 00:44:24.191
دەیڤید ئیگان.

489
00:44:25.993 --> 00:44:28.095
دەیڤید ئیگان

490
00:44:29.264 --> 00:44:31.198
گوێ بگرە، پێم وایە نابێت واز لە ماکس بهێنین.

491
00:44:31.266 --> 00:44:33.567
دەمەوێ بڵێم، هێشتا لەوانەیە ئەو بێت.

492
00:44:33.635 --> 00:44:35.869
ئەوەى دەتەوێت بیسەلمێنێت کە باررى هەڵەیە، وانییە؟

493
00:44:35.937 --> 00:44:39.072
نا، ئێستا، من دەمەوێت تۆ و من تەنها... گوێ لە من بگرە، ڕای، باشه؟

494
00:44:39.140 --> 00:44:43.076
دەمەوێت شتێکت بۆ وەربگرێ، هیچ "تاو من"ێک نییە.

495
00:44:43.144 --> 00:44:46.614
دکتۆر براون دکتۆر براون

496
00:44:52.854 --> 00:44:55.956
باشە، دەتوانم بە ئینتەرنێت بە کتێبخانەی ناوخۆیی بگەم.

497
00:44:56.023 --> 00:44:59.192
پێم وایە دەتوانین ئاماژەمان پێ ببەستین و هەموو ئەو شتانەی کە پێویستمان بە زانین، وەربگرین.

498
00:44:59.261 --> 00:45:02.129
ئێگان، دەیڤید.

499
00:45:04.132 --> 00:45:07.901
<i>- هەموو ئەم بابەتانە دەربارەی دەیڤید ئیگانن؟ - بەڵێ، یان لانیکەم باسی ئەو بکەن.</i>

500
00:45:07.969 --> 00:45:11.805
<i>پێویستە هەرچییەک بە ناوی بێتەوە.</i>

501
00:45:11.873 --> 00:45:15.276
چاوەڕێ بکە، پێنجی تەممووز، دوو ساڵ لەمەوبەر.

502
00:45:15.343 --> 00:45:17.844
"سوسێ ویلیس بەهۆی خنکانەوە گیانی لەدەستدا.

503
00:45:17.912 --> 00:45:20.113
"ئەو لە ئۆتۆمبێلێکدا گیرابوو دوای ئەوەی لە کۆنترۆڵ هات...

504
00:45:20.181 --> 00:45:22.115
"لە کەنارەکانی دەریا نزیک کەناری دۆسۆن

505
00:45:22.183 --> 00:45:26.219
شۆفێرەکەی، دەیڤید ئێگان، بریندار نەبوو".

506
00:45:26.288 --> 00:45:29.723
"سوسێ لەگەڵ داڤید پیلان بوو، ئەوان هاوسەرگیرییان دەکرد".

507
00:45:31.393 --> 00:45:35.696
ساتێک، بیرم دێت ناوی ئەو لە بازنەکەی دا تاتۆ کراوە.

508
00:45:35.764 --> 00:45:41.134
"لەژیان ماوەتەوە لەلایەن دایکی (کلێر) و خوشکەکەی (میلیسا ئیگان) لە شارەدێی (مەریبل) "

509
00:45:41.202 --> 00:45:45.872
ئەوان لە دارستانەکاندا دەژین، تۆ چی دەزانیت؟

510
00:45:45.940 --> 00:45:48.776
چیمان هەیە لەدەست بدەین؟

511
00:45:53.080 --> 00:45:55.248
ڕاست بکە، لە کوێ؟

512
00:45:55.317 --> 00:45:57.384
ئەوێ

513
00:45:59.053 --> 00:46:01.822
* خەمگینیت*

514
00:46:01.889 --> 00:46:06.327
♪ پەپولە تەنها دەگریێ

515
00:46:06.394 --> 00:46:09.496
* فرمێسکێک کە لێدزێت *

516
00:46:09.564 --> 00:46:11.532
پلانەکە چیە؟

517
00:46:11.599 --> 00:46:15.336
ئایا ده بین ده رگای ده رگا ده گرین و ده ڵێین: "ئێمه كوڕه كه تمان كوشتووه ، له نزیكین، بۆیه"...

518
00:46:15.403 --> 00:46:17.604
سەیرکەر، بیرم کردەوە کە بتوانین بەدواداچوون بکەین و دواتر بە گوێی خۆمانەوە بیبینین.

519
00:46:17.672 --> 00:46:20.674
پێتوایە نابێت پلانێکمان هەبێت؟

520
00:46:20.742 --> 00:46:23.811
ئەنجێلا لانسبیری هەمیشە پلانێکی هەبوو.

521
00:46:31.519 --> 00:46:33.821
چی ئەگەر چاوەڕێی ئێمەن؟

522
00:46:33.888 --> 00:46:35.989
ئەگەر ئێمە بناسێنن، دەتوانن چەکیان هەبێت و بمرین.

523
00:46:36.057 --> 00:46:39.426
ساڵێک تێپه ڕبوو هێڵن، ئه وان ده یانتوانی ئه وه ی ئه نجام بده ن.

524
00:46:39.494 --> 00:46:43.397
جۆدی فۆستەر ئەمەی تاقی کردەوە و قاتڵێکی زنجیرە بە دەرگاکە کردەوە.

525
00:46:57.545 --> 00:46:59.946
هەوڵێکی باش بوو.

526
00:47:12.126 --> 00:47:15.596
بۆ زیادکردنی دزین و چوونە ناو ناو کۆمەڵێک تاوانمان؟

527
00:47:15.663 --> 00:47:18.131
دەتوانم یارمەتیت بدەم؟

528
00:47:19.967 --> 00:47:24.905
سڵاو، ئۆتۆمبێلەکەمان لە شەقامەکە وەستا

529
00:47:24.972 --> 00:47:27.474
<i>و ئێمە تەنها دەمانویست بزانین ئەگەر ئەتوانین مۆبایلەکەت بەکاربهێنین؟</i>

530
00:47:37.018 --> 00:47:40.253
تەلەفۆن لەوێیە.

531
00:47:40.321 --> 00:47:44.090
جۆدی،

532
00:47:44.158 --> 00:47:46.727
ئایا تەلەفۆن دەکەیت بۆ سێ هێڵی "A"؟

533
00:47:47.829 --> 00:47:51.965
دەستت پێدەکەوێت، ئەنگێلا.

534
00:48:07.916 --> 00:48:12.553
ناوی من خانم ئیگانە، ئێوە کچانی ماریبلن؟

535
00:48:12.620 --> 00:48:16.189
ساوتپۆرت، من چوومە زانکۆی ساوتپۆرت

536
00:48:16.257 --> 00:48:19.893
ئەزانم بە ئاشناییت دەردەکەوێت.

537
00:48:19.961 --> 00:48:25.432
- پۆلەکەی 1988 ـ ناوت، ئیگان، زۆر ئاشنا ده بێ.

538
00:48:25.500 --> 00:48:29.636
براکەت هەبوو یان شتێک؟

539
00:48:29.704 --> 00:48:31.805
دەیڤد، گەنجتر.

540
00:48:31.873 --> 00:48:36.009
- لە ساڵی ٩٢، بەڵام مردووە.

541
00:48:36.077 --> 00:48:38.946
زۆر ببورە

542
00:48:39.013 --> 00:48:43.884
- تۆ، ئێ، تۆ بە تەنیا دەژیت؟

543
00:48:45.186 --> 00:48:48.121
بەڵێ، من دەزانم.

544
00:48:48.189 --> 00:48:52.325
باوکم ماوەیەکی زۆر لەمەوبەر کۆچی دوایی کرد و دایکم...

545
00:48:52.393 --> 00:48:57.531
لە ماڵێکی خۆرئاوا، چونکە ئەو زۆر بە باش نەگرت لەوەی کە بە دەیڤید ڕوویدا.

546
00:48:58.867 --> 00:49:01.602
شتەکان هەر وەک خۆی نەبوون لەدوای مردنی

547
00:49:07.642 --> 00:49:10.677
ئەوان لە ڕێگایانن.

548
00:49:10.745 --> 00:49:15.215
دەتوانم، ئەتوانم... ئەتوانم چێشتێکتان بۆ دروست بکەم لەکاتێکدا چاوەڕوانی دەکەن.

549
00:49:15.282 --> 00:49:19.486
زۆر سوپاس، زۆر زۆر زۆر دڵسۆزیت

550
00:49:32.099 --> 00:49:34.635
دەزانی، پێم وایە دەیڤیدم لەبیرە.

551
00:49:34.702 --> 00:49:36.803
هاوڕێی هەبوو، باشە؟

552
00:49:36.871 --> 00:49:39.706
کێ؟

553
00:49:39.774 --> 00:49:42.776
ئایا لەگەڵ ئەو پیاوەدا نەبووە؟

554
00:49:42.844 --> 00:49:46.446
- ئەی خودایە، ناوی چی بوو؟

555
00:49:46.514 --> 00:49:49.282
من زۆرێک لە هاوڕێیەکانی دەیڤید نەم ناسی.

556
00:49:49.350 --> 00:49:51.418
-ئەی!

557
00:49:51.485 --> 00:49:56.089
بەڵام کەسێک هەبوو، کەسێک.

558
00:49:56.157 --> 00:49:58.992
دوای ماوەیەکی کەم دوای مردنی داود هاتە ژوورەوە

559
00:49:59.060 --> 00:50:01.461
و هات بۆ ڕێزگرتن.

560
00:50:01.529 --> 00:50:06.466
- بەڵێ، زۆر پیاوی خۆش بوو.

561
00:50:06.534 --> 00:50:08.869
زۆر جوان و زیرەک بوو و...

562
00:50:10.038 --> 00:50:12.405
ئێمە... ئێمە لە یەکتر دڵسۆز بووین...

563
00:50:12.473 --> 00:50:16.176
بۆ ماوەی دوو خولەک، بەڵام کار نەکرا.

564
00:50:16.243 --> 00:50:21.281
دەزانی، بەڵام هەرگیز نەیفەرموێت، بەڵام پێم وایە کە بەدوورم بوون ئازاری داوە.

565
00:50:23.017 --> 00:50:25.518
ئەو هاوڕێیە کۆنەکە ئێستا لە کوێیە؟

566
00:50:25.587 --> 00:50:28.388
- نازانم.

567
00:50:28.456 --> 00:50:31.892
ناوی تەیاد دەكەین؟

568
00:50:31.960 --> 00:50:36.463
ئایا ناوى ناوى ناوى بوو؟

569
00:50:36.530 --> 00:50:41.167
-دەبێ لە سەیارەکەدا چاوەڕێی بکەین.

570
00:50:41.235 --> 00:50:44.037
نەخێر، گاڵتە مەکە، بۆ دەمێنیتەوە؟

571
00:50:44.105 --> 00:50:46.740
نەخێر، من نامەوێ سێ گۆشەی "ئ" لە دەست بدەم.

572
00:50:46.808 --> 00:50:49.643
ئێمە سوپاسی تەلەفۆن دەکەین هەرکاتێک، دەزانیت.

573
00:50:49.711 --> 00:50:53.179
من لەم سەردەمەدا زۆر کەس لە دەرگا ناکەشن.

574
00:50:53.247 --> 00:50:56.083
-ئەی باشە؟

575
00:50:56.150 --> 00:50:59.886
من لەش بووم، ببورە.

576
00:50:59.954 --> 00:51:03.423
بەڵام لە ماڵەکەی و بینینی خوشکەکەی...

577
00:51:04.558 --> 00:51:07.094
ئەی خودایە، بینی چیمان کرد؟

578
00:51:09.597 --> 00:51:11.564
ڕووداو بوو

579
00:51:13.701 --> 00:51:17.971
هێلێن، ئێمە پیاوێکمان کوشت و دواتر ژیانی هەموو ئەوانەی کە ناسیون تێکاند.

580
00:51:18.039 --> 00:51:22.242
پێم وانییە هێندە بەهێزین جولی تۆ زۆر سوپاسمان بۆ دەکەیت

581
00:51:23.911 --> 00:51:26.546
هی!

582
00:51:28.282 --> 00:51:33.219
جگەرەت لەبیر کرد، سوپاس.

583
00:51:35.356 --> 00:51:38.025
دیمەن سەیارەکەت دەستپێکردووە، وانییە؟

584
00:51:38.092 --> 00:51:42.362
بەڵێ، خراپترین شت، هەر لە سەرەتاوە دەستی پێکردووە، سەیر وایە چۆن ڕوو دەدات.

585
00:52:02.416 --> 00:52:04.818
ئێستا چی؟

586
00:52:04.886 --> 00:52:08.354
ئێستا هەوڵدەدەین شوێنەکەی بیلی بلیو بدۆزینەوە.

587
00:52:13.360 --> 00:52:15.528
لەوانەیە ویستی بمرێت.

588
00:52:17.398 --> 00:52:21.034
چی؟ دیدی ئێگان.

589
00:52:21.102 --> 00:52:25.972
خۆشەویستەکەی لە هەمان ڕێگادا کوژرا، لە ٤ی تەمووز ساڵێک پێش ئێستا.

590
00:52:26.040 --> 00:52:30.476
لەوانەیە خۆی تاوانبار بکات، لەوانەیە لە شەقامدا دانیشتبێت و چاوەڕێی لێدانیمان بکات.

591
00:52:31.612 --> 00:52:34.414
بەڵێ، ئەگەر ئەوە یارمەتیت بدات شەوانە بخەویت.

592
00:52:37.351 --> 00:52:40.187
چی بەسەر هاتووە لەنێوان ئێمەدا؟

593
00:52:40.254 --> 00:52:42.322
ئێمە پێشتر باشترین هاوڕێی بووین.

594
00:52:43.624 --> 00:52:46.459
پێشتر زۆر شت بووین.

595
00:52:47.595 --> 00:52:49.562
من لە تۆ دوژمنی

596
00:52:56.237 --> 00:52:58.205
بەڵێ، باشە.

597
00:53:11.552 --> 00:53:14.020
لە خاکدا، تۆپ دوو.

598
00:53:14.088 --> 00:53:16.957
گارێت وا دەردەکەوێت ئەمڕۆ دەسەڵاتی ئاسایی خۆی نەبێت، گریگ.

599
00:53:17.024 --> 00:53:21.361
لە ڕاستیدا ئەمە زۆر دڕندەیە تا ئێستا لە وەرزەکەدا بینیمان.

600
00:53:21.428 --> 00:53:24.330
راستە دەیڤ لە سێ یاری ڕابردوودا

601
00:53:24.398 --> 00:53:28.735
تەنها سێ بنەماى مۆڵەتى پێدانى هەیە، هیچ یەکێک لەو دوچرخه كانى تۆمارى ئەنجامى نەداوە.

602
00:53:28.803 --> 00:53:31.437
زۆر سەرنجڕاکێشە لە کاتێکدا نیل دەچێتە ناو سندوقەکە...

603
00:53:31.505 --> 00:53:34.307
