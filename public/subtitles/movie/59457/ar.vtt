7
00:02:44.214 --> 00:02:47.747
<i>الشـيءُ اللذي وهـبتـني إيـاه فـي الـنهـايه</i>

8
00:04:24.916 --> 00:04:33.916
{\a6}
<font color="# FF1122" >الــرَّحِـــم </font>
{\a6}

9
00:05:37.018 --> 00:05:37.830
نــعــم ..؟

10
00:05:41.026 --> 00:05:44.357
هـل تـريدينَ أن أقـرأ لكِ .؟ -
لا، شكراً -

11
00:05:47.945 --> 00:05:51.276
طـابتْ لـيـلتُـكَ، جدي

12
00:06:19.330 --> 00:06:23.539
!.مرحباً
أَدعـى  ـ(تـومـي)ـ ، وأنـتِ.؟

13
00:06:27.166 --> 00:06:28.991
ـ(ريـبـيكا)ـ

14
00:06:30.553 --> 00:06:32.129
هـل إنـتقلـتِ مـؤخـراً .؟

15
00:06:32.960 --> 00:06:36.374
لا ، يُقـيمُ جـدِّي هنا، سأمـكثُ معـه

16
00:07:51.446 --> 00:07:54.647
ـ(ريبيكا)ـ ، جَدٌّكِ على الهاتف

17
00:07:56.781 --> 00:08:00.646
مـسـتـغـرقـه فـي نـومـهـا ، هـل أوقـضهـا لك .؟

18
00:08:03.491 --> 00:08:06.398
لا لا على الإطلاق ، لابـأسَ بـذلك

19
00:08:06.855 --> 00:08:08.566
مُرحـباً لهـا أن تقـيمَ هـذه الليـله

20
00:08:14.162 --> 00:08:15.915
طـابت لَـيـلتُـك

21
00:09:19.768 --> 00:09:22.637
أخـبرْني أيـن نحـنُ ذاهــبون.؟

22
00:11:29.688 --> 00:11:32.640
رأيـتهُ مُسـبقاً عـلى أطـراف العُشب

23
00:11:33.523 --> 00:11:36.724
بـدى وكـأنه مـن كـوكَبٍ مُـخـتلفٍ عـنه

24
00:11:38.274 --> 00:11:41.688
غداً سـنأخُذهُ إلى الشـاطئ ونـُريـه البـحـر

25
00:11:43.484 --> 00:11:46.981
..لـن أكُـونَ هـُـنا في الغــد ، سـأرحـلُ مـن هـُـنـا

26
00:11:50.403 --> 00:11:53.355
ذاهـبـةُ إلـى بـيـتك..؟

27
00:11:55.280 --> 00:11:58.232
لا -
أيـنَ إذاً .؟ -

28
00:11:58.906 --> 00:12:02.107
إلى ـ[طـوكيو]ـ -
ـ[الـيـابـان]ـ..؟ -

29
00:12:04.450 --> 00:12:05.912
لأجـلِ مـاذا.؟

30
00:12:07.501 --> 00:12:09.759
والـدتي حـصـلتْ على وظـيـفـةٍ هـناك

31
00:12:09.993 --> 00:12:14.783
سـنُقـيمُ فـي الطابقِ الثاني والسبعونِ -
!إثنانِ وسبعون.؟ -

32
00:12:16.829 --> 00:12:19.911
ذلـكَ مُـرتَفَع

33
00:12:21.372 --> 00:12:24.324
يَجِبُ أَنْ أَذْهبَ

34
00:13:02.470 --> 00:13:05.007
!.مرحباً -
ـ(ريـبـيكا)ـ.؟ -

35
00:13:05.688 --> 00:13:06.923
أين أنتِ..؟

36
00:13:06.924 --> 00:13:09.887
عند الشاطئِ ،خَرجتُ لأشـاهـدَ العاصفةَ

37
00:13:11.015 --> 00:13:15.969
متى ستـُغادرينَ غـداً.؟ -
فـي السـادسـه سأغـادر ، على الـعـبّارة -

38
00:13:17.183 --> 00:13:21.048
سَأُودّعُك ،،لديَّ فكرة جيدة

39
00:13:23.185 --> 00:13:26.268
ـ(ريـبـيكا)ـ .؟ -
نعم ، مـعـك -

40
00:13:28.646 --> 00:13:33.435
ـ(تـومـي)ـ  ، مرحبـا.؟
ـ(تـومـي)ـ

41
00:14:12.202 --> 00:14:15.616
حـآنَ الـوقـتْ ، ـ(ريـبـيكا)ـ

42
00:16:03.449 --> 00:16:06.982
المـعـذره ، مـاذا يُمـكنُني أن أسـاعدكِ

43
00:16:08.576 --> 00:16:12.785
جِـئـتُ لـرُؤيـة ، ـ(تـومـي)ـ  -
أوه، لـم يعـد يعيـشُ هـنا منـذ زَمَـنٍ طويل -

44
00:16:16.871 --> 00:16:19.823
تَـبْديـنَ مـألـوفَـةً جـداً ، هَلْ قـابلـتُكِ مـن قـبـل.؟

45
00:16:20.914 --> 00:16:23.664
أدعـى ـ(ريـبـيكا)ـ

46
00:16:28.124 --> 00:16:31.906
ـ(ريـبـيكا)ـ ، البنت الصغيرة اللتي ذَهبتْ
إلـى ـ[الـيـابـان]ـ.؟

47
00:16:34.918 --> 00:16:39.494
لـبـرهـة من الـوقـت ، ـ(تـومـي)ـ أزعـجَـنـا
برغبةِ الـذهـابِ إلـى ـ[طـوكـيو]ـ

48
00:16:41.629 --> 00:16:44.794
ثـمَ بدأ يتـناسى ذلك ، لحسـنِ حـظـه

49
00:16:48.548 --> 00:16:51.168
أيـن يُقـيمُ الآن..؟

50
00:16:51.799 --> 00:16:55.581
أتَعْرفيـنَ الـمـرفأ الصَغيرَ.؟ ، أسفلَ الجـسر

51
00:16:56.759 --> 00:16:59.593
سـتَجديـنـهُ هـنـالك

52
00:17:13.473 --> 00:17:16.093
مـرحـبـاً.؟

53
00:17:37.232 --> 00:17:41.097
مـن أنـتِ .؟ ، مـاللذي تفـعلينـهُ هـنا.؟

54
00:17:43.692 --> 00:17:47.438
أَبْحـثُ عـن ـ(تـومـاس)ـ -
مـعـكِ ـ(تـومـاس)ـ -

55
00:17:52.112 --> 00:17:54.945
مَـنْ تـكـونـيـن.؟

56
00:18:03.908 --> 00:18:06.860
مـرحـباً، ـ(تـومـي)ـ

57
00:18:18.288 --> 00:18:20.907
مـرحـباً

58
00:18:21.914 --> 00:18:24.747
مَـنْ تـكـون .؟

59
00:18:28.041 --> 00:18:30.874
كـيـف كَـانـتْ ـ[الـيـابـان]ـ.؟

60
00:18:31.626 --> 00:18:35.039
بـأحـسنِ حــال -
الطـابق إثنـانِ وسـبعـون -

61
00:18:42.000 --> 00:18:48.704
حسناً،دعنا نـتعـاملُ قـليلاً مـثل الأنـاس الطبيـعيـيـن
أدعـى ـ(روز)ـ ، هذا ـ(تـومـي)ـ ما اسمكِ.؟

62
00:18:57.051 --> 00:19:01.342
هـل سـتعـودين .؟ -
لا، حـصـلتُ على شـهـادتـي -

63
00:19:01.886 --> 00:19:04.375
ماذا دَرستِ.؟ -
الـريـاضـيـّات -

64
00:19:05.179 --> 00:19:07.668
فـي الـوقـتِ الحـالي .؟ ، مـاهـو عـمـلـك.؟

65
00:19:08.096 --> 00:19:11.298
(أُصـمّـمُ بـرامـجـاً لـ(أجـهـزةِ الـسـونـار

66
00:19:14.765 --> 00:19:18.630
أجـهـزةِ الـسـونـار)تـكشـِفُ التـصـدعـات الـصـغـيـره)
اللتـي تحـدثُ في الخـزانـات الأرضـيـه

67
00:19:23.852 --> 00:19:29.684
مـثلَ نـوعِ الخـزانـات لدى (محـطـاتِ الـبنـزين)كـمـا تعـلم
تتـصدعُ أحـيـانـاً

68
00:19:31.813 --> 00:19:34.895
مـمـتـاز

69
00:19:38.815 --> 00:19:41.767
إذاً ـ(بـنـجـو)ـ تَـرَككِ تـردفـينَ إلـى الـداخـلِ هـكذا.؟

70
00:19:42.900 --> 00:19:45.758
لـم أرهُ يـفـعـلُ هـكـذا ، فـي العــاده يـكـرهُ الغـربـاء

71
00:19:45.759 --> 00:19:47.686
خصوصاً عـندمـا عضَ فـخـذَ إمـرأه
ومـنـذُ ذلك الحـين لـم تظـهر أبـداً

72
00:19:50.820 --> 00:19:54.945
رُبـمـا أحـبَ رائحـتكِ -
رُبـمَـا -

73
00:19:59.906 --> 00:20:03.439
رُبـمـا تبـدئـا بـشـمِ بـعـضـكـمـا

74
00:20:17.412 --> 00:20:20.613
كـم من السـنـيـنَ خـلـتْ .؟

75
00:20:23.539 --> 00:20:27.866
إثـنـا عـشـرَ -
إثـنـا عـشـرَ -

76
00:20:33.293 --> 00:20:36.576
يـجـبُ عـلـيَّ أن أذهــب

77
00:21:36.189 --> 00:21:39.058
هَـلْ تعـلمُ ـ(روز)ـ بـأنك هــنـا.؟

78
00:21:41.608 --> 00:21:44.560
لا أعــلم

79
00:21:49.777 --> 00:21:51.915
هي صـديقـتُـكَ، ألـيس كــذلـك.؟

80
00:21:53.610 --> 00:21:55.142
صـديـقـتـي.؟

81
00:22:03.449 --> 00:22:07.314
قـابـلتـهـا بالأمـس لأولِ مـرةٍ فـي حيــاتـي

82
00:22:45.338 --> 00:22:48.622
كـم كـانـت المـده الـتي قـضـى فـيهـا جَـدُكِ نحـبه.؟

83
00:22:51.340 --> 00:22:54.292
زمــنٍ طــويل

84
00:22:55.925 --> 00:22:59.126
كــانَ طاعنـاً فــي الســن

85
00:23:00.635 --> 00:23:05.923
بَـدا لــي كــأنـه أكــبر في الســابق

86
00:23:11.514 --> 00:23:16.173
هـل تتـذكرْ فـي تـلكَ اللـيلة .. اللـتي قُــلتَ
بأنك تـريد وداعـي وبـأنَ فـكـرةً خـطـرت لـديـك

87
00:23:16.808 --> 00:23:20.340
ولــم تظـهـر

88
00:23:22.059 --> 00:23:25.142
مـالفـكره اللتـي كـنت تتحـدثُ عــنها ، هـل تتـذكر.؟

89
00:23:28.186 --> 00:23:31.139
إعتقدتُ بـأنـكِ لــن تــسـألـي

90
00:23:54.029 --> 00:23:57.775
أردتُ إعْـطائـه إلـيكِ ذلك الصباح

91
00:24:01.156 --> 00:24:05.945
ـ[طوكـيو]ـ سـتكونُ مغـامرةً عـظيمةً لــه

92
00:24:15.536 --> 00:24:20.195
أطعـمـتهُ لـمـدة سـنه تقـريـباً ، حقـيـقتـاً بـعـدَ أن
رحــلــتِ

93
00:24:24.289 --> 00:24:27.490
إسـتـطـاع تـدبـرَ أمـرَ أكــله وتغــوُّطه فـي نفــس
الــوقــت

94
00:24:29.166 --> 00:24:32.367
مُـؤثـرٌ ذلــك

95
00:24:33.459 --> 00:24:36.209
ثـمَ مـؤخـراً لـمْ يــبدُ عــلى مــايــرام

96
00:24:36.919 --> 00:24:40.202
فـي يـومٍ مــا تـوقـفَ عـن الظــهــور

97
00:24:43.588 --> 00:24:46.789
قــضـى نحــبه

98
00:24:50.131 --> 00:24:52.834
لـمـاذا لــم تـودعــني

99
00:24:54.550 --> 00:24:57.253
إسـتـغـرقـتُ فـي نـومـي

100
00:25:00.302 --> 00:25:03.052
لكنـي الآن مُستـيـقـظُ

101
00:25:40.190 --> 00:25:43.024
جــسمكِ بــارد

102
00:26:18.787 --> 00:26:20.525
أشـعـرُ بالغــرابــه

103
00:26:22.458 --> 00:26:24.288
أعــلمُ ذلــك

104
00:26:26.887 --> 00:26:28.451
نـعـم

105
00:27:19.475 --> 00:27:23.221
مــاذا سـتـفـعـليـنَ فـي عطـلة نـهـاية الإسـبوع.؟ -
كـالعـاده معــك -

106
00:27:24.560 --> 00:27:27.263
لا ، لا أسـتطيع

107
00:27:27.686 --> 00:27:30.436
سـأذهـبُ بـعـيـداً -
سـأذهـبُ معــك  -

108
00:27:31.396 --> 00:27:34.809
يـجـبُ أن أذهــبَ لـوحــدي ، ستكـونُ فقـط لـيومـين

109
00:27:35.730 --> 00:27:38.350
أيُّمــا تــذهــب أذهـب

110
00:27:42.399 --> 00:27:45.482
هــذا المــكان لاتســتطيعــينَ الــذهــابَ إلــيه

111
00:27:50.527 --> 00:27:53.859
إذاً لاتســتطيعَ الــذهــابَ أيضاً

112
00:28:00.656 --> 00:28:02.040
ببـسـاطـه أفـرغـوا المـستـنـقـع

113
00:28:02.041 --> 00:28:06.169
وأحضـرو عـربـةً بآلآف الأطـنان من الإسـمـنت المـسـلح
لـيفـرشوهُ مـكـانه

114
00:28:06.199 --> 00:28:08.299
وبــنو خـلال سـتة أشـهـر ، يـالـه مـن رقـمٌ قــيـاسي

115
00:28:08.300 --> 00:28:12.944
على الوثـيـقـه، مـذكورُ بأنه وسـطَ بـوادرَ حـسـنه
وأعـلنـو بـأن إسـمـها ستـكون "الحـديقـةً المـتـألـقـه"

116
00:28:13.660 --> 00:28:17.074
أربـاحـهـا ستـأتـي مـبـاشـرةً من دعـارة الإنـتـرنـت
تعــرفيــن

117
00:28:17.245 --> 00:28:21.904
بغـايـا الإنـتـرنـت، الـجـِراحة الـتـقـويـمـيـة
إستـنـسـاخ الحـيـوانـات الألـيـفـةِ

118
00:28:23.455 --> 00:28:25.326
إفتـتـحـو الأسـبـوع الـمـاضـي

119
00:28:25.574 --> 00:28:28.548
هـذه سَـتَـكُـونُ عـطـلـة نـهـايـة إسـبـوعَـهـم الأولـى
بالأحـرى عـطـلـة نـهـايـة إسـبـوعـنـا

120
00:28:28.549 --> 00:28:30.654
لأن مجموعتَنا سـتـكـونُ هـُــنــاكَ أيضاً

121
00:28:30.937 --> 00:28:31.722
الـمـجـمـوعـه..؟

122
00:28:31.941 --> 00:28:36.292
ـ[مجـموعـة غُـبار الطـلـع]ـ
مـقـاتـلـي لأجـل البـيـئـه ،، مجـمـوعـة فــدائـيـه

123
00:28:37.085 --> 00:28:41.827
مـبـنـيه عـلـى خـطـط مـؤثـره بصحـبة 23 مشـاركـاً

124
00:28:42.420 --> 00:28:45.652
عنـدمـا نـكـونُ في الـداخــل نـفـتعـل الفـوضـى وتصبح
هـسـتـيـريـا جـمـاعـيـه ، ـ(ريـبـيكا)ـ

125
00:28:45.653 --> 00:28:49.577
أقـولُ لـكِ ، هـسـتـيـريـا جـمـاعـيـه ، ذلـك سـيـُسـلـي
حـراس الآمـن

126
00:28:49.578 --> 00:28:53.394
الآن ، فـي هـذه الأثــنــاء الرجـال الآخـرينَ في الخـارج
سيـحجـبونَ المــدخـل و

127
00:28:53.395 --> 00:28:55.881
عــند مخـرج مـواقف السـيارات سنصبُ بسرعه جداراً
إسـمـنـتيـاً

128
00:28:55.883 --> 00:28:59.723
تعـرفيـنَ جداراً إسمنـتـيـاً سريعـاً .؟ ، لا ، حسناً
لاتـقـلـقـي حـيـالَ ذلـك

129
00:28:59.885 --> 00:29:04.958
عـلـى أيـة حـال ، ثـمّ وسـائـل الإعـلام تـلـعـبُ دورهـا -
كَـيـفَ سـتـفـعـل تـلـكَ الـ هـسـتـيـريـا جـمـاعـيـه .؟ -

130
00:29:24.167 --> 00:29:25.859
مـتـأهـبه.؟

131
00:29:45.692 --> 00:29:50.150
أتـريـنَ حـقـيـبـة الـظـهـر.؟ ، نحـنُ سنـطلـق مـثل هـذه
الصـراصـير فـي أسـواقـهـم

132
00:29:50.861 --> 00:29:55.069
حول البركاتِ والمطاعمِ ، نعـتـمـدُ حـقـاً على المـكـان
المـكـتض بالجـمـهـور

133
00:29:57.988 --> 00:30:00.940
"الحـديـقـه المـتـألـقـه"

134
00:30:07.533 --> 00:30:10.734
لـديّ سـتُ حـقـائـب للظـهـر

135
00:30:25.623 --> 00:30:29.369
أين تَـذْهـبُ.؟ - بـعـيـداً -
ماهـذه اللتي تحـملها .؟ -

136
00:30:30.374 --> 00:30:32.864
حـقـائـب الـظـهـر

137
00:30:33.081 --> 00:30:35.956
هَـلْ تُـريـدُ المَجيء لإحـتـسـاء القـهـوه.؟ -
لا، لا، لَيسَ الآن -

138
00:30:36.432 --> 00:30:38.187
حَسناً، والقـبله ألا يحقُ لي الحـصـول عليها منك .؟

139
00:30:56.095 --> 00:31:00.124
مـاذا .؟ -
أَحـبُّ خـطـتَـكَ هَـلْ فكّرتَ بـه لــوحــدك .؟ -

140
00:31:00.926 --> 00:31:04.459
نـعـم ، بـالـطـبـع

141
00:31:06.470 --> 00:31:07.795
مــاذا .؟

142
00:31:08.052 --> 00:31:12.504
أَنا مربي صرصورِ بسيطِ ، ـ(ريـبـيكا)ـ

143
00:31:13.723 --> 00:31:16.721
أَتمنّى بـأن ذلك يجـعلني جيــداً في نـظـرك

144
00:31:18.099 --> 00:31:21.929
كـان حـلمـي بـأن أجـتـمـع بـمـربي صـرصـور

145
00:31:46.734 --> 00:31:49.437
أريـدُ الـتـبـوّل

146
00:31:51.277 --> 00:31:54.561
إلـى أيّ حـد -
إلـى أبـعـد حـد -

147
00:34:00.864 --> 00:34:06.265
"مـهـما إسـتغـرقَ من الـوقـت ، سـأكونُ بإنـتـظـارك"

148
00:37:34.854 --> 00:37:37.520
أنـا - أنـا شهـيتي لـيست متـفتحـه للأكـل ، ـ(ريـبـيكا)ـ
الـمـعـذره

149
00:37:37.525 --> 00:37:40.036
إجـلـسـي على الأقــل

150
00:37:44.180 --> 00:37:47.024
لا أسـتـطـيـعُ الجـلـوس ، أيـضـاً

151
00:37:51.110 --> 00:37:54.275
هـلاّ أطـلعتـينا على سـبـب دعـوتكِ لـنا ، أرجوك

152
00:37:56.737 --> 00:37:59.357
بالـطـبـع

153
00:38:26.997 --> 00:38:29.700
بـإمـكــانه مرة أخـرى التــواجدُ بــيـنـنـا

154
00:38:42.128 --> 00:38:44.961
مـرة أخـرى ، مَـن  ـ(تـومـاس)ـ .؟

155
00:39:03.630 --> 00:39:06.215
جـواب قـسـم الهـنـدسـه الـوراثـيـه
"الـمـوافـقـه على الـنـبـش وأخـذ عـيـنـة مـن نـسـيج المـيـت"

156
00:39:06.970 --> 00:39:09.803
مـن سـتحمـلُ بـه .؟

157
00:39:23.684 --> 00:39:26.054
ـ(رالـف)ـ

158
00:39:33.687 --> 00:39:35.285
نـحـنُ مُـلـحـديـن

159
00:39:37.004 --> 00:39:40.311
رَبّـيـنَـا ـ(تـومـاس)ـ
كـمُـلـحـد

160
00:39:40.815 --> 00:39:46.576
ولايـعـنـي بـأن نـفـتـشَ قـبورَ مـوتـانـا ونـسـتـنـسـخـهـم

161
00:39:47.317 --> 00:39:50.399
نـحـنُ لَـسـنـا كـ حـيـوانـاتِ مـزارع

162
00:39:52.402 --> 00:39:55.484
نـرضـى بمـا قـدمـتـهُ لـنـا الحـيـاه

163
00:39:57.154 --> 00:40:00.300
وأيضاً إن تـطـلّـبَ نـسـيـان المـاضـي

164
00:40:00.301 --> 00:40:01.761
لـكـن

165
00:40:02.891 --> 00:40:04.534
لـكـن مـاذا.؟

166
00:40:11.033 --> 00:40:14.317
لـكـن الحـيـاه يـسـرت لـنـا هـذه الـفـرصـه

167
00:40:16.660 --> 00:40:19.862
هـذه الـهـديـةِ

168
00:40:24.830 --> 00:40:27.912
ألا تـريـنَ ذلـك.؟

169
00:40:38.335 --> 00:40:43.492
لـو كُـنـتُ بـمـكـانك ـ(ريـبـيكا)ـ لأعـدتُ دهـانَ الغـرفـه
بالـلـونِ الأبـيـض

170
00:40:48.852 --> 00:40:51.207
ـ(رالـف)ـ.؟

171
00:41:33.354 --> 00:41:36.187
شكراً لك

172
00:41:42.815 --> 00:41:45.565
هـل تـريدُ مـنـي الـرحـيـل.؟

173
00:41:47.358 --> 00:41:50.891
لا، إبـقـيّ

174
00:41:53.152 --> 00:41:57.811
أحبَّ الـبحرَ
سَـيُـحِـبُّـهُ ثـانـيـةً

175
00:42:00.071 --> 00:42:02.852
بالنـسـبـة لـنـا ، لايـوجـد مـايـُعـيـنـنـا على الـبـقـاء

176
00:42:03.513 --> 00:42:05.095
سـنـرحـل الإسـبـوع الـقـادم

177
00:42:06.198 --> 00:42:08.688
حسـنـاً

178
00:42:10.033 --> 00:42:12.736
شكراً لك ، ـ(رالـف)ـ

179
00:42:15.702 --> 00:42:17.044
ـ(ريـبـيكا)ـ

180
00:42:19.300 --> 00:42:21.175
أفـكـرتـي جيـداً بهـذا الأمـر

181
00:42:21.704 --> 00:42:24.987
بـإسـتـطـاعـتـك أن تـغـيري رأيـك

182
00:43:07.053 --> 00:43:09.672
شكراً لـك

183
00:46:03.030 --> 00:46:05.401
مرحـبـاً -
أهـلاً -

184
00:46:06.531 --> 00:46:09.815
كَمْ عـمـر طـفـلـكَ الـرضيـع.؟ -
ثـلاثـة شـهـورِ -

185
00:46:11.742 --> 00:46:14.694
هـل تـريـديّ بعـض الفـطـايـر .؟ -
خـبـزتـهـا بـنـفـسـي -

186
00:46:15.201 --> 00:46:18.070
شـكـراً ، لـيـسَ الأن ، يجـب أن أصـل مبكـرةً إلـى
المـنـزل

187
00:46:18.494 --> 00:46:21.908
حسـنـاً -
مـع الـسـلامـة - مـع الـسـلامـة -

188
00:46:30.081 --> 00:46:33.164
كـلُ شـيءٍ على مـايـرام ، طفـلـي الحـبـيـب

189
00:46:46.087 --> 00:46:48.837
تـغـذى ، عـزيـزي

190
00:46:52.506 --> 00:46:55.256
فـقـط نـحـنُ الإثـنـان

191
00:47:26.809 --> 00:47:29.429
ـ(تـومـي)ـ .؟

192
00:47:30.269 --> 00:47:32.743
أخـرج قـلـيـلاً، أُريـدُ إخْـبـارك بـشيءَ

193
00:47:32.744 --> 00:47:35.156
مـاهـو -
أخـرج ، عـزيـزي -

194
00:47:36.896 --> 00:47:41.685
أَعْرفُ أَعْرفُ بأنـنـي سـأذهـب إلى المـدرسـه الإبـتدائـيـه
وسـيـكـونُ يـومَ الإثـنـيـن

195
00:47:43.398 --> 00:47:47.524
نعـم سـتـذهـبُ يـوم الإثـنـيـن إلـى المـدرسـه الإبـتـدائـيـه
ولاكـن أخـرج إلـي الآن

196
00:47:48.942 --> 00:47:52.024
أسـتـطيـعُ أن أراكِ مـن هـنـا

197
00:48:00.397 --> 00:48:03.604
يجـب أن أتـحـدثَ معـك بخـصـوصِ أبـاك

198
00:48:07.990 --> 00:48:11.855
أبـاكَ مـاتَ بحـادث سـيـاره قـبـل أن تـولـد

199
00:48:16.035 --> 00:48:18.654
حقـاً -
نعـم -

200
00:48:19.536 --> 00:48:23.531
إعـتـقـدتُ بـأنـه عـادَ إلـى كـوكـبـه الأم -
كـوكـبـه الأم .؟ -

201
00:48:24.996 --> 00:48:28.742
نـعـم -
أبـاكَ  كَـانَ مِـنْ هـذا الـكـوكـبِ -

202
00:48:31.665 --> 00:48:33.221
ذلك شـيء مؤسفُ

203
00:48:33.222 --> 00:48:35.076
أصـغِ ـ(تـومـاس)ـ

204
00:48:37.000 --> 00:48:41.458
أبـاكَ حـقـيـقـيَ كـان لـه وجـود
كَـانَ طـالـبً فـي عِـلْـمِ الأحـيـاء

205
00:48:43.086 --> 00:48:45.836
وقـد صـدمـتـه سـيـارة

206
00:48:51.047 --> 00:48:53.999
هَـلْ تَـفْـهـمُ ذلـك.؟

207
00:49:34.653 --> 00:49:39.416
<i>رجـلٌ لا يـوازنُ كـلامـه فـعـلـه "
"كـحـديـقـة تحـيـطُ بهـا الأعـشـابِ الضـاره</i>

208
00:49:39.417 --> 00:49:44.316
<i>والأعـشـابُ الـضـاره عـنـدمـا تـبـدأ فـي الـنـمـو "
"كـحـديـقـة تـحـيـطُ بهـا الثـلـوج</i>

209
00:49:44.317 --> 00:49:49.313
<i>والـثـلـج عـنـدمـا يـبـدأ فـي الـسـقـوط "
"كـطـيـرٍ عـلـى الـحـائـط</i>

210
00:49:49.314 --> 00:49:54.364
<i>والـطـيـرُ عـنـدمـا يـحـلـقُ بـعـيـداً "
"كـنـسـرٍ يـكـونُ فـي الـسـمـاء</i>

211
00:49:54.366 --> 00:49:59.418
<i>والـسـمـاء عـنـدمـا تـصـخـب "
"كـ أسـدٍ عـنـد الـبـاب</i>

212
00:49:59.419 --> 00:50:04.419
<i>والـبـابُ عـنـدمـا يـبـدأ بالـتـصـدع "
"كـطعـنـةٍ عـلـى ظـهـرِكَ</i>

213
00:50:04.420 --> 00:50:09.655
<i>والـظـهـرُ عـنـدمـا يُـشـعـركَ بالألـم "
"كـ سـكـيـنٍ غُـرزَ بـقـلـبـك</i>

214
00:50:09.656 --> 00:50:17.031
<i>والـقـلـبُ عـنـدمـا يـبـدأ بالـنـزيـف "
"أنـت مـيـت، ومـيـت، ومـيـتٌ فـي الـحـقـيـقـة</i>

215
00:50:46.212 --> 00:50:49.413
أَسـتـمـرُّ بـالـمَـوت

216
00:50:51.297 --> 00:50:54.249
حــاولْ ثـانـيـةً

217
00:51:27.267 --> 00:51:30.101
أمــي .؟

218
00:51:36.729 --> 00:51:40.012
ـ(إيـريـك)ـ سـتـمـكـثُ الـلّـيـلـة

219
00:51:42.481 --> 00:51:45.101
مرحـبـاً

220
00:51:47.358 --> 00:51:50.559
هـلّ تـريـدونَ أن أُحـضـرَ لـكـم شـيـئـاً

221
00:52:06.448 --> 00:52:09.530
مـرحـبـاً، أمّـي
إنـظـرْي إلـى ذلـك الأرنـبِ الـصَـغـيـرِ

222
00:52:11.699 --> 00:52:14.983
جـمـيـل ، مـا اسـمـكِ.؟

223
00:52:15.993 --> 00:52:18.696
أدعـى ـ(ديـمــا)ـ ، وهـذا
إسـمـه ـ[فـلـيـك]ـ

224
00:52:19.536 --> 00:52:23.400
ـ[الـثـلـجـي، فـلـيـك]ـ أو فـقـط ـ[فـلـيـك]ـ -
فـقـط ـ[فـلـيـك]ـ -

225
00:52:40.918 --> 00:52:44.783
حَـسـنـاً ، نـحـنُ سـنـغـادر ، إلـى اللـقــاء
أراكَ قـريـبـاً ـ(تـومـي)ـ

226
00:52:52.297 --> 00:52:55.331
ألا تـحـبـيـنَ الـقـدوم إلـى مـنـزلـنـا واللـعـبَ ـ(ديـمــا)ـ

227
00:52:57.799 --> 00:53:00.632
لا، شـكـراً لـكِ

228
00:53:07.552 --> 00:53:10.931
لـم أشـمَّ ذلـك ، مـاذا عـنـكِ -
أنـا اسـتـطـعـتُ شـمـهـا -

229
00:53:10.932 --> 00:53:11.975
شـمـمّـت مـاذا .؟

230
00:53:11.804 --> 00:53:14.637
رائـحـة الـنـسـخـة -
مـاذا .؟ -

231
00:53:15.305 --> 00:53:18.008
النـُسـخْ لـديـهـا رائـحـة غـريـبـه ، رائـحـة الـنـسـخـة

232
00:53:18.806 --> 00:53:23.012
أيـن سَـمـعـتَ ذلـك.؟
أمـي ، الكـل يعـرفُ ذلـك -

233
00:53:23.016 --> 00:53:27.591
رائـحـتـهـم مـثـل مـنـظـف الـنـوافـذ ، تـأتـي مـن
الـجـلّـد

234
00:53:42.731 --> 00:53:45.434
لـذا.؟

235
00:53:54.527 --> 00:53:58.059
تـقـول ـ(إيـريـك)ـ بـأنكِ دعـوتـي الـصـغـيـره
ـ(ديـمــا)ـ إلـى مـنـزلـكـم

236
00:53:59.528 --> 00:54:01.899
نـعـم ، لـمـاذا .؟

237
00:54:04.947 --> 00:54:10.367
أنـظـري ، ـ(ريـبـيكا)ـ ، لـيـسـت لـديـنـا مـشـكلـه
بالتـواصـل الـبـشـري

238
00:54:10.368 --> 00:54:13.344
نـعـتـقـدُ بـأن بـعـض المجـمـوعـات الـمـهـجـنـه مـن
نـفـس الـفـصـيـلـة مـحـتـرمـيـن ومـهـذبـيـن

239
00:54:13.345 --> 00:54:15.530
لـديـهـم حـيـاتُـهـم الـخـاصـةُ وحـقـوقُـهـم

240
00:54:15.826 --> 00:54:20.035
الـمـغـزى بـأن هـذا مـعـقـد لأبـنـائـنـا

241
00:54:22.203 --> 00:54:26.413
نـسـمـعُـه الآن دائـمـاً يُـذكـر فـي نـشـرات الأخـبـار
لاكـن بـصـراحـةٍ شـديـده

242
