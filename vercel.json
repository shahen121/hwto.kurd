{
  "version": 2,
  "functions": {
    "api/proxy.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/fastvid",
      "destination": "/api/fastvid"
    },
    {
      "source": "/api/scraper",
      "destination": "/api/scraper"
    },
    {
      "source": "/api/vidsrc-extractor",
      "destination": "/api/vidsrc-extractor"
    },
    {
      "source": "/api/shahid4u-extractor",
      "destination": "/api/shahid4u-extractor"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
