314
00:35:13.768 --> 00:35:15.729
.سأذهب إذاً إليها

315
00:35:17.008 --> 00:35:19.131
.في أمان الله -
.في أمان الله -

316
00:36:16.641 --> 00:36:18.075
."ميسم"

317
00:36:26.760 --> 00:36:28.069
."ميسم"

318
00:37:14.665 --> 00:37:15.993
.مرحباً

319
