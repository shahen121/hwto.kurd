Dialogue: 0,0:00:04.00,0:00:42.19,Default,,0,0,0,,{\b1\c&HFF8000&} Dmx.4 {\c} تـرجـمـة\N\NTwitter : {\c&HFF8000&} @Dmx_4i {\c}
Dialogue: 0,0:00:43.00,0:00:46.00,Default,,0,0,0,,"عام "1964
Dialogue: 0,0:03:41.68,0:03:44.65,Default,,0,0,0,,تحدث يا غُلام قبل أن
Dialogue: 0,0:03:46.45,0:03:50.29,Default,,0,0,0,,هناك ثلاثة منهم, رجُلَان اثنان
Dialogue: 0,0:03:50.29,0:03:51.69,Default,,0,0,0,,والذي بالداخل؟
Dialogue: 0,0:03:52.82,0:03:54.72,Default,,0,0,0,,امرأة بيضاء كبيرة بالسن
Dialogue: 0,0:03:57.80,0:03:59.86,Default,,0,0,0,,أمتأكد ؟
Dialogue: 0,0:04:01.93,0:04:03.90,Default,,0,0,0,,لكن لديها بندقية
Dialogue: 0,0:04:04.90,0:04:06.50,Default,,0,0,0,,..حسنًا
Dialogue: 0,0:04:07.64,0:04:10.44,Default,,0,0,0,,حاولوا ألّا تبللوا ثيابكم
Dialogue: 0,0:04:15.98,0:04:17.65,Default,,0,0,0,,
Dialogue: 0,0:04:20.92,0:04:22.95,Default,,0,0,0,,
Dialogue: 0,0:04:22.95,0:04:25.89,Default,,0,0,0,,
Dialogue: 0,0:04:25.89,0:04:27.76,Default,,0,0,0,,
Dialogue: 0,0:04:34.77,0:04:37.40,Default,,0,0,0,,"انهضي"
Dialogue: 0,0:04:37.40,0:04:40.60,Default,,0,0,0,,
Dialogue: 0,0:04:40.61,0:04:42.97,Default,,0,0,0,,المال هو السبب في ذلك
Dialogue: 0,0:05:38.73,0:05:42.87,Default,,0,0,0,,$ذلك الأسود قيمته 600\Nوأنت لا تُساوي شئ
Dialogue: 0,0:05:44.50,0:05:46.80,Default,,0,0,0,,أنت مدين لذلك الغُلام بإعتذار
Dialogue: 0,0:05:46.81,0:05:49.74,Default,,0,0,0,,..أنا آسف, (بوريل) لـ
Dialogue: 0,0:05:49.74,0:05:51.44,Default,,0,0,0,,لا تعتذر لي
Dialogue: 0,0:05:57.35,0:05:58.95,Default,,0,0,0,,أنا أعتذر
Dialogue: 0,0:06:03.59,0:06:06.96,Default,,0,0,0,,هذه المُقتنيات التائهة ستُحمى حتى العودة
Dialogue: 0,0:07:12.49,0:07:15.16,Default,,0,0,0,,,لديّ ثلاث لفائف\Nادفع مُسبقًا
Dialogue: 0,0:07:15.16,0:07:17.09,Default,,0,0,0,,المرة السابقة لم تدفع لي
Dialogue: 0,0:07:33.88,0:07:36.18,Default,,0,0,0,,تأكد أنّ عمّك يُقاسم المال
Dialogue: 0,0:07:52.76,0:07:54.53,Default,,0,0,0,,!لن تشكرني
Dialogue: 0,0:07:56.17,0:07:57.87,Default,,0,0,0,,(شكرًا لك (ماركوس
Dialogue: 0,0:07:59.60,0:08:02.54,Default,,0,0,0,,لا داعي لعدّهن يا غُلام
Dialogue: 0,0:08:02.54,0:08:05.51,Default,,0,0,0,,لا أمدك بالمعونة حينما لا أحد يقدّم ؟
Dialogue: 0,0:08:05.51,0:08:07.81,Default,,0,0,0,,أنت مُرحب بأن تعتني بنفسك
Dialogue: 0,0:08:12.95,0:08:15.65,Default,,0,0,0,,اذهب الآن, أطعم أولائك السود
Dialogue: 0,0:08:15.65,0:08:17.72,Default,,0,0,0,,حان دورك
Dialogue: 0,0:08:40.74,0:08:42.25,Default,,0,0,0,,أنتم عُطاشى؟
Dialogue: 0,0:08:57.73,0:08:59.30,Default,,0,0,0,,لديّ شئ لك
Dialogue: 0,0:09:00.96,0:09:04.20,Default,,0,0,0,,اسم الرجل الذي تبحث عنه\N(هو (نيت
Dialogue: 0,0:09:07.54,0:09:10.61,Default,,0,0,0,,"يقوم بحفر القبور للفيدراليون بالقرب من "بطرسبورغ
Dialogue: 0,0:09:12.24,0:09:14.61,Default,,0,0,0,,يبعد مسيرة ثلاث إلى أربع\Nليالٍ سيرًا بالأقدام
Dialogue: 0,0:09:16.61,0:09:19.05,Default,,0,0,0,,لا أظن أنني مُرحب بأي مكان بالجوار
Dialogue: 0,0:09:22.05,0:09:24.89,Default,,0,0,0,,وتعتقد أن الأسود ذاك سيعود\Nبكل حفاوة للشمال؟
Dialogue: 0,0:09:27.79,0:09:31.59,Default,,0,0,0,,لقد دفنوا أخوهُ قبل أقل من شهرين\N"في بلدة "ليسفيل
Dialogue: 0,0:09:32.66,0:09:34.63,Default,,0,0,0,,لم تصل الأخبار له بالشمال
Dialogue: 0,0:09:37.17,0:09:39.10,Default,,0,0,0,,ستفكّر بطريقة ما
Dialogue: 0,0:09:47.64,0:09:49.78,Default,,0,0,0,,ماذا عن 50$ ثمنًا للغُلام
Dialogue: 0,0:09:51.65,0:09:53.88,Default,,0,0,0,,في حالة أنني لم أنجح بالعودة
Dialogue: 0,0:09:53.89,0:09:57.62,Default,,0,0,0,,وحتى لو عدت, سيكون مُلكك
Dialogue: 0,0:09:58.69,0:10:01.29,Default,,0,0,0,,يستطيع الطبخ, الإعتناء بالأحصنة
Dialogue: 0,0:10:01.29,0:10:03.66,Default,,0,0,0,,أبقِ الغُلام برفقتك
Dialogue: 0,0:10:03.66,0:10:05.70,Default,,0,0,0,,قد تحتاج له
Dialogue: 0,0:10:05.70,0:10:09.20,Default,,0,0,0,,بالإضافة, إذا نجحت فستحتاج للمساعدة\Nفي حمل الكم الهائل من الذهب
Dialogue: 0,0:10:26.22,0:10:28.68,Default,,0,0,0,,هناك العديد من البلدان\Nبين هنا وهناك
Dialogue: 0,0:10:31.62,0:10:34.36,Default,,0,0,0,,وفي شمال وجنوب أي منطقة
Dialogue: 0,0:10:36.66,0:10:38.16,Default,,0,0,0,,والغرب كذلك
Dialogue: 0,0:10:41.16,0:10:46.24,Default,,0,0,0,,,لو أراد الرجل ألّا يتم إيجاده\Nهنالك العديد من الماكن للذهاب لها
Dialogue: 0,0:10:49.27,0:10:51.37,Default,,0,0,0,,إلى أين ما يمكنك الذهاب
Dialogue: 0,0:10:57.68,0:10:59.12,Default,,0,0,0,,لا يهم
Dialogue: 0,0:11:02.72,0:11:06.76,Default,,0,0,0,,..إذا لم تُعِد ذلك الأسود كما أقول حرفيًا
Dialogue: 0,0:11:06.76,0:11:09.29,Default,,0,0,0,,فسأجدك وأقتلك
Dialogue: 0,0:11:09.29,0:11:11.79,Default,,0,0,0,,..بجانب الفتى
Dialogue: 0,0:11:11.80,0:11:14.00,Default,,0,0,0,,وكل من تعرفهم قط
Dialogue: 0,0:12:06.32,0:12:07.92,Default,,0,0,0,,استيقظ
Dialogue: 0,0:12:30.41,0:12:32.88,Default,,0,0,0,,لم نتحمّل عناء السفر لمكان\Nبعيد من أجل فارّ واحد؟
Dialogue: 0,0:12:32.88,0:12:35.88,Default,,0,0,0,,أستطيع تركك هنا إلّم يعجبك الأمر
Dialogue: 0,0:12:35.88,0:12:37.85,Default,,0,0,0,,فلن يختلف الأمر بدونك
Dialogue: 0,0:12:42.05,0:12:43.95,Default,,0,0,0,,..لم لا نهـ -\Nالمال هو السبب -
Dialogue: 0,0:12:45.96,0:12:48.79,Default,,0,0,0,,وهذا الرجل يستحق أكثر\Nمن ثلاثة منهم جميعًا
Dialogue: 0,0:12:53.13,0:12:54.83,Default,,0,0,0,,سأقبل بهذا
Dialogue: 0,0:13:18.99,0:13:21.06,Default,,0,0,0,,من تعتقد كان يقطُن هنا؟
Dialogue: 0,0:13:21.06,0:13:23.39,Default,,0,0,0,,اصمت وابقَ منصتًا
Dialogue: 0,0:13:23.39,0:13:26.36,Default,,0,0,0,,عندما نعود وهو بحوزتنا,\Nفسنبقى آخر ليلة
Dialogue: 0,0:13:33.84,0:13:37.34,Default,,0,0,0,,عندما نعود وهو بحوزتنا,\Nفسنبقى آخر ليلة هنا
Dialogue: 0,0:13:37.34,0:13:40.31,Default,,0,0,0,,(وعندما تستيقظ, فستجلب (فوريل\Nقبل أن يستيقظ رهينتنا
Dialogue: 0,0:13:40.31,0:13:42.88,Default,,0,0,0,,ليسوا بعددين عنّا
Dialogue: 0,0:13:42.88,0:13:46.18,Default,,0,0,0,,ولا اود منك التحدث عن معرفتك\Nلهذا المكان أو من هذا القبيل
Dialogue: 0,0:13:46.18,0:13:47.82,Default,,0,0,0,,واضح؟
Dialogue: 0,0:13:48.52,0:13:50.52,Default,,0,0,0,,رائع, اذهب
Dialogue: 0,0:14:01.97,0:14:06.20,Default,,0,0,0,,انزل على الأرض, انبطح هناك -\Nماذا؟ -
Dialogue: 0,0:14:06.20,0:14:09.04,Default,,0,0,0,,يا غُلام انبطح أرضًا وكأنك نائم
Dialogue: 0,0:14:12.98,0:14:14.91,Default,,0,0,0,,والآن انهض واخرج من ذلك الباب
Dialogue: 0,0:14:20.98,0:14:22.92,Default,,0,0,0,,حتّى لا أستطيع سماعك
Dialogue: 0,0:14:44.17,0:14:45.61,Default,,0,0,0,,مجددًا
Dialogue: 0,0:14:50.88,0:14:54.58,Default,,0,0,0,,لست نائمًا, لذا ستسمع كل شئ
Dialogue: 0,0:14:54.59,0:14:56.32,Default,,0,0,0,,تبًا يا غُلام
Dialogue: 0,0:14:58.99,0:15:00.39,Default,,0,0,0,,مجددًا
Dialogue: 0,0:15:43.53,0:15:46.97,Default,,0,0,0,,إذا ما كان بحوزته سكينة, فعلينا\Nأخذها بينما هو نائمًا
Dialogue: 0,0:15:48.24,0:15:50.34,Default,,0,0,0,,الأمر ليس كالهروب خِلسة بتلك الليلة
Dialogue: 0,0:15:50.34,0:15:52.70,Default,,0,0,0,,عندما كانوا خائفين ولا مكان لهم للذهاب إليه
Dialogue: 0,0:15:53.61,0:15:56.05,Default,,0,0,0,,هذا الرجل حالة مُغايرة
Dialogue: 0,0:17:57.67,0:17:59.40,Default,,0,0,0,,اذهب الآن
Dialogue: 0,0:18:09.58,0:18:11.25,Default,,0,0,0,,اسمك (نيت) يا سيّدي؟
Dialogue: 0,0:18:17.79,0:18:19.56,Default,,0,0,0,,..أنا (ويل) من
Dialogue: 0,0:18:22.63,0:18:24.69,Default,,0,0,0,,(هذا عمّي (ماركوس
Dialogue: 0,0:18:24.70,0:18:26.40,Default,,0,0,0,,"بالقرب من "ليسفيل
Dialogue: 0,0:18:30.17,0:18:33.24,Default,,0,0,0,,أتينا بسبب أخاك, (سامويل)؟
Dialogue: 0,0:18:34.10,0:18:35.80,Default,,0,0,0,,"أصابه مرض "السُل
Dialogue: 0,0:18:35.81,0:18:38.27,Default,,0,0,0,,هو ليس بصحة جيدة
Dialogue: 0,0:18:38.28,0:18:40.18,Default,,0,0,0,,الأخبار تقول أنه لن يصمد طويلًا
Dialogue: 0,0:18:41.31,0:18:43.78,Default,,0,0,0,,لا أستطيع العودة لهناك
Dialogue: 0,0:18:43.78,0:18:46.18,Default,,0,0,0,,..يقول اخاك
Dialogue: 0,0:18:47.32,0:18:50.22,Default,,0,0,0,,يريد أن يراك قبل الموت
Dialogue: 0,0:18:50.22,0:18:52.86,Default,,0,0,0,,طلب منّا أن نخبرك ذلك -\Nكيف وجدتني؟ -
Dialogue: 0,0:18:54.79,0:18:57.23,Default,,0,0,0,,سمع أخاك أنّك هنا, لا أعلم كيف
Dialogue: 0,0:18:58.16,0:19:00.50,Default,,0,0,0,,متى حدث الأمر؟
Dialogue: 0,0:19:00.50,0:19:02.30,Default,,0,0,0,,قبل ثلاث أيام
Dialogue: 0,0:19:02.30,0:19:06.20,Default,,0,0,0,,وأنت عانَيت على نفسك\Nلأن توصل الأخبار إلي؟
Dialogue: 0,0:19:06.20,0:19:10.81,Default,,0,0,0,,سيده (بريتشارد) أمرنا بذلك\Nوسيتم مكافئتنا
Dialogue: 0,0:19:12.34,0:19:14.61,Default,,0,0,0,,,قال أنه لن يصمد طويلًا\Nأراد أن يراك وحسب
Dialogue: 0,0:19:23.59,0:19:25.59,Default,,0,0,0,,هل علينا أن نخبرك أخاك شيئًا؟
Dialogue: 0,0:19:27.26,0:19:29.22,Default,,0,0,0,,عن سبب عدم عودتك لأجله؟
Dialogue: 0,0:19:38.87,0:19:40.57,Default,,0,0,0,,أنتم من (ليسفيل)؟
Dialogue: 0,0:19:41.70,0:19:44.71,Default,,0,0,0,,أهو في حالة سيئة؟
Dialogue: 0,0:19:47.68,0:19:49.81,Default,,0,0,0,,سأرى الأمر حينما آتي
Dialogue: 0,0:19:49.81,0:19:52.61,Default,,0,0,0,,علينا العودة جميعًا
Dialogue: 0,0:19:52.62,0:19:55.65,Default,,0,0,0,,هلّا نعود من سفرنا برفقتك؟
Dialogue: 0,0:19:55.65,0:19:58.62,Default,,0,0,0,,أنتما الإثنان أتيتم لهنا\Nاعتمادًا على نفسكم فقط؟
Dialogue: 0,0:19:58.62,0:20:02.29,Default,,0,0,0,,إذًا, أعتقد أنكما تستطيعوا العودة\Nاعتمادًا على أنفسكم
Dialogue: 0,0:20:03.43,0:20:05.56,Default,,0,0,0,,لن نكون ذو إزعاج
Dialogue: 0,0:20:05.56,0:20:08.60,Default,,0,0,0,,بالإضافة, أتينا طوال الطريق لأجلك
Dialogue: 0,0:20:10.80,0:20:12.73,Default,,0,0,0,,سنغادر قبل شروق الشمس
Dialogue: 0,0:20:13.80,0:20:15.74,Default,,0,0,0,,وسنبقى بعيدًا عن الطُرقات
Dialogue: 0,0:20:17.34,0:20:19.34,Default,,0,0,0,,لا يمكني أن أكون مسؤول\Nقانوني عن أطفال حمقى
Dialogue: 0,0:20:21.71,0:20:23.55,Default,,0,0,0,,الآن, اذهبا
Dialogue: 0,0:20:43.37,0:20:45.87,Default,,0,0,0,,تود نصيحتي, سنتمكن من الوصول\N..في غضون ثلاث أيام إذا توجهنا
Dialogue: 0,0:20:45.87,0:20:47.54,Default,,0,0,0,,لا أودّ نصيحتك
Dialogue: 0,0:20:49.41,0:20:52.51,Default,,0,0,0,,تحتاج لنصيحتي أيها النذل المشاكس
Dialogue: 0,0:20:54.71,0:20:57.88,Default,,0,0,0,,أسبق وأن توجهت لذلك الطريق؟
Dialogue: 0,0:20:57.88,0:20:59.48,Default,,0,0,0,,صحيح
Dialogue: 0,0:21:00.65,0:21:02.95,Default,,0,0,0,,اسلك الدرب الذي تبتغيه
Dialogue: 0,0:21:12.40,0:21:15.00,Default,,0,0,0,,ماركوس) يعلم الطريق الأفضل)
Dialogue: 0,0:21:15.00,0:21:17.03,Default,,0,0,0,,لا عليك من القلق
Dialogue: 0,0:21:29.85,0:21:31.81,Default,,0,0,0,,أسبق ورأيت مِدفعًا يُطلق؟
Dialogue: 0,0:21:33.05,0:21:35.38,Default,,0,0,0,,سمعتهم عدة مرات
Dialogue: 0,0:21:35.39,0:21:37.35,Default,,0,0,0,,لكن لم أرى واحدًا
Dialogue: 0,0:21:42.99,0:21:46.46,Default,,0,0,0,,..لم تعتقـ -\Nألم تخبرك أمّك أن تصمت وتُنصت بعض الأحيان؟ -
Dialogue: 0,0:21:47.36,0:21:49.33,Default,,0,0,0,,لم أعلم أمي قط
Dialogue: 0,0:21:53.47,0:21:55.74,Default,,0,0,0,,كم مضى منذ أن هربت شمالًا؟
Dialogue: 0,0:21:58.64,0:22:00.84,Default,,0,0,0,,لست هاربًا
Dialogue: 0,0:22:24.87,0:22:27.10,Default,,0,0,0,,هذا حِملُ كثير عليك يا غُلام
Dialogue: 0,0:22:28.74,0:22:30.87,Default,,0,0,0,,أبي أعطاني هذا
Dialogue: 0,0:22:30.87,0:22:33.68,Default,,0,0,0,,لا أكترث من أعطاه لك
Dialogue: 0,0:22:33.68,0:22:36.51,Default,,0,0,0,,لن أنفقه حتّى أراه لاحقًا
Dialogue: 0,0:22:45.62,0:22:48.82,Default,,0,0,0,,استمر في فركِ هذا الشئ
Dialogue: 0,0:22:48.83,0:22:51.73,Default,,0,0,0,,اجعله ساطعًا
Dialogue: 0,0:22:51.73,0:22:55.53,Default,,0,0,0,,افركه بنصف الجودة التي كنت\Nتفرك بها عُضوك الليلة الماضية
Dialogue: 0,0:22:55.53,0:22:57.87,Default,,0,0,0,,وسيكون ساطعًا نظيفًا
Dialogue: 0,0:22:57.87,0:23:01.54,Default,,0,0,0,,قد يُعمي الرجل من سطاعته -\Nهو كاذب -
Dialogue: 0,0:23:01.54,0:23:05.44,Default,,0,0,0,,قام بفرك العُملة النقدية التي بحوزته\Nحتّى غدَت ناعمة
Dialogue: 0,0:23:05.44,0:23:07.71,Default,,0,0,0,,على الأقل أنه جيّد في عمل شئ
Dialogue: 0,0:23:07.71,0:23:09.85,Default,,0,0,0,,كنت محترفًا في عُمره
Dialogue: 0,0:24:15.21,0:24:17.15,Default,,0,0,0,,علِقوا على ظهرك
Dialogue: 0,0:24:26.72,0:24:28.66,Default,,0,0,0,,لم يعلِقوا هكذا؟
Dialogue: 0,0:24:30.66,0:24:32.69,Default,,0,0,0,,لا تخدم أيّ هدف
Dialogue: 0,0:24:32.70,0:24:35.46,Default,,0,0,0,,إنها بذرة
Dialogue: 0,0:24:35.47,0:24:37.80,Default,,0,0,0,,حتى يستطيعوا السفر أكثر ممّا يستطيعوا
Dialogue: 0,0:24:43.61,0:24:45.57,Default,,0,0,0,,..لكن لم -\Nيرتدونني يا غُلام -
Dialogue: 0,0:24:46.64,0:24:48.58,Default,,0,0,0,,..أودّ أن -\N!!اصمت -
Dialogue: 0,0:24:51.72,0:24:53.48,Default,,0,0,0,,أتسمع ذلك؟
Dialogue: 0,0:24:57.12,0:24:58.95,Default,,0,0,0,,كلّا, كيف يكون صوته؟ -\Nابق منصتًا -
Dialogue: 0,0:24:59.89,0:25:01.26,Default,,0,0,0,,أنصت بهدوء تام
Dialogue: 0,0:25:08.73,0:25:10.23,Default,,0,0,0,,أكان ذلك ؟\Nاصمت-
Dialogue: 0,0:25:24.85,0:25:27.82,Default,,0,0,0,,لم نأخذه لـ(بوريل) إذا لم يكن هاربًا؟
Dialogue: 0,0:25:27.82,0:25:29.25,Default,,0,0,0,,ماذا؟
Dialogue: 0,0:25:31.05,0:25:33.19,Default,,0,0,0,,هو مَدين لـ(بوريل) بالمال
Dialogue: 0,0:25:33.19,0:25:35.62,Default,,0,0,0,,وربما قد يعذبوه ليحصلوا على المال
Dialogue: 0,0:25:35.63,0:25:37.53,Default,,0,0,0,,توقف عن مُعاملته بلطف
Dialogue: 0,0:25:40.56,0:25:44.80,Default,,0,0,0,,ربما قد يدفع, لذا لا داعي للتعذيب
Dialogue: 0,0:25:44.80,0:25:46.74,Default,,0,0,0,,هو من قام بالخِيار
Dialogue: 0,0:25:49.81,0:25:51.87,Default,,0,0,0,,ولا تنسى ما قمت بتعليمك
Dialogue: 0,0:25:53.68,0:25:55.98,Default,,0,0,0,,الليلة, تقوم بالهروب خلسة
Dialogue: 0,0:25:55.98,0:25:57.65,Default,,0,0,0,,لنرى كيف يكون شدّة نومِه
Dialogue: 0,0:26:17.30,0:26:19.63,Default,,0,0,0,,يا غلام, من الأفضل أن تنهض\Nوتجلب المزيد
Dialogue: 0,0:26:38.19,0:26:40.19,Default,,0,0,0,,نأكل أسناننا من الجوع هنا
Dialogue: 0,0:26:41.79,0:26:43.83,Default,,0,0,0,,هل أكل الأسوَد لحمه؟
Dialogue: 0,0:26:48.70,0:26:51.07,Default,,0,0,0,,يستطيع الرجل مُشاركة حصته
Dialogue: 0,0:26:52.17,0:26:53.67,Default,,0,0,0,,أنت محق
Dialogue: 0,0:27:32.01,0:27:34.11,Default,,0,0,0,,كيف يكون الأمر وأنت تحفر للفيدراليون؟
Dialogue: 0,0:27:38.35,0:27:41.12,Default,,0,0,0,,لا يبدوا الأمر مختلفًا\Nعن الحفر لسيدّ بالشمال
Dialogue: 0,0:27:42.42,0:27:44.99,Default,,0,0,0,,أسبق ورأيتي أطلب الإذن من الرجل للمغادرة؟
Dialogue: 0,0:27:46.92,0:27:48.96,Default,,0,0,0,,تعمل بجهد, ستعتمد على نفسك حينها
Dialogue: 0,0:27:50.89,0:27:53.73,Default,,0,0,0,,لا تحتاج لأحد, ولا أحد يحتاج لك
Dialogue: 0,0:27:58.13,0:28:00.14,Default,,0,0,0,,أنا و(ماركوس) نعتني بأحدنا الآخر
Dialogue: 0,0:28:02.10,0:28:05.37,Default,,0,0,0,,منذ أن قام الجيش بإحراق مزرعة السيّد
Dialogue: 0,0:28:05.38,0:28:08.14,Default,,0,0,0,,نعمل ما يجب للعيش
Dialogue: 0,0:28:10.15,0:28:12.41,Default,,0,0,0,,نحن عائلة
Dialogue: 0,0:28:14.72,0:28:17.09,Default,,0,0,0,,علمت أمي لفترة ساعتين
Dialogue: 0,0:28:18.32,0:28:20.72,Default,,0,0,0,,وابي كان حقيرًا
Dialogue: 0,0:28:22.36,0:28:25.09,Default,,0,0,0,,أبي ذهب للشمال قبل سنتين
Dialogue: 0,0:28:25.10,0:28:27.16,Default,,0,0,0,,لكنّه سيعود لأجلي
Dialogue: 0,0:28:27.16,0:28:29.43,Default,,0,0,0,,يا غُلام, هذا هُراء وأنت تعلم ذلك
Dialogue: 0,0:28:29.43,0:28:31.70,Default,,0,0,0,,..أن يعود من الشمال للجنوب من أجلك
Dialogue: 0,0:28:31.70,0:28:34.47,Default,,0,0,0,,هو آخر شئ على بال ذلك الرجُل
Dialogue: 0,0:28:34.47,0:28:36.97,Default,,0,0,0,,ابق صامتًا ودع الأسود ينام
Dialogue: 0,0:30:04.43,0:30:06.33,Default,,0,0,0,,إلى أين انت ذاهب؟
Dialogue: 0,0:30:11.43,0:30:13.40,Default,,0,0,0,,عليّ قضاء حاجتي
Dialogue: 0,0:30:15.81,0:30:18.17,Default,,0,0,0,,إذن اذهب هناك
Dialogue: 0,0:30:18.18,0:30:21.88,Default,,0,0,0,,لا يمكنك البقاء لوحدك على بعدٍ من هنا
Dialogue: 0,0:30:28.92,0:30:30.32,Default,,0,0,0,,!حسنًا
Dialogue: 0,0:30:32.09,0:30:34.59,Default,,0,0,0,,لا يمكنني القضاء وأنت تراقبني
Dialogue: 0,0:30:34.59,0:30:37.99,Default,,0,0,0,,تبًا يا غُلام
Dialogue: 0,0:31:33.55,0:31:35.52,Default,,0,0,0,,تمهّل
Dialogue: 0,0:31:35.52,0:31:38.29,Default,,0,0,0,,إلى أين أنت ذاهب؟
Dialogue: 0,0:31:38.29,0:31:41.46,Default,,0,0,0,,تمهّل -\Nلقد سرقت بعضًا من لحمي المُملح -
Dialogue: 0,0:31:41.46,0:31:44.49,Default,,0,0,0,,سأسلك دربي من هنا -\Nيا رجل لم أأكل طعامك -
Dialogue: 0,0:31:44.49,0:31:47.26,Default,,0,0,0,,علمت أنّك سارق
Dialogue: 0,0:31:47.26,0:31:49.56,Default,,0,0,0,,لا تعلم شيئًا
Dialogue: 0,0:31:51.03,0:31:52.93,Default,,0,0,0,,تعتقد أنني سرقت ذلك؟
Dialogue: 0,0:31:53.57,0:31:55.50,Default,,0,0,0,,لم؟
Dialogue: 0,0:31:55.51,0:31:59.07,Default,,0,0,0,,أتشمّه على ريح نَفَسي؟
Dialogue: 0,0:32:00.11,0:32:01.51,Default,,0,0,0,,
Dialogue: 0,0:32:06.32,0:32:08.15,Default,,0,0,0,,أتشمه على رائحة نَفَسي؟
Dialogue: 0,0:32:11.39,0:32:15.12,Default,,0,0,0,,بحقك أيها الأسود, ألقنّي درسًا
Dialogue: 0,0:32:16.19,0:32:18.66,Default,,0,0,0,,انتظرني الآن
Dialogue: 0,0:32:18.66,0:32:20.96,Default,,0,0,0,,هيا يا غُلام, احزم الحقائب لنذهب
Dialogue: 0,0:33:24.09,0:33:27.63,Default,,0,0,0,,خذ ماءً لو أحتجت, فالبقية يعودُ لأقاربهم
Dialogue: 0,0:33:31.47,0:33:34.14,Default,,0,0,0,,تبًا, يالك من أسود متغطرس
Dialogue: 0,0:33:34.14,0:33:37.67,Default,,0,0,0,,أن تكون عبدًا للأمّة\Nفما أنت إلّا عبد
Dialogue: 0,0:33:37.67,0:33:41.34,Default,,0,0,0,,هو ليس كباقي الرجال -\Nنعم -
Dialogue: 0,0:33:41.34,0:33:45.15,Default,,0,0,0,,فهو يستحق قيمة أكثر, فلا تنسى ذلك
Dialogue: 0,0:33:45.15,0:33:47.18,Default,,0,0,0,,ماذا لو كُنت مكانه؟
Dialogue: 0,0:33:48.08,0:33:49.58,Default,,0,0,0,,لست مكانه
Dialogue: 0,0:33:55.26,0:33:56.76,Default,,0,0,0,,انظر إليّ يا غلام
Dialogue: 0,0:33:58.26,0:33:59.63,Default,,0,0,0,,أنظر إليّ
Dialogue: 0,0:34:02.77,0:34:05.23,Default,,0,0,0,,أتود أن تعود لبيع التبغ\Nمقابل الفِلس القليل؟
Dialogue: 0,0:34:07.14,0:34:09.10,Default,,0,0,0,,,لا تودّ
Dialogue: 0,0:34:09.11,0:34:11.61,Default,,0,0,0,,تستطيع العيش فقيرًا لبقية حياتك
Dialogue: 0,0:34:12.67,0:34:14.28,Default,,0,0,0,,..أو
Dialogue: 0,0:34:15.51,0:34:17.48,Default,,0,0,0,,تستطيع جنيَ بعض المال
Dialogue: 0,0:34:19.28,0:34:21.52,Default,,0,0,0,,قد يكون كافٍ لإيجاد اباك
Dialogue: 0,0:35:28.42,0:35:30.79,Default,,0,0,0,,اجلس يا غُلام
Dialogue: 0,0:35:30.79,0:35:33.59,Default,,0,0,0,,عندما كُنت بعمرك, كنت أتسلق\Nهكذا شجرة وكسرت ساقي
Dialogue: 0,0:35:35.76,0:35:37.33,Default,,0,0,0,,كيف هي الآن؟
Dialogue: 0,0:35:38.46,0:35:40.63,Default,,0,0,0,,بخير
Dialogue: 0,0:35:40.63,0:35:44.20,Default,,0,0,0,,إذا لم يكن هنالك مشكلة, فسأستمر بالتسلق
Dialogue: 0,0:35:55.24,0:35:57.28,Default,,0,0,0,,دائمًا ما أُغضِبُك, أليس كذلك؟
Dialogue: 0,0:36:02.15,0:36:03.85,Default,,0,0,0,,هلّا ترمي هذا؟
Dialogue: 0,0:36:03.85,0:36:05.62,Default,,0,0,0,,أرني كيف
Dialogue: 0,0:36:05.62,0:36:07.72,Default,,0,0,0,,اذهب وتسلّق تلك الشجرة
Dialogue: 0,0:36:15.50,0:36:17.93,Default,,0,0,0,,ألديك فرد آخر بالعائلة؟
Dialogue: 0,0:36:17.93,0:36:19.63,Default,,0,0,0,,عدى أخاك؟
Dialogue: 0,0:36:22.50,0:36:24.41,Default,,0,0,0,,لا أحد؟
Dialogue: 0,0:36:25.91,0:36:29.78,Default,,0,0,0,,كانت عندي امرأة, قبل فترة وجيزة
Dialogue: 0,0:36:31.68,0:36:34.48,Default,,0,0,0,,لم نتزوّج, لكنها كانت امرأتي
Dialogue: 0,0:36:36.19,0:36:37.65,Default,,0,0,0,,بِلا أطفال؟
Dialogue: 0,0:36:41.39,0:36:42.92,Default,,0,0,0,,كان لدينا طِفل
Dialogue: 0,0:36:44.73,0:36:48.53,Default,,0,0,0,,,كان سيكون أكبر منك بقليل\Nلكنّه لم يعِش
Dialogue: 0,0:36:51.77,0:36:53.53,Default,,0,0,0,,ألم تعد تراها؟
Dialogue: 0,0:36:54.44,0:36:56.64,Default,,0,0,0,,هكذا حالٌ أفضل
Dialogue: 0,0:36:56.64,0:36:58.74,Default,,0,0,0,,لا يوجد عبئ على كاحِلي
Dialogue: 0,0:37:01.41,0:37:03.31,Default,,0,0,0,,ما كان اسمها إذًا؟ -\N(رايتشل) -
Dialogue: 0,0:37:04.71,0:37:07.25,Default,,0,0,0,,(هناك العديد من النِساء يُدعون (ريتشل
Dialogue: 0,0:37:10.62,0:37:13.49,Default,,0,0,0,,(أعلم العديد من النساء يُدعون (رايتشل
Dialogue: 0,0:37:16.66,0:37:18.96,Default,,0,0,0,,أين تسكُن (رايتشل) امرأتك؟
Dialogue: 0,0:37:20.50,0:37:23.46,Default,,0,0,0,,ارتحنا لوقت كافٍ
Dialogue: 0,0:37:23.47,0:37:27.67,Default,,0,0,0,,سأعبئ هذه, ثم سنستمر بالسير
Dialogue: 0,0:37:28.70,0:37:30.40,Default,,0,0,0,,سأعبئها لك
Dialogue: 0,0:37:52.69,0:37:54.36,Default,,0,0,0,,هذا كافٍ لهذه الليلة
Dialogue: 0,0:38:00.44,0:38:02.34,Default,,0,0,0,,لنحظى ببعض الحطب
Dialogue: 0,0:38:02.34,0:38:04.04,Default,,0,0,0,,بلا نار هذه الليلة
Dialogue: 0,0:38:04.04,0:38:06.97,Default,,0,0,0,,نحن بعيدون عن حدود الأمّة,\Nولا نود جلب الإنتباه
Dialogue: 0,0:38:07.88,0:38:10.01,Default,,0,0,0,,سأوقد نارًا
Dialogue: 0,0:38:10.01,0:38:13.01,Default,,0,0,0,,إذا لم يعجبك, يمكن التجمد سيرًا
Dialogue: 0,0:38:16.59,0:38:19.35,Default,,0,0,0,,انهض
Dialogue: 0,0:38:19.36,0:38:22.39,Default,,0,0,0,,دعه وشانه, قدم الفتى ليست بحال جيدة
Dialogue: 0,0:38:25.93,0:38:27.63,Default,,0,0,0,,هيا يا غُلام
Dialogue: 0,0:38:34.57,0:38:36.70,Default,,0,0,0,,عليك أن تكون رجُل نفسِك يومًا ما
Dialogue: 0,0:38:44.05,0:38:45.98,Default,,0,0,0,,..ربما نقوم بعمل لطيف له
Dialogue: 0,0:38:48.75,0:38:50.55,Default,,0,0,0,,قبل أن نسلمّه
Dialogue: 0,0:38:54.89,0:38:57.79,Default,,0,0,0,,تعتقد أنّك طيّب, لكنك لست كذلك
Dialogue: 0,0:38:59.39,0:39:01.46,Default,,0,0,0,,لكنت ستفعل المِثل لو كنت مكاني
Dialogue: 0,0:39:10.34,0:39:11.84,Default,,0,0,0,,..هل نستطيع أن
Dialogue: 0,0:39:13.34,0:39:15.04,Default,,0,0,0,,أن نطلب منه المال الذي يُدينه لـ(بوريل)؟
Dialogue: 0,0:39:19.45,0:39:21.88,Default,,0,0,0,,تبًا يا غُلام
Dialogue: 0,0:39:21.88,0:39:24.75,Default,,0,0,0,,بوريل) لا يود المال منه)
Dialogue: 0,0:39:24.75,0:39:28.42,Default,,0,0,0,,نيت) قتل رجل, و(بوريل) سيقتله)\Nليحصد على الجائزة
Dialogue: 0,0:39:31.96,0:39:34.13,Default,,0,0,0,,سأفعلها لأجل المال بنفسي
Dialogue: 0,0:39:34.13,0:39:36.50,Default,,0,0,0,,لكن (بوريل) سيقتلني وأنت جميعًا
Dialogue: 0,0:39:36.50,0:39:38.80,Default,,0,0,0,,لو لم نسلمه كما قال بالضبط
Dialogue: 0,0:39:39.87,0:39:42.00,Default,,0,0,0,,توقف عن التحدث لذلك العجوز
Dialogue: 0,0:39:42.00,0:39:45.77,Default,,0,0,0,,,قبل أن يكتشف ما نحن عليه\Nفنقتله ونسحبه ميتًا
Dialogue: 0,0:39:51.78,0:39:54.05,Default,,0,0,0,,الأمر ليس بأمر المال وحسب
Dialogue: 0,0:39:54.05,0:39:55.98,Default,,0,0,0,,بل عن حياتك كذلك
Dialogue: 0,0:39:55.99,0:39:58.45,Default,,0,0,0,,نيت) رجل حكم عليه بالموت)\Nولا أحد يقدر على المُساعدة
Dialogue: 0,0:40:29.12,0:40:30.68,Default,,0,0,0,,ما الخطب يا غُلام؟
Dialogue: 0,0:40:34.62,0:40:35.99,Default,,0,0,0,,لست نائمًا؟
Dialogue: 0,0:40:41.00,0:40:42.90,Default,,0,0,0,,لا أستطيع النوم دائمًا كذلك
Dialogue: 0,0:40:53.51,0:40:55.91,Default,,0,0,0,,!فجأة أصبحت هادئ
Dialogue: 0,0:41:43.49,0:41:45.09,Default,,0,0,0,,أين (نيت)؟
Dialogue: 0,0:42:00.84,0:42:02.24,Default,,0,0,0,,احضر الغُلام
Dialogue: 0,0:42:24.73,0:42:26.13,Default,,0,0,0,,
Dialogue: 0,0:43:14.25,0:43:16.35,Default,,0,0,0,,حسنًا حسنًا
Dialogue: 0,0:43:16.35,0:43:18.65,Default,,0,0,0,,انبطح
Dialogue: 0,0:43:29.80,0:43:31.70,Default,,0,0,0,,
Dialogue: 0,0:43:55.89,0:43:57.73,Default,,0,0,0,,
Dialogue: 0,0:45:01.36,0:45:03.26,Default,,0,0,0,,حسنًا, دعنا نُلقي نظرة
Dialogue: 0,0:45:04.19,0:45:05.73,Default,,0,0,0,,هيا
Dialogue: 0,0:45:06.83,0:45:08.30,Default,,0,0,0,,سنصلح حالَك
Dialogue: 0,0:45:19.14,0:45:21.44,Default,,0,0,0,,هذا حتى لا نُبطئ بالسير
Dialogue: 0,0:45:21.44,0:45:24.18,Default,,0,0,0,,افعل كل ما آمرك أو سأتركك
Dialogue: 0,0:45:24.18,0:45:25.78,Default,,0,0,0,,مفهوم؟
Dialogue: 0,0:45:28.22,0:45:30.48,Default,,0,0,0,,هيا, أنت بخير
Dialogue: 0,0:45:30.49,0:45:32.39,Default,,0,0,0,,تبقت لدينا ليلتان أو ثلاث وحسب
Dialogue: 0,0:45:46.50,0:45:48.80,Default,,0,0,0,,كان يعيش هُنا مُحررون بالسابق
Dialogue: 0,0:46:35.32,0:46:38.19,Default,,0,0,0,,
Dialogue: 0,0:47:02.14,0:47:05.11,Default,,0,0,0,,
Dialogue: 0,0:47:20.16,0:47:22.60,Default,,0,0,0,,نقدّر أنّك آويتنا في هكذا ليلة
Dialogue: 0,0:47:22.60,0:47:25.03,Default,,0,0,0,,يبدو أن إبنك أكثر جوعًا منك
Dialogue: 0,0:47:46.35,0:47:48.62,Default,,0,0,0,,لم نكن على وِفاق أنا وعمّك
Dialogue: 0,0:47:51.06,0:47:55.13,Default,,0,0,0,,لكن من اللطف منه أنّه أخبرنا بأمر أخي
Dialogue: 0,0:47:55.13,0:47:57.56,Default,,0,0,0,,قضى نحبه في العمل الصالح
Dialogue: 0,0:48:02.04,0:48:04.47,Default,,0,0,0,,حاول إنقاذ نفسه عندما أتوا الجنود
Dialogue: 0,0:48:09.01,0:48:11.25,Default,,0,0,0,,لما عُدت لأجله؟
Dialogue: 0,0:48:45.01,0:48:47.11,Default,,0,0,0,,ما اسمك؟
Dialogue: 0,0:48:47.68,0:48:49.28,Default,,0,0,0,,(..ويل)
Dialogue: 0,0:48:51.19,0:48:52.59,Default,,0,0,0,,(ويليام)
Dialogue: 0,0:48:53.62,0:48:55.46,Default,,0,0,0,,وقع اسم (ويليام) يبدو من القِدم
Dialogue: 0,0:48:56.56,0:48:59.63,Default,,0,0,0,,(يدعونني (آبي) بدلًا من (آبيغيل
Dialogue: 0,0:49:06.47,0:49:09.30,Default,,0,0,0,,من الرجل الذي معك؟
Dialogue: 0,0:49:09.31,0:49:11.34,Default,,0,0,0,,من أقاربك؟
Dialogue: 0,0:49:11.34,0:49:13.07,Default,,0,0,0,,رجل وحسب
Dialogue: 0,0:49:13.08,0:49:15.01,Default,,0,0,0,,رجل وحسب؟
Dialogue: 0,0:49:20.98,0:49:23.25,Default,,0,0,0,,!هذا بارد يا غُلام
Dialogue: 0,0:49:24.19,0:49:25.55,Default,,0,0,0,,ستمكث هنا؟
Dialogue: 0,0:49:27.26,0:49:28.72,Default,,0,0,0,,عليك المكوث هنا
Dialogue: 0,0:49:30.99,0:49:32.43,Default,,0,0,0,,
Dialogue: 0,0:49:35.26,0:49:37.23,Default,,0,0,0,,لم لا ؟
Dialogue: 0,0:49:37.23,0:49:39.17,Default,,0,0,0,,إلى أين تذهب؟
Dialogue: 0,0:49:42.00,0:49:44.20,Default,,0,0,0,,لا يوجد العديد من الأطفال بالجوار
Dialogue: 0,0:49:45.44,0:49:47.34,Default,,0,0,0,,لست طفلًا
Dialogue: 0,0:49:50.14,0:49:51.65,Default,,0,0,0,,مستعد؟
Dialogue: 0,0:50:38.59,0:50:40.53,Default,,0,0,0,,بدأنا بالقُرب
Dialogue: 0,0:50:41.73,0:50:43.70,Default,,0,0,0,,يجب عدم رؤيتي بهذه المناطق
Dialogue: 0,0:51:08.62,0:51:10.22,Default,,0,0,0,,حسنًا
Dialogue: 0,0:51:11.46,0:51:15.30,Default,,0,0,0,,عندما تقذفها, أثبت ذِراعك صلبة
Dialogue: 0,0:51:15.30,0:51:17.53,Default,,0,0,0,,لنرى كيف تؤدي
Dialogue: 0,0:51:17.53,0:51:19.13,Default,,0,0,0,,هيّا
Dialogue: 0,0:51:19.63,0:51:21.23,Default,,0,0,0,,هيّا
Dialogue: 0,0:51:23.17,0:51:24.84,Default,,0,0,0,,أسبق وأنت استخدمت مطرقة؟
Dialogue: 0,0:51:24.84,0:51:27.27,Default,,0,0,0,,امسكها هكذا
Dialogue: 0,0:51:27.28,0:51:28.68,Default,,0,0,0,,..أدنى
Dialogue: 0,0:51:33.18,0:51:35.52,Default,,0,0,0,,ما خطبك يا غُلام؟
Dialogue: 0,0:51:35.52,0:51:37.42,Default,,0,0,0,,ابدأ هيّا
Dialogue: 0,0:51:38.62,0:51:41.56,Default,,0,0,0,,اختر شجرة, على ألّا تكون بعيدة
Dialogue: 0,0:51:43.39,0:51:45.43,Default,,0,0,0,,يا غلام, ما خطبك؟
Dialogue: 0,0:51:45.43,0:51:47.39,Default,,0,0,0,,هيّا, اختر شجرة
Dialogue: 0,0:51:53.57,0:51:55.84,Default,,0,0,0,,ماركوس) لم يسرق لحم الخنزير المُملح)
Dialogue: 0,0:51:56.87,0:51:59.34,Default,,0,0,0,,أنا من سرقه
Dialogue: 0,0:52:09.85,0:52:13.15,Default,,0,0,0,,كنت سأعطيه لك لو سألتني
Dialogue: 0,0:52:19.73,0:52:21.39,Default,,0,0,0,,(نيت)
Dialogue: 0,0:52:21.40,0:52:23.23,Default,,0,0,0,,..أنا
Dialogue: 0,0:52:24.43,0:52:26.13,Default,,0,0,0,,..عليّ اخبارك
Dialogue: 0,0:52:33.17,0:52:35.61,Default,,0,0,0,,..لو رأونا, اهرب وحسب
Dialogue: 0,0:52:35.61,0:52:37.54,Default,,0,0,0,,لا تنظر للخلف
Dialogue: 0,0:53:45.55,0:53:47.75,Default,,0,0,0,,ألديك أقارب آخرون حول (ليسفيل)؟
Dialogue: 0,0:53:51.39,0:53:54.29,Default,,0,0,0,,عندا نعود, ماذا ستفعل؟
Dialogue: 0,0:53:56.52,0:53:59.79,Default,,0,0,0,,أعمل الغرائب لرجل أبيض
Dialogue: 0,0:53:59.80,0:54:03.33,Default,,0,0,0,,احتفظ بالباقي لكي أبحث عن أبي\Nإن لم يعد قريبًا
Dialogue: 0,0:54:03.33,0:54:05.83,Default,,0,0,0,,ماهي الأعمال؟
Dialogue: 0,0:54:05.83,0:54:08.67,Default,,0,0,0,,"أعمال مختلفة في مقاطعة "نوتوواي
Dialogue: 0,0:54:10.57,0:54:12.64,Default,,0,0,0,,"اعتقدت أنّك قلت أنّك من "ليسفيل
Dialogue: 0,0:54:12.64,0:54:14.24,Default,,0,0,0,,كلّا
Dialogue: 0,0:54:15.51,0:54:16.91,Default,,0,0,0,,أنا من هناك
Dialogue: 0,0:54:18.51,0:54:21.01,Default,,0,0,0,,ليست بعيدة من هناك
Dialogue: 0,0:54:42.57,0:54:44.67,Default,,0,0,0,,رأيتك تتحدث لتلك الفتاة هناك
Dialogue: 0,0:54:46.31,0:54:49.01,Default,,0,0,0,,أسبق وأن كان لك أخت؟ -\Nكلّا -
Dialogue: 0,0:54:49.01,0:54:50.94,Default,,0,0,0,,لا تحظ إذًا
Dialogue: 0,0:54:50.95,0:54:52.75,Default,,0,0,0,,إنهنّ مُتعبات
Dialogue: 0,0:54:54.32,0:54:56.88,Default,,0,0,0,,ليس أجمعهم -\Nبل أجمعهم -
Dialogue: 0,0:55:00.66,0:55:02.59,Default,,0,0,0,,لكنّهم يستحقون التعنّي
Dialogue: 0,0:56:48.73,0:56:50.63,Default,,0,0,0,,سآخذه
Dialogue: 0,0:56:50.63,0:56:52.40,Default,,0,0,0,,(لا يروق لي (بريل
Dialogue: 0,0:56:52.40,0:56:54.50,Default,,0,0,0,,لن نمتطي مع (بريل) بعد الآن
Dialogue: 0,0:56:58.67,0:57:01.54,Default,,0,0,0,,الفاجِر قتل (هايدن) قبل يومان
Dialogue: 0,0:57:04.61,0:57:06.41,Default,,0,0,0,,هو ليس صالحًا
Dialogue: 0,0:57:13.65,0:57:16.02,Default,,0,0,0,,وجدنا فتاك
Dialogue: 0,0:57:28.60,0:57:31.04,Default,,0,0,0,,إلى أين مُتوجهَين ؟
Dialogue: 0,0:57:32.17,0:57:35.11,Default,,0,0,0,,(أخي مريض في (ليسفيل
Dialogue: 0,0:57:35.11,0:57:37.04,Default,,0,0,0,,نحن متوجهون لهناك
Dialogue: 0,0:57:38.21,0:57:39.78,Default,,0,0,0,,أليس كذلك؟
Dialogue: 0,0:57:41.62,0:57:44.05,Default,,0,0,0,,تبدون وأنك في حالة الندم
Dialogue: 0,0:57:46.55,0:57:49.19,Default,,0,0,0,,,لا يروق لي أن أرى رجلًا هكذا\Nسواءً كان أسود أم غير ذلك
Dialogue: 0,0:57:53.06,0:57:56.20,Default,,0,0,0,,لربما أن نسلك دربنا جميعًا
Dialogue: 0,0:57:56.20,0:57:59.53,Default,,0,0,0,,هذا لطفٌ منك, سنكون بخير وحدنا
Dialogue: 0,0:58:00.90,0:58:03.20,Default,,0,0,0,,سنبقى بجانبك وحسب إذا ناسبك الأمر
Dialogue: 0,0:58:06.57,0:58:08.94,Default,,0,0,0,,لا أكرث إذا كان يُناسبه
Dialogue: 0,0:58:22.22,0:58:24.22,Default,,0,0,0,,توقف
Dialogue: 0,0:58:35.67,0:58:37.60,Default,,0,0,0,,لقد حذّرته
Dialogue: 0,0:59:17.01,0:59:19.75,Default,,0,0,0,,تبقت لدينا ليلة واحدة بعد ما حدث
Dialogue: 0,0:59:19.75,0:59:22.68,Default,,0,0,0,,لذا أعتقد أننا سنعمل الأمر غدًا
Dialogue: 0,0:59:44.07,0:59:46.17,Default,,0,0,0,,أنقذتي هناك
Dialogue: 0,0:59:47.94,0:59:50.14,Default,,0,0,0,,كنت أنقذ نفسي
Dialogue: 0,0:59:57.28,0:59:59.19,Default,,0,0,0,,أكان لديك امراة بالقرب من هنا؟
Dialogue: 0,1:00:01.86,1:00:03.26,Default,,0,0,0,,صحيح
Dialogue: 0,1:00:06.59,1:00:08.96,Default,,0,0,0,,ألم تحظوا بطفلٍ آخر ؟
Dialogue: 0,1:00:10.06,1:00:12.10,Default,,0,0,0,,ليست الأمر بهذه السهولة
Dialogue: 0,1:00:15.27,1:00:17.20,Default,,0,0,0,,لكن بعض الأحيان يكون الأمر لا بأس به
Dialogue: 0,1:00:25.35,1:00:27.71,Default,,0,0,0,,أسبق وأن قتلت رجلًا قبل الرجل الذي بالأمس؟
Dialogue: 0,1:00:29.78,1:00:31.22,Default,,0,0,0,,نعم
Dialogue: 0,1:00:37.26,1:00:39.76,Default,,0,0,0,,قبل ست سنوات, توفى سيدّي
Dialogue: 0,1:00:42.73,1:00:45.97,Default,,0,0,0,,"زوجته غادرت لـ"بوستون\Nوحررتني عندما ذهبت
Dialogue: 0,1:00:48.67,1:00:52.71,Default,,0,0,0,,لذا توجهت للشمال كي أجني المال\Nلأشتري امرأتي من سيدها
Dialogue: 0,1:00:56.01,1:00:58.85,Default,,0,0,0,,لكن اثنان من حرس العبيد\Nحاولوا أخذني مرة أخرى
Dialogue: 0,1:01:02.72,1:01:04.82,Default,,0,0,0,,أظهرت لهم أوراق حُريتي
Dialogue: 0,1:01:09.82,1:01:12.16,Default,,0,0,0,,قتلت أحدهم
Dialogue: 0,1:01:12.16,1:01:15.13,Default,,0,0,0,,لربما لم يكن عليّ ذلك\Nلكنّي قتلته
Dialogue: 0,1:01:20.00,1:01:21.90,Default,,0,0,0,,بعد التخفّي لخمس سنوات
Dialogue: 0,1:01:21.90,1:01:24.10,Default,,0,0,0,,فقدت الإتصال بامرأتي
Dialogue: 0,1:01:26.07,1:01:29.04,Default,,0,0,0,,,هي تقطن على بعد خمسة أميال من هذا الدرب\Nأو كانت تقطن هناك
Dialogue: 0,1:01:35.88,1:01:37.85,Default,,0,0,0,,ربما كان عليّ ألّا أتركها
Dialogue: 0,1:01:44.93,1:01:47.29,Default,,0,0,0,,أفتقدها, لكن لم يكن لديّ خيار
Dialogue: 0,1:01:55.90,1:01:59.31,Default,,0,0,0,,لم أخبر أحدًا بهذا قبل
Dialogue: 0,1:02:01.34,1:02:03.34,Default,,0,0,0,,لم لم تُرسل لها الأخبار؟
Dialogue: 0,1:02:05.08,1:02:06.91,Default,,0,0,0,,تخبرها ما حدث
Dialogue: 0,1:02:08.32,1:02:11.78,Default,,0,0,0,,من الخطر معرفة شخص مثلي
Dialogue: 0,1:02:11.79,1:02:14.05,Default,,0,0,0,,لو كنت مكانها\Nلكنت أود معرفة ما حصل
Dialogue: 0,1:02:20.33,1:02:23.06,Default,,0,0,0,,تلك الليلة قبل أن يغادر أبي شمالًا
Dialogue: 0,1:02:26.30,1:02:29.44,Default,,0,0,0,,تشاجرنا بأمر ما, لا أتذكره حاليًا
Dialogue: 0,1:02:36.74,1:02:39.48,Default,,0,0,0,,أتمنى لو لم أتشاجر معه
Dialogue: 0,1:02:39.48,1:02:43.15,Default,,0,0,0,,لست متأكد أنه سيكون سعيدًا\Nلمقابلتي هذه الأيام
Dialogue: 0,1:02:46.99,1:02:48.82,Default,,0,0,0,,بل سيكون فخور بك
Dialogue: 0,1:02:55.16,1:02:57.13,Default,,0,0,0,,لديّ أمرُ عليّ الإفصاح عنه
Dialogue: 0,1:03:03.77,1:03:05.81,Default,,0,0,0,,لو لزم عليك فِعل شئ
Dialogue: 0,1:03:07.88,1:03:09.78,Default,,0,0,0,,لا تود عمله
Dialogue: 0,1:03:12.55,1:03:14.91,Default,,0,0,0,,وتعلم أنه خطأ
Dialogue: 0,1:03:15.95,1:03:18.05,Default,,0,0,0,,لكن ليس لديك الخيار
Dialogue: 0,1:03:23.82,1:03:25.86,Default,,0,0,0,,هل ستذهب للجحيم؟
Dialogue: 0,1:03:25.86,1:03:27.53,Default,,0,0,0,,لا أعلم
Dialogue: 0,1:03:29.46,1:03:32.00,Default,,0,0,0,,,ليس لديك الخِيار\Nليس لديك الخيار
Dialogue: 0,1:03:34.20,1:03:36.14,Default,,0,0,0,,أغلب المرّات يكون الخِيار بيدنا
Dialogue: 0,1:03:59.39,1:04:00.99,Default,,0,0,0,,نيت)؟)
Dialogue: 0,1:04:10.94,1:04:13.14,Default,,0,0,0,,نيت)؟)
Dialogue: 0,1:04:13.14,1:04:14.57,Default,,0,0,0,,!(نيت)
Dialogue: 0,1:04:22.05,1:04:23.98,Default,,0,0,0,,اعتقدت أنني تخلّيت عنك؟
Dialogue: 0,1:04:26.99,1:04:28.32,Default,,0,0,0,,لن أتخلى عنك
Dialogue: 0,1:04:31.39,1:04:33.89,Default,,0,0,0,,لكن قد أرحل إذا لم تستحم قريبًا
Dialogue: 0,1:04:44.47,1:04:46.94,Default,,0,0,0,,ربما علينا زيارة امرأتك
Dialogue: 0,1:04:47.91,1:04:49.34,Default,,0,0,0,,ماذا؟
Dialogue: 0,1:04:49.34,1:04:51.34,Default,,0,0,0,,علينا المُواصلة قدمًا
Dialogue: 0,1:04:52.18,1:04:54.28,Default,,0,0,0,,ليست بعيدة عن هنا
Dialogue: 0,1:04:54.28,1:04:57.05,Default,,0,0,0,,لا تتحدث عن الأمر مجددًا
Dialogue: 0,1:05:10.66,1:05:13.03,Default,,0,0,0,,لا أعلم مالذي أقوم به
Dialogue: 0,1:05:14.27,1:05:15.67,Default,,0,0,0,,كن صامتًا
Dialogue: 0,1:05:17.30,1:05:19.51,Default,,0,0,0,,علي الخروج من هنا وحسب
Dialogue: 0,1:05:19.51,1:05:21.47,Default,,0,0,0,,قمنا بالخيار
Dialogue: 0,1:05:25.01,1:05:27.38,Default,,0,0,0,,هي لا تودّ رؤيتي بعد طيلة هذه السنين
Dialogue: 0,1:05:27.38,1:05:29.28,Default,,0,0,0,,وأنا لا أهتمّ البتّة
Dialogue: 0,1:05:30.92,1:05:32.65,Default,,0,0,0,,بلى, أنت تهتم
Dialogue: 0,1:05:55.11,1:05:56.54,Default,,0,0,0,,نعم؟
Dialogue: 0,1:05:59.48,1:06:02.25,Default,,0,0,0,,هل يوجد امرأة تُدعى (رايتشل) هنا؟
Dialogue: 0,1:06:02.25,1:06:05.38,Default,,0,0,0,,رايتشل) تعيش هنا)
Dialogue: 0,1:06:05.39,1:06:08.39,Default,,0,0,0,,أيام الأحد تذهب للبلدة\Nفي منزل زوجة السيّد
Dialogue: 0,1:06:08.39,1:06:11.12,Default,,0,0,0,,بعض الأحيان تقضي الليل هناك
Dialogue: 0,1:06:11.13,1:06:13.53,Default,,0,0,0,,أعتقد أنها ستعود هذا المساء
Dialogue: 0,1:06:17.36,1:06:19.33,Default,,0,0,0,,كُنت رجلها؟
Dialogue: 0,1:06:21.60,1:06:23.57,Default,,0,0,0,,أنا رجلها الآن
Dialogue: 0,1:06:26.31,1:06:28.44,Default,,0,0,0,,لا أعتقد أنها ستود رؤيتك على الإطلاق
Dialogue: 0,1:06:30.21,1:06:32.45,Default,,0,0,0,,سمعت عنك
Dialogue: 0,1:06:32.45,1:06:34.55,Default,,0,0,0,,ماذا سمعت؟
Dialogue: 0,1:06:34.55,1:06:37.25,Default,,0,0,0,,أنه تم تحريرك
Dialogue: 0,1:06:37.25,1:06:39.75,Default,,0,0,0,,ذهبت للشمال, ولم تعد
Dialogue: 0,1:06:51.33,1:06:53.57,Default,,0,0,0,,احتفظت بهذه
Dialogue: 0,1:06:53.57,1:06:56.04,Default,,0,0,0,,لست مغرم بالنظر إليهم
Dialogue: 0,1:06:56.04,1:06:58.00,Default,,0,0,0,,..لو أردتهم
Dialogue: 0,1:07:01.01,1:07:03.31,Default,,0,0,0,,احتفظت بهم طيلة الوقت؟
Dialogue: 0,1:07:03.31,1:07:05.75,Default,,0,0,0,,لا أعلم إن كان من المفترض أن أعطيهم لك
Dialogue: 0,1:07:05.75,1:07:08.25,Default,,0,0,0,,احتفظت بهم لفترة
Dialogue: 0,1:07:09.68,1:07:13.25,Default,,0,0,0,,حذاء الرجل مُلك له
Dialogue: 0,1:07:13.25,1:07:15.59,Default,,0,0,0,,قد لا ترغب أن اعطيك إياهن
Dialogue: 0,1:07:19.29,1:07:22.26,Default,,0,0,0,,لم أعلم قط بما تريد
Dialogue: 0,1:07:22.26,1:07:25.06,Default,,0,0,0,,,بعض الأحيان ينقلب مزاجها\Nوتسمعني بعض القصص
Dialogue: 0,1:07:25.07,1:07:27.53,Default,,0,0,0,,كانت تدعني أسمع لها
Dialogue: 0,1:07:27.54,1:07:30.77,Default,,0,0,0,,بعض الأحيان أعتقد أن المقاطعة بأكملها\Nتستطيع سماعها حين تبدأ
Dialogue: 0,1:07:30.77,1:07:33.14,Default,,0,0,0,,قد تعلم كل الأمور أيضًا
Dialogue: 0,1:07:33.14,1:07:35.41,Default,,0,0,0,,الإله يعلم أنني أعلم
Dialogue: 0,1:07:35.41,1:07:37.68,Default,,0,0,0,,يالها من امرأة بِحق
Dialogue: 0,1:07:40.31,1:07:44.75,Default,,0,0,0,,ربما عليك البقاء والتحدث لفترة
Dialogue: 0,1:07:44.75,1:07:46.79,Default,,0,0,0,,ربما لديك العديد من القصص لترويها
Dialogue: 0,1:07:56.60,1:08:00.23,Default,,0,0,0,,سأخبرها أنك أتيت
Dialogue: 0,1:08:04.50,1:08:06.37,Default,,0,0,0,,أجل
Dialogue: 0,1:08:16.15,1:08:18.65,Default,,0,0,0,,نستطيع الإنتظار
Dialogue: 0,1:08:18.65,1:08:21.12,Default,,0,0,0,,قد تعود هذا المساء
Dialogue: 0,1:08:21.12,1:08:25.22,Default,,0,0,0,,كلّا, علينا الإستمرار
Dialogue: 0,1:08:25.23,1:08:27.49,Default,,0,0,0,,قد نصل لأخي غدًا بعد الظهيرة
Dialogue: 0,1:09:11.71,1:09:13.27,Default,,0,0,0,,(ريتسل)
Dialogue: 0,1:09:13.27,1:09:15.54,Default,,0,0,0,,الآن؟
Dialogue: 0,1:09:15.54,1:09:17.61,Default,,0,0,0,,الآن؟
Dialogue: 0,1:09:19.41,1:09:20.81,Default,,0,0,0,,أخبرني
Dialogue: 0,1:09:22.78,1:09:24.75,Default,,0,0,0,,أخبرني -\Nحسنًا -
Dialogue: 0,1:09:29.49,1:09:31.39,Default,,0,0,0,,غادرت شمالًا كما أخبرتك
Dialogue: 0,1:09:31.39,1:09:34.19,Default,,0,0,0,,من المفترض أن تعود لأجلي
Dialogue: 0,1:09:34.20,1:09:36.80,Default,,0,0,0,,لِم لَم تعد؟
Dialogue: 0,1:09:41.54,1:09:44.17,Default,,0,0,0,,كنت تستطيع تنبيئي بالأمر
Dialogue: 0,1:09:59.25,1:10:01.65,Default,,0,0,0,,أأنت مسؤول عن ذلك الغلام الآن؟
Dialogue: 0,1:10:06.19,1:10:08.29,Default,,0,0,0,,لا تستحق شيئًا
Dialogue: 0,1:10:09.36,1:10:11.46,Default,,0,0,0,,العودة الآن
Dialogue: 0,1:10:15.34,1:10:17.27,Default,,0,0,0,,اقترب يا غلام
Dialogue: 0,1:10:19.47,1:10:22.24,Default,,0,0,0,,انظر لنفسك, مُتسّخ
Dialogue: 0,1:10:22.24,1:10:24.54,Default,,0,0,0,,ممتلئ بالعثّ
Dialogue: 0,1:10:24.55,1:10:27.75,Default,,0,0,0,,,لا أتوقع منه الرعاية الجيدة\Nلكن على أحد الرعاية بك
Dialogue: 0,1:10:27.75,1:10:29.78,Default,,0,0,0,,..كنّا على السفر -\Nاصمت -
Dialogue: 0,1:10:29.78,1:10:31.68,Default,,0,0,0,,لا تتحدث إليّ
Dialogue: 0,1:10:34.29,1:10:35.79,Default,,0,0,0,,أنا بخير
Dialogue: 0,1:10:35.79,1:10:37.36,Default,,0,0,0,,أنت بخير؟
Dialogue: 0,1:10:39.53,1:10:42.60,Default,,0,0,0,,ليس لديه أحد؟
Dialogue: 0,1:10:42.60,1:10:45.83,Default,,0,0,0,,إذا لم يكن لديه أحد, فدعهُ هنا\Nحتى يكتشف أحدًا
Dialogue: 0,1:10:45.83,1:10:48.73,Default,,0,0,0,,لديّ أُناس
Dialogue: 0,1:10:48.74,1:10:51.24,Default,,0,0,0,,لديك أُناس
Dialogue: 0,1:10:51.24,1:10:52.64,Default,,0,0,0,,أقارب؟
Dialogue: 0,1:10:55.48,1:10:56.88,Default,,0,0,0,,
Dialogue: 0,1:10:57.94,1:11:00.88,Default,,0,0,0,,أأنت متأكد أنك لست ابنه؟
Dialogue: 0,1:11:00.88,1:11:03.38,Default,,0,0,0,,لأنك مزعج على حد سواء
Dialogue: 0,1:11:08.76,1:11:10.72,Default,,0,0,0,,علينا الرحيل الآن
Dialogue: 0,1:11:14.39,1:11:16.33,Default,,0,0,0,,لا تعاملني بغرابة
Dialogue: 0,1:12:04.35,1:12:05.74,Default,,0,0,0,,ما الخطب؟
Dialogue: 0,1:12:13.79,1:12:15.69,Default,,0,0,0,,علينا الأكل
Dialogue: 0,1:12:19.76,1:12:22.76,Default,,0,0,0,,هنالك متاجر عند تقاطع الطرق
Dialogue: 0,1:12:22.76,1:12:25.06,Default,,0,0,0,,البعض منهم يبيع للسود
Dialogue: 0,1:12:25.07,1:12:27.00,Default,,0,0,0,,عليهم ألّا يروني هناك
Dialogue: 0,1:12:30.47,1:12:33.84,Default,,0,0,0,,هذا مالٌ كافٍ للبسكويت ولحم الغزال
Dialogue: 0,1:12:33.84,1:12:35.57,Default,,0,0,0,,سأكون هنا
Dialogue: 0,1:12:39.11,1:12:40.68,Default,,0,0,0,,كن حذرًا
Dialogue: 0,1:12:48.62,1:12:50.49,Default,,0,0,0,,
Dialogue: 0,1:13:03.00,1:13:04.57,Default,,0,0,0,,هذا ايضًا؟
Dialogue: 0,1:13:17.15,1:13:19.85,Default,,0,0,0,,هذا ليس كافٍ
Dialogue: 0,1:13:28.40,1:13:30.13,Default,,0,0,0,,لديك شراب ويسكي؟
Dialogue: 0,1:13:53.99,1:13:55.82,Default,,0,0,0,,ما كل هذا؟
Dialogue: 0,1:13:57.79,1:13:59.76,Default,,0,0,0,,حتى لا تشعر بالبرودة
Dialogue: 0,1:14:01.93,1:14:04.86,Default,,0,0,0,,أأنفقت قِطعة والدك النقدية؟
Dialogue: 0,1:14:08.74,1:14:11.67,Default,,0,0,0,,سأعطيها لأخي
Dialogue: 0,1:14:11.67,1:14:13.91,Default,,0,0,0,,قد تكون مصدر راحة له
Dialogue: 0,1:14:15.18,1:14:17.08,Default,,0,0,0,,اشرب البعض الآن
Dialogue: 0,1:14:30.86,1:14:32.99,Default,,0,0,0,,لقد نجحنا, أليس كذلك؟
Dialogue: 0,1:14:49.14,1:14:52.08,Default,,0,0,0,,لا أعلم بأمر مُلاقاة أخي\Nبعد مرور كل هذا الوقت
Dialogue: 0,1:14:53.61,1:14:55.55,Default,,0,0,0,,لا أعلم
Dialogue: 0,1:14:57.92,1:15:00.85,Default,,0,0,0,,الرياح لا تجري كما تشتهي السفن
Dialogue: 0,1:15:00.86,1:15:02.79,Default,,0,0,0,,أو بِجانبي
Dialogue: 0,1:15:04.62,1:15:07.06,Default,,0,0,0,,لم أعش الحياة التي أستحقها
Dialogue: 0,1:15:07.89,1:15:09.86,Default,,0,0,0,,أضعت الوقت
Dialogue: 0,1:15:12.10,1:15:14.57,Default,,0,0,0,,ولم تكن غلطتي طوال الوقت
Dialogue: 0,1:15:24.98,1:15:29.72,Default,,0,0,0,,لكنّي سأعمل ما يجب عمله, وستكون الأمور أفضل
Dialogue: 0,1:15:29.72,1:15:31.72,Default,,0,0,0,,سأكون أفضل
Dialogue: 0,1:15:36.79,1:15:38.99,Default,,0,0,0,,ما رأيك بهذا الأمر؟
Dialogue: 0,1:16:03.32,1:16:05.12,Default,,0,0,0,,أتودّ حملها؟
Dialogue: 0,1:16:06.55,1:16:08.62,Default,,0,0,0,,تستطيع الحفاظ به حتى الصباح
Dialogue: 0,1:16:46.06,1:16:47.66,Default,,0,0,0,,..لعلمك
Dialogue: 0,1:16:49.70,1:16:51.70,Default,,0,0,0,,لديّ متاعٌ قليل
Dialogue: 0,1:16:53.27,1:16:56.20,Default,,0,0,0,,بعد أن أعتني بأخي, نستطيع العودة للشمال
Dialogue: 0,1:16:56.20,1:16:58.00,Default,,0,0,0,,ونبحث عن أباك
Dialogue: 0,1:16:58.01,1:16:59.77,Default,,0,0,0,,إذا ما أردت
Dialogue: 0,1:17:02.68,1:17:07.25,Default,,0,0,0,,حتى لو لم نجده
Dialogue: 0,1:17:07.25,1:17:09.31,Default,,0,0,0,,تستطيع السفر معي طوال الوقت
Dialogue: 0,1:17:12.62,1:17:14.35,Default,,0,0,0,,نستطيع الذهاب للغرب
Dialogue: 0,1:17:15.86,1:17:18.32,Default,,0,0,0,,الأمور تختلف هناك
Dialogue: 0,1:17:24.66,1:17:27.80,Default,,0,0,0,,ربما قد أفعل لك مالم يفعله أحد لي قبل
Dialogue: 0,1:17:30.84,1:17:33.11,Default,,0,0,0,,لا فائدة من التوحدّ بحق
Dialogue: 0,1:17:36.04,1:17:37.98,Default,,0,0,0,,ما رأيك؟
Dialogue: 0,1:17:41.68,1:17:43.12,Default,,0,0,0,,
Dialogue: 0,1:17:47.22,1:17:51.09,Default,,0,0,0,,فكّر بالأمر
Dialogue: 0,1:22:38.41,1:22:40.45,Default,,0,0,0,,كنت أفكر بأمرك
Dialogue: 0,1:22:46.69,1:22:48.65,Default,,0,0,0,,أتستطيعون الصمود؟
Dialogue: 0,1:22:51.59,1:22:53.66,Default,,0,0,0,,ماركوس) لن ينجح)
Dialogue: 0,1:22:53.66,1:22:55.39,Default,,0,0,0,,نعم, سمعت
Dialogue: 0,1:23:00.53,1:23:04.10,Default,,0,0,0,,عندما نمتطي, فمن الأفضل أن ينتظرني
Dialogue: 0,1:23:06.57,1:23:09.44,Default,,0,0,0,,لكنّي أعلم أنه سينتظر
Dialogue: 0,1:23:09.44,1:23:11.64,Default,,0,0,0,,لأنك قادم معنا
Dialogue: 0,1:23:13.08,1:23:15.25,Default,,0,0,0,,إنه هنا
Dialogue: 0,1:23:15.25,1:23:18.65,Default,,0,0,0,,لم أحصل على سكينته
Dialogue: 0,1:23:18.65,1:23:20.72,Default,,0,0,0,,أعطني مُهلة ساعة
Dialogue: 0,1:23:20.72,1:23:22.45,Default,,0,0,0,,سأحضرها
Dialogue: 0,1:23:50.52,1:23:52.45,Default,,0,0,0,,علينا الذهاب قريبًا
Dialogue: 0,1:23:54.52,1:23:56.45,Default,,0,0,0,,هيّا الآن
Dialogue: 0,1:24:09.70,1:24:12.07,Default,,0,0,0,,لا توجد رياح اليوم
Dialogue: 0,1:24:13.81,1:24:15.64,Default,,0,0,0,,سيكون أدفأ
Dialogue: 0,1:24:25.65,1:24:27.59,Default,,0,0,0,,غُلام, ما خطبك؟
Dialogue: 0,1:24:35.19,1:24:36.59,Default,,0,0,0,,
Dialogue: 0,1:24:39.37,1:24:40.77,Default,,0,0,0,,تحدّث
Dialogue: 0,1:24:45.60,1:24:47.21,Default,,0,0,0,,تحدث
Dialogue: 0,1:24:48.61,1:24:51.68,Default,,0,0,0,,أود الوصول لأخي قبل حلول الظلام
Dialogue: 0,1:24:59.85,1:25:02.35,Default,,0,0,0,,أخاك ميّت
Dialogue: 0,1:25:08.09,1:25:10.76,Default,,0,0,0,,من المُفترض أن نجلبك لصائدي المكافئات
Dialogue: 0,1:25:12.73,1:25:15.37,Default,,0,0,0,,كانوا سيقتلونك لأجل المُكافئة من المال
Dialogue: 0,1:25:20.64,1:25:23.58,Default,,0,0,0,,قالوا أنهم سيقتلوننا إلّم نجلبك
Dialogue: 0,1:25:28.65,1:25:30.72,Default,,0,0,0,,عليك الإبتعاد عن هنا
Dialogue: 0,1:25:50.60,1:25:52.70,Default,,0,0,0,,لا تستحق ما يجري لك
Dialogue: 0,1:26:20.43,1:26:22.47,Default,,0,0,0,,إنهم قادمون
Dialogue: 0,1:26:22.47,1:26:25.94,Default,,0,0,0,,إنهم هنا, علينا الهرب أو القِتال\Nيجب أن نذهب
Dialogue: 0,1:26:34.65,1:26:36.28,Default,,0,0,0,,(ويل؟)
Dialogue: 0,1:26:39.25,1:26:41.45,Default,,0,0,0,,اخرج الآن
Dialogue: 0,1:26:45.49,1:26:47.73,Default,,0,0,0,,دعنا نعمل ما أتينا لأجله
Dialogue: 0,1:26:50.93,1:26:53.80,Default,,0,0,0,,أو سنقوم بعمله لك أيضا
Dialogue: 0,1:26:53.80,1:26:55.80,Default,,0,0,0,,لن يحدث شئ لك
Dialogue: 0,1:26:55.80,1:26:58.12,Default,,0,0,0,,ستكون بخير -\N"الجهة الأخرى" -
Dialogue: 0,1:27:01.21,1:27:03.68,Default,,0,0,0,,"اذهب للخلف, تحرّك"
Dialogue: 0,1:27:04.94,1:27:07.38,Default,,0,0,0,,أعطني السكينة الأخرى
Dialogue: 0,1:27:07.85,1:27:09.35,Default,,0,0,0,,ويل؟
Dialogue: 0,1:27:12.59,1:27:14.45,Default,,0,0,0,,هذه ليست غلطتك يا ابني
Dialogue: 0,1:27:15.62,1:27:18.36,Default,,0,0,0,,لست تُشبههم
Dialogue: 0,1:27:18.36,1:27:20.89,Default,,0,0,0,,خاطرت بحياتك من أجل إخباري
Dialogue: 0,1:27:23.63,1:27:25.43,Default,,0,0,0,,أنا فخور بك
Dialogue: 0,1:27:42.65,1:27:44.68,Default,,0,0,0,,دع ذلك هناك كي يراها
Dialogue: 0,1:27:44.68,1:27:46.95,Default,,0,0,0,,ستذهب للشمال الآن
Dialogue: 0,1:27:46.95,1:27:49.89,Default,,0,0,0,,خذ (رايتشل) لأولائك البشر في المُستنقع\Nحتى تنتهي الحرب
Dialogue: 0,1:27:49.89,1:27:52.46,Default,,0,0,0,,ثم ابحث عن أباك
Dialogue: 0,1:27:53.96,1:27:55.96,Default,,0,0,0,,سألتحق بك من بعدك
Dialogue: 0,1:27:55.96,1:27:57.56,Default,,0,0,0,,..وإذا لم ألتحق
Dialogue: 0,1:27:59.83,1:28:01.87,Default,,0,0,0,,(أعطِ نصف هذا لـ(رايتشل
Dialogue: 0,1:28:04.37,1:28:07.04,Default,,0,0,0,,كلّا
Dialogue: 0,1:28:07.04,1:28:09.27,Default,,0,0,0,,كلّا
Dialogue: 0,1:28:09.28,1:28:11.31,Default,,0,0,0,,كلّا
Dialogue: 0,1:28:15.01,1:28:17.58,Default,,0,0,0,,نيت
Dialogue: 0,1:28:44.34,1:28:46.48,Default,,0,0,0,,عمل رائع
Dialogue: 0,1:28:46.48,1:28:48.41,Default,,0,0,0,,عمل رائع
Dialogue: 0,1:28:55.82,1:28:57.76,Default,,0,0,0,,أنت حرٌ للذهاب
Dialogue: 0,1:29:00.59,1:29:02.69,Default,,0,0,0,,لا تتبعنا إذا أردت الحياة
