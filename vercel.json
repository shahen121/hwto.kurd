{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/subtitles/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/subtitles",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/embed-proxy",
      "destination": "/api/embed-proxy"
    },
    {
      "source": "/api/embed-proxy",
      "destination": "/api/embed-proxy"
    },
    {
      "source": "/api/subtitles",
      "destination": "/api/subtitles"
    },
    {
      "source": "/subtitles/(.*)",
      "destination": "/api/subtitles?file=$1"
    },
    {
      "source": "/vidlink/(.*)",
      "destination": "/api/vidlink"
    },
    {
      "source": "/((?!api/tmdb|api/football|api/subtitles|api/embed-proxy|embed-proxy|subtitles/|assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*vidlink.*"
        }
      ],
      "destination": "/api/vidlink"
    },
    {
      "source": "/(vidcore|movie|tv|embed|_next|stream-proxy)/(.*)",
      "destination": "/api/vidcore"
    },
    {
      "source": "/(APA91.*|wyzie.*|servers.*)",
      "destination": "/api/vidcore"
    },
    {
      "source": "/(gtag-shield\\.js|script\\.js|fu\\.wasm|decrypter-worker\\.js|hls\\.worker\\.js)",
      "destination": "/api/vidcore"
    },
    {
      "source": "/api/b/(.*)",
      "destination": "/api/vidcore"
    },
    {
      "source": "/api/skip-events",
      "destination": "/api/vidcore"
    },
    {
      "source": "/((?!api/tmdb|api/football|api/subtitles|api/embed-proxy|embed-proxy|subtitles/|assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*vidcore.*"
        }
      ],
      "destination": "/api/vidcore"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
