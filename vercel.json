{
  "headers": [
    {
      "source": "/subtitles/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/subtitles",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/subtitles",
      "destination": "/api/subtitles"
    },
    {
      "source": "/subtitles/(.*)",
      "destination": "/api/subtitles?file=$1"
    },
    {
      "source": "/vidlink/:path*",
      "destination": "/api/vidlink?__orig_path=/vidlink/:path*"
    },
    {
      "source": "/vidlink/(.*)",
      "destination": "/api/vidlink?__orig_path=/vidlink/$1"
    },
    {
      "source": "/((?!api/tmdb|api/football|api/subtitles|subtitles/|assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*vidlink.*"
        }
      ],
      "destination": "/api/vidlink?__orig_path=/$1"
    },
    {
      "source": "/vidcore/:path*",
      "destination": "/api/vidcore?__orig_path=/vidcore/:path*"
    },
    {
      "source": "/vidcore/(.*)",
      "destination": "/api/vidcore?__orig_path=/vidcore/$1"
    },
    {
      "source": "/APA91(.*)",
      "destination": "/api/vidcore?__orig_path=/APA91$1"
    },
    {
      "source": "/servers(.*)",
      "destination": "/api/vidcore?__orig_path=/servers$1"
    },
    {
      "source": "/wyzie(.*)",
      "destination": "/api/vidcore?__orig_path=/wyzie$1"
    },
    {
      "source": "/(movie|tv|embed|_next|stream-proxy)/(.*)",
      "destination": "/api/vidcore?__orig_path=/$1/$2"
    },
    {
      "source": "/(gtag-shield.*|hwto-subtitles\\.js|script\\.js|fu\\.wasm|decrypter-worker\\.js|hls\\.worker\\.js)",
      "destination": "/api/vidcore?__orig_path=/$1"
    },
    {
      "source": "/api/b/(.*)",
      "destination": "/api/vidcore?__orig_path=/api/b/$1"
    },
    {
      "source": "/api/skip-events",
      "destination": "/api/vidcore?__orig_path=/api/skip-events"
    },
    {
      "source": "/((?!api/tmdb|api/football|api/subtitles|subtitles/|assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*vidcore.*"
        }
      ],
      "destination": "/api/vidcore?__orig_path=/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
