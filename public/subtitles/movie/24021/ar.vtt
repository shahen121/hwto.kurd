298
00:25:07.359 --> 00:25:10.554
بيـلا ) , باللـه عليكِ )
من فضلك

299
00:25:13.317 --> 00:25:15.255
أنـا آسـف

300
00:26:24.300 --> 00:26:26.024
أتعلميـن ؟

301
00:26:26.024 --> 00:26:28.537
يمكـن لـ ( إدوارد ) أن يحـتـرم
و لـو علـى الأقـل أوقـات تنـاول الطعـام

302
00:26:29.473 --> 00:26:31.825
لقد كنت بصحبـة ( جـايـك ) للتـو

303
00:26:31.525 --> 00:26:34.978
جـيـد

304
00:26:39.779 --> 00:26:43.412
سأمنحكمـا بعـض الخصـوصيـة إذاً

305
00:26:45.196 --> 00:26:45.878
أهـلاً

306
00:26:46.178 --> 00:26:47.950
هل تدركيـن كم كنت قلقـاً عليـكِ ؟

307
00:26:47.950 --> 00:26:49.274
لقد كنـت بمـأمـن تـام

308
00:26:49.274 --> 00:26:51.761
كنت علـى وشك خـرق المعاهـدة
لأتـأكـد من سلامتـكِ

309
00:26:52.736 --> 00:26:55.166
أعلـم , رائحـتـي كـرائـحـة الكلاب , آسفـة -
لا , هنالك خطـب مـا -

310
00:27:02.871 --> 00:27:05.939
إدوارد ) , مـا الخطـب ؟ ) -
شخـص مـا كـان هنـا -

311
00:27:11.836 --> 00:27:15.182
مـن كـان ؟
أحـد نعـرفـه ؟

312
00:27:15.182 --> 00:27:18.309
شخـص غـريـب
لـم أتعـرف علـى رائـحـتـه

313
00:27:18.309 --> 00:27:19.916
عـابـر سبيـل ؟

314
00:27:19.916 --> 00:27:22.610
لم يكن ليتـرك عابـر سبيـل
والـد ( بيـلا ) حـيـاً

315
00:27:22.610 --> 00:27:25.544
رائـحـتـه تختفـي علـى بعـد 5 أميـال
( جنـوب منـزل ( بيـلا

316
00:27:27.353 --> 00:27:30.655
شخـص مـا يـدبّـر هـذا -
فيكتـوريـا ) ؟ ) -

317
00:27:31.455 --> 00:27:35.095
كنت لأراهـا و هـي تتـخـذ هذا القـرار -
" لا بـد من أنهـم الـ " فـولتـوري -

318
00:27:35.095 --> 00:27:37.810
لا أعتقـد أنهـم الـ " فـولتـوري" أيضـاً

319
00:27:37.810 --> 00:27:39.476
لقد كنـت أراقـب
قـرارات ( آرو ) أيضـاً

320
00:27:39.476 --> 00:27:40.806
لذا علينـا مـواصلـة البـحـث

321
00:27:40.806 --> 00:27:43.474
علينـا أيضـاً أن نتنـاوب علـى
حـراسـة ( بيـلا ) فـي منـزلهـا

322
00:27:43.862 --> 00:27:46.860
تعليمـات حمـايـة أخـرى ؟ -
( روزالـي ) -

323
00:27:48.080 --> 00:27:49.617
لا , إنهـا محقـة

324
00:27:49.717 --> 00:27:52.434
لا يمكنكـم حمـايتـي
... و حـراسـة أبـي

325
00:27:52.434 --> 00:27:54.118
و البـحـث عـن الدخـيـل فـي آن واحـد

326
00:27:54.118 --> 00:27:55.939
( و عـن ( فيكتـوريـا

327
00:27:55.940 --> 00:27:57.710
و اطعـام أنفسكـم

328
00:27:57.711 --> 00:27:59.453
لـن أتـركـك هنـا مـن دون حمـايـة

329
00:27:59.453 --> 00:28:01.502
حسـن , أنـا لـن أدعكـم
تمـوتـون جـوعـاً

330
00:28:02.589 --> 00:28:06.549
و أنـا لـن أكون غيـر محميـة
... فأنـا لـديّ

331
00:28:06.249 --> 00:28:08.138
مـاذا ؟

332
00:28:15.678 --> 00:28:18.640
أيـاً كـان , فقد تـرك
رائـحـتـه خلفـه

333
00:28:18.640 --> 00:28:21.419
لن يكون من الصعـب مـلاحظـتهـا
عندمـا نلتقـي بـه ثـانيـة

334
00:28:21.419 --> 00:28:24.499
سنتـولـى الأمـر من هنـا -
لا نحتـاج منكم تـولـي أي شـيء -

335
00:28:25.301 --> 00:28:28.330
أو من أي شخـص -
أنـا لا أبـالـي أبـداً بمـا تـريـده -

336
00:28:28.330 --> 00:28:30.214
حسـن , لقد انتهينـا هنـا

337
00:28:30.214 --> 00:28:33.100
لا , أنـت من انتهـى دوره هنـا -
تـوقـفـا -

338
00:28:33.100 --> 00:28:36.422
لقد سئمـت هـذا
من الآن فصاعـداً سأكون محـايـدة , حسنـاً ؟

339
00:28:37.924 --> 00:28:39.625
<i>إدوارد ) كـره الفكـرة )</i>

340
00:28:39.626 --> 00:28:43.193
<i>لكن الأمـر لم يعـد يتعلق بالمنافسـة</i>

341
00:28:43.194 --> 00:28:45.872
<i>( بل بسلامتـي أنـا و ( تشـارلـي</i>

342
00:28:47.043 --> 00:28:50.528
<i>فيمـا بعـد , جعلتهـم
علـى الأقـل يحـاولـون العمـل معـاً</i>

343
00:28:56.462 --> 00:28:59.123
<i>الذئـاب كانت تتولـى حـراستـي
متـى كانـوا آل ( كوليـن ) يصطادون للتغذيـة</i>

344
00:29:02.158 --> 00:29:04.678
<i>لم يكن بالضبـط تحـالفـاً سهـلاً</i>

345
00:29:21.222 --> 00:29:22.861
ألا يمتلك قميصـاً ؟

346
00:29:27.762 --> 00:29:29.774
أنـا بخيـر هنـا
يجـدر بك الذهـاب

347
00:29:29.774 --> 00:29:35.083
لـن أغيـب طـويـلاً -
لا تعجـل , عليك أن تصطـاد -

348
00:29:51.339 --> 00:29:53.476
أو تعجـل قليـلاً

349
00:29:58.793 --> 00:30:00.805
أهـلاً , أيتهـا الجميلـة -
أهـلاً -

350
00:30:11.579 --> 00:30:13.170
مـاذا تـريـديـن أن تفعلـي الليلـة ؟

351
00:30:13.171 --> 00:30:15.615
قيـادة دراجـات ؟ تنـزّه ؟
دردشـة ؟

352
00:30:15.626 --> 00:30:18.704
إنـه قـرارك , لكننـا ذاهبـان
لحفلـة الليلـة

353
00:30:21.728 --> 00:30:22.901
متـأكـد من أنـه لا بـأس بهـذا ؟

354
00:30:22.902 --> 00:30:26.470
فلا أحـب أن أذهـب لحفلـة
أنـا لست مـدعـوّة لهـا

355
00:30:26.868 --> 00:30:29.492
تقنيـاً , أنـت تقتحميـن
اجـتـمـاعـاً و ليـس حفلـة

356
00:30:30.215 --> 00:30:35.318
أتـريـن ؟ أعضـاء المجلـس , أبـي , جـدّ
( كويـل ) و ( سـو كليـرواتـر )

357
00:30:35.950 --> 00:30:37.842
( لقد حلّـت محـل ( هـاري
عندمـا تـوفـي

358
00:30:37.842 --> 00:30:39.640
حسـن , لا يجـدر بـي أن
أكـون هنـا

359
00:30:40.459 --> 00:30:44.123
لا بـأس
... لقد ظننـت

360
00:30:44.123 --> 00:30:47.119
اعتقـدت أنـه سيكون من الجـيـد
أن تستمعـي لتـاريـخـنـا

361
00:30:47.858 --> 00:30:52.860
التـاريـخ ؟ تـاريـخ القبيلـة ؟
أليس هذا سـراً ؟

362
00:30:53.924 --> 00:30:57.482
لكل منـا دوره
و أنـتِ جـزء من هـذا

363
00:30:58.213 --> 00:31:01.280
( إنهـا المـرة الأولـى لـ ( ليـا
و ( كـويـل ) و ( سيث ) أيضـاً

364
00:31:01.280 --> 00:31:04.680
لكنك أول من ينضـم إلينـا
و لا يكون من القبيلـة

365
00:31:06.818 --> 00:31:08.613
... إذا كنت أعـرف هـذا , كنت لـ

366
00:31:10.702 --> 00:31:13.244
كنت لارتـديـت أفضـل مـن هذا -
( جـايـك ) -

367
00:31:14.309 --> 00:31:17.269
أهـلاً -
و أخـيـراً وصلـت -

368
00:31:17.269 --> 00:31:18.716
بـول ) كان مُنصبـاً علـى الطعـام )

369
00:31:18.717 --> 00:31:20.420
لكننـي وفّـرت لك بعض
شطـائـر البـرجـر

370
00:31:20.421 --> 00:31:22.648
أبليت حسنـاً يـا صديقـي

371
00:31:22.648 --> 00:31:25.647
( بيـلا ) , أعـرفـك بـ ( سيث كليـروتـر )
( أخ ( ليـا

372
00:31:25.647 --> 00:31:29.751
أحـدث عضـو فـي المجمـوعـة -
الأحـدث , الأفضـل , الأذكـى -

373
00:31:29.451 --> 00:31:31.093
و الأبطـأ

374
00:31:34.063 --> 00:31:36.273
هيـا , والـدك علـى وشك البدء -
حسنـاً -

375
00:31:38.575 --> 00:31:41.652
آل " كويليـات " كانـوا قبيلـة صغيـرة
... منـذ البدايـة

376
00:31:42.776 --> 00:31:45.384
لكن لطالمـا كـان السحـر
يتخـلل دمـائـنـا

377
00:31:47.533 --> 00:31:49.912
... لقد كنـا محـاربـون روحـيـون رائعـون

378
00:31:49.912 --> 00:31:55.014
متحـوّلـون يتحـولـون لذئـاب قـويـة

379
00:31:56.481 --> 00:32:00.082
هذا مكننـا من إخـافـة أعـداءنـا

380
00:32:00.082 --> 00:32:02.689
و حمـايـة قبيلتنـا

381
00:32:04.273 --> 00:32:09.275
... ذات يـوم محـاربـونـا قابلـوا مخلـوقـاً

382
00:32:10.366 --> 00:32:15.468
<i>بـدا و كـأنـه من البشـر
... لكنـه كان قاسيـاً كالحجـر</i>

383
00:32:15.468 --> 00:32:17.825
<i>و بـارداً كالثلـج</i>

384
00:32:37.465 --> 00:32:41.635
أسنـان محـاربـونـا الحـادة
... مـزقـتـه إربـاً أخـيـراً

385
00:32:41.635 --> 00:32:45.475
لكن فقط النـار هـي
من يمكنهـا تدميـره كليـاً

386
00:32:46.257 --> 00:32:50.050
" عاشـوا فـي خـوف من أن " الـرجـل البـارد
لم يكن بمفـرده

387
00:32:51.272 --> 00:32:52.897
و كـانـوا محقيـن حيـال هذا

388
00:32:56.842 --> 00:33:00.104
<i>لقد صبّت انتقامهـا علـى القـريـة</i>

389
00:33:02.588 --> 00:33:04.940
<i>( قائدنـا الأكبـر , ( طـه آكـي</i>

390
00:33:04.940 --> 00:33:08.437
<i>كـان المحـارب الـروحـيّ الـوحـيـد الذي
تبقـى لإنقـاذ القبيلـة</i>

391
00:33:08.437 --> 00:33:11.220
<i>بعدمـا قُتـل ابنـه</i>

392
00:33:22.457 --> 00:33:26.213
<i>زوجـة ( طـه آكـي ) الثـالثـة
رأت أنـه مهـزوم</i>

393
00:33:27.250 --> 00:33:31.178
<i>الـزوجـة الثالثـة لم تكـن
مخلـوقـة سحـريّـة</i>

394
00:33:31.178 --> 00:33:33.978
<i>لم تكن تمتلك أيـة قـوى خـاصـة
... عـدا قـوة واحـدة</i>

395
00:33:35.515 --> 00:33:37.397
الشجـاعـة

396
00:33:48.294 --> 00:33:51.602
تضحيـة الـزوجـة الثالثـة صـرفـت
... " انتبـاه " المـرأة البـاردة

397
00:33:51.602 --> 00:33:55.238
لـوقـت يكفـي لأن
( يدمـرهـا ( طـه آكـي

398
00:33:55.744 --> 00:33:57.881
لقد أنقـذت القبيلـة

399
00:33:58.472 --> 00:34:01.763
بـمـرور الـزمـن , أعـداءنـا
... بـدأوا يختفـون

400
00:34:02.651 --> 00:34:04.621
... لكن عـدو يبقـى

401
00:34:06.025 --> 00:34:08.171
" البـاردون "

402
00:34:10.387 --> 00:34:12.930
سحـرنـا يستيقظ عندمـا يقتـربـوا منّـا

403
00:34:12.930 --> 00:34:17.116
و نـحـن نشعـر بقـربهـم الآن
نشعـر بتهديدهـم فـي دمـائـنـا

404
00:34:18.786 --> 00:34:20.961
شـيء مـا رهيـب قـادم فـي الطـريـق

405
00:34:22.965 --> 00:34:28.067
و علينـا جميعـاً أن نكون مستعديـن
جميعنـا

406
00:34:54.680 --> 00:34:56.656
مـاذا فعلـت بـي ؟

407
00:35:00.671 --> 00:35:05.097
... أنـا جـداً -
نعـم , أعلـم -

408
00:35:06.422 --> 00:35:08.147
سنـجـد لك أحـداً تشـربـي دمـه

409
00:35:16.364 --> 00:35:19.644
حـاولـي فقط ألا تتسببـي
فـي قتل نفسـك , هلا فعلـتِ ؟

410
00:35:22.483 --> 00:35:24.606
أنـا سـأحـتـاج لعدد كبيـر منكـم

411
00:35:26.003 --> 00:35:28.123
<i>... سيـاتـل " تعيـش فـي حـالـة من الارهـاب " </i>

412
00:35:28.123 --> 00:35:32.056
<i>الشـرطـة مندهشـة من تصـاعـد
عمليـات القتـل و الاختفـاءات</i>

413
00:35:32.056 --> 00:35:34.099
<i>النظـريـات تتـراوح بيـن
... عصـابـة مـجـرمـيـن جـديـدة</i>

414
00:35:34.100 --> 00:35:36.403
<i>إلـى قاتـل متسلسل وحشـيّ نشـط </i>

415
00:35:36.404 --> 00:35:38.930
... كان معكم علـى الهواء مبـاشـرة -
إن الأمـر يـزداد سـوءاً -

416
00:35:38.930 --> 00:35:41.048
علينـا أن نفعـل شيئـاً

417
00:35:41.048 --> 00:35:45.270
الضـرر الذي يذيعـونـه يتطلـب
أكثـر من فـرد واحـد من نـوعنـا

418
00:35:45.270 --> 00:35:49.323
أكثـر بكثيـر
... إنهـم همجـيـون , مُلفتـون للانتبـاه

419
00:35:49.323 --> 00:35:51.083
" إنهـم " مـولـودون حـديـثـاً

420
00:35:52.360 --> 00:35:54.226
تقصد مصـاصـي دمـاء جـدد ؟

421
00:35:54.226 --> 00:35:56.412
فـي الشهـور القليلـة الأولـى
بعـد عمليـة التحـويـل

422
00:35:56.412 --> 00:35:58.925
حينهـا نكـون فـي أكثـر
... لحظـاتـنـا جـنـونـاً

423
00:35:58.925 --> 00:36:02.978
وحشيّـة و تعطشـاً للدم

424
00:36:02.978 --> 00:36:05.695
شـيء تتطلعيـن لـه

425
00:36:07.190 --> 00:36:10.729
لم يـدرّب أحـداً مصـاصـي الدمـاء
الجـدد هـؤلاء , لكن هذا ليس بعشـوائـي

426
00:36:11.143 --> 00:36:13.005
شخـص مـا يكوّن جيشـاً

427
00:36:13.716 --> 00:36:15.839
" الآن علينـا الذهـاب لـ " سيـاتـل

428
00:36:16.774 --> 00:36:18.805
جيـش من مصاصـي الدمـاء ؟

429
00:36:18.805 --> 00:36:20.480
و تـم تكوينـه لمقاتلـة أحـدهـم

430
00:36:20.480 --> 00:36:22.390
نحـن العشيـرة الوحيـدة
" القريبـة من " سيـاتـل

431
00:36:22.390 --> 00:36:23.595
... بغض النظـر عـن سبب تكوين هذا الجيـش

432
00:36:23.595 --> 00:36:25.955
إذا لـم نـوقفهـم , الـ " فـولتـوري " سيفعلـون

433
00:36:27.108 --> 00:36:29.434
أنـا مندهـش من أنهـم
جعلـوا الأمـر يطـول لهـذا الحـيـن

434
00:36:29.434 --> 00:36:30.967
ربمـا يكونـوا هـم خلـف هذا

435
00:36:31.967 --> 00:36:34.714
... ( فـي " إيطاليـا " , قـرأت أفكـار ( آرو

436
00:36:34.714 --> 00:36:36.432
( يـريـدنـي أنـا و ( أليـس
... أن ننضـم لـه

437
00:36:36.432 --> 00:36:39.741
لكنـه يعلـم أننـا لن نختـاره
مـا دامـت عائلتنـا حـيّـة

438
00:36:39.741 --> 00:36:42.429
قـد يحـلّ لـه الجيـش
هذه المشكلـة

439
00:36:45.683 --> 00:36:49.010
" شخص مفقـود "
( رايلـي بيـرز )

440
00:36:50.973 --> 00:36:54.503
أهـلاً
هل تنـاولـت العشـاء بعـد ؟

441
00:36:56.411 --> 00:36:58.836
لا , لـم أفعـل

442
00:37:01.889 --> 00:37:06.746
( هذا الفتـى ( رايـلـي بيـرز
اختفـى منذ أكثـر من سنـة

443
00:37:07.272 --> 00:37:11.234
و منـذ هذا الحيـن و والـداه المسكينـان
يمـلأون " سيـاتـل " بهـذه الأوراق

444
00:37:12.745 --> 00:37:14.661
أعتقـد أن عليهـم الاستسلام فحسـب

445
00:37:17.444 --> 00:37:20.417
أنـا لـم أكن لأستسلـم
... إذا كنتِ محلـه

446
00:37:22.211 --> 00:37:23.902
أبـداً

447
00:37:29.990 --> 00:37:32.916
<i>علي أن أفكـر فـي
... مـا سأقـولـه للنـاس</i>

448
00:37:33.049 --> 00:37:36.641
لمَ لن أكـون فـي المنـزل
فـي أعياد الميلاد

449
00:37:36.756 --> 00:37:39.220
لـمَ لـن أزورهـم

450
00:37:40.239 --> 00:37:42.556
لمَ لـن يـرونـي ثـانيـة أبـداً

451
00:37:43.002 --> 00:37:48.706
بعد عـدة عقـود , كل من تعرفينـه
... سيكـون قد مـات

452
00:37:49.676 --> 00:37:51.690
حُـلـت المشكلـة

453
00:37:56.191 --> 00:37:59.245
لمَ تعـارضنـي بشـدة
حيـال أن أكون مثلك ؟

454
00:37:59.448 --> 00:38:01.444
لقد أخـبـرتـك

455
00:38:03.851 --> 00:38:08.354
كن صادقـاً معـي
هنالك المـزيـد

456
00:38:08.976 --> 00:38:15.178
أنـا أعـرف عـواقـب القـرار
الذي تـتـخـذيـنـه

457
00:38:18.589 --> 00:38:24.442
لقد عشت خـلالـه
... و لأجعلـك تعانيـن من هذا

458
00:38:26.049 --> 00:38:28.924
... أنت تعتقديـن أننـي لـدي روح

459
00:38:28.924 --> 00:38:30.940
لكن هذا غيـر صحيـح

460
00:38:33.109 --> 00:38:38.811
لكن المجـازفـة بـروحـك
... فقـط كـي لا أخسـرك أبـداً

461
00:38:40.211 --> 00:38:42.888
سيكـون هذا أكثـر شـيء أنـانـي
أفعلـه فـي حـيـاتـي

462
00:38:46.982 --> 00:38:51.036
لقد اعتقـدت أنـك تخشـى
من أننـي سأكون مختلفـة

463
00:38:53.057 --> 00:38:56.979
... لـن أكون دافئـة

464
00:38:56.979 --> 00:38:59.028
و لـن تعـد رائـحـتـي كالسابـق

465
00:39:07.966 --> 00:39:10.871
( ستظليـن دومـاً حبيبتـي ( بيـلا

466
00:39:31.400 --> 00:39:34.600
حبيبتـي ( بيـلا ) لكن فقط أقل ضعفـاً

467
00:39:44.926 --> 00:39:47.068
يـا إلهـي , إن المكـان هنـا
فـي غـايـة الجمـال

468
00:39:52.607 --> 00:39:55.783
أليـس ) تخطط لحفلـة )
تـخـرج ضخمـة

469
00:39:56.789 --> 00:39:58.557
و التـي تكون مـدعـواً لهـا

470
00:40:02.504 --> 00:40:05.492
نعم , ظننت هذا

471
00:40:12.644 --> 00:40:13.899
مـاذا ؟

472
00:40:16.018 --> 00:40:18.235
أردت فقط أن أفعل
هذا بشكل مختلـف

473
00:40:19.056 --> 00:40:20.487
بشكل أكثـر لطفـاً

474
00:40:21.967 --> 00:40:23.943
لكن الـوقـت فد نفـد منـي الآن

475
00:40:25.288 --> 00:40:26.666
تفعل مـاذا ؟

476
00:40:27.381 --> 00:40:29.774
( عليك سمـاع الحقيقـة يـا ( بيلا

477
00:40:30.574 --> 00:40:33.109
استيعـاب كل خيـاراتـك الممكنـة

478
00:40:34.563 --> 00:40:36.389
... و عليك أن تـعـرفـي

479
00:40:37.777 --> 00:40:40.533
أننـي مغـرم بـكِ

480
00:40:41.584 --> 00:40:44.843
و أريـدكِ أن تختـاريـنـي
بـدلاً منـه

481
00:40:46.609 --> 00:40:48.411
اعتقـدت أنك تتفهـم الأمـر

482
00:40:51.567 --> 00:40:54.116
لا أشعـر هكذا تـجـاهـك -
لا أصـدق هذا -

483
00:40:54.116 --> 00:40:55.732
و مـا الذي تصـدقـه ؟

484
00:40:57.632 --> 00:40:59.708
هـذا هـو شعـوري

485
00:40:59.708 --> 00:41:03.557
أنت تشعريـن تـجـاهـي بشيء آخـر
لكنك لا تـوديـن الاعتـراف

486
00:41:04.563 --> 00:41:09.665
لذلك أنـا لن أستسلـم
... سأقـاتـل لأجـلك

487
00:41:12.345 --> 00:41:14.787
إلـى أن يتـوقـف قلبك عن النبـض

488
00:41:15.418 --> 00:41:17.112
حسـن , لن تضطـر للقتـال طـويـلاً إذاً

489
00:41:17.112 --> 00:41:19.510
أنت تتعجليـن فـي فعل هذا
لانـك تخشيـن من أن تغيـري رأيـك

490
00:41:19.510 --> 00:41:21.014
لا , هذا ليس صحيحـاً

491
00:41:22.537 --> 00:41:23.933
أعلـم مـا أبتغيـه

492
00:41:25.762 --> 00:41:28.688
... ( لـن تضطـري للتحـول من أجلـي يـا ( بيلا

493
00:41:29.489 --> 00:41:32.049
أو لتـوديـع أي شخـص

494
00:41:32.782 --> 00:41:35.790
أنـا بمقـدوري منحـكِ أكثـر منـه

495
00:41:36.277 --> 00:41:39.598
إنـه علـى الأرجـح لا يمكنـه
حـتـى تقبيلك من دون أن يـؤلمـكِ

496
00:41:42.022 --> 00:41:44.413
تشعـريـن بهذا ؟

497
00:41:44.413 --> 00:41:48.728
اللحـم و الدم و الـدفء

498
00:42:12.563 --> 00:42:13.619
( إدوارد )

499
00:42:13.619 --> 00:42:16.090
إذا لمستهـا رغمـاً عن رغبتهـا ثـانـيـة

500
00:42:16.090 --> 00:42:18.058
لا تفعـل هـذا -
هي لست متـأكـدة ممـا تـريـد -

501
00:42:18.058 --> 00:42:19.538
لا تفعـل هذا -
حسـن , دعنـي أقـل لك تلميـحـاً -

502
00:42:19.538 --> 00:42:23.631
انتظـرهـا حـتـى تقول هذا بنفسهـا -
مـوافـق , و ستفعـل -

503
00:42:23.631 --> 00:42:26.637
جـايكوب ) , اذهـب فحسـب )

504
00:42:26.637 --> 00:42:31.157
هـدئـوا من أعصابكـم
لنهـدئ الأمـور هنـا قليـلاً , حسـنـاً ؟

505
00:42:34.206 --> 00:42:35.828
مـا الخطـب ؟

506
00:42:39.240 --> 00:42:41.038
( لقد قبّلـت ( بيـلا

507
00:42:44.939 --> 00:42:47.222
... و هـي كسـرت يدهـا

508
00:42:48.547 --> 00:42:50.751
بينمـا كانت تلكمنـي فـي وجهـي

509
00:42:51.882 --> 00:42:54.275
الأمـر كلـه سـوء تفـاهـم

510
00:42:56.110 --> 00:42:59.573
إنـه مجـرد التـواء , ينبغـي أن
يُشفـى سـريعـاً

511
00:43:01.201 --> 00:43:04.166
تحـاوليـن لفت نظـر الشبـاب
ثـانيـة يـا ( بيـلا ) ؟

512
00:43:05.618 --> 00:43:08.717
لكمت مستذئبـاً فـي وجهـه -
مـؤذيـة -

513
00:43:08.717 --> 00:43:11.894
ستكونيـن " مولـودة حـديـثـة " قـويـة

514
00:43:11.894 --> 00:43:14.359
قـويـة كفايـة للتغلـب عليـك

515
00:43:19.913 --> 00:43:22.060
لا تقلقـي بشأنهـا

516
00:43:24.520 --> 00:43:26.645
عثـرت علـى أيـة آثـار ؟

517
00:43:26.645 --> 00:43:31.033
( لا أثـر للدخـيـل , لكن ( فيكتـوريـا
لا تنفـك تظهـر علنـاً

518
00:43:38.545 --> 00:43:40.019
... فلتثـرثـري مـع أحـد غيـري عـن

519
00:43:40.054 --> 00:43:43.824
كم أنـكِ سعيـدة كونـكِ
" ستصبحيـن " مـولـودة حـديـثـاً

520
00:43:45.545 --> 00:43:49.344
حسـن
... ( روزالـي )

521
00:43:51.563 --> 00:43:54.789
لا أفهـم مـا الذي فعلتـه و جعلـك
تكرهينـي كل هذا الكـره

522
00:43:57.683 --> 00:43:59.555
أنـا لا أكـرهـكِ

523
00:44:01.953 --> 00:44:04.716
... و لا أحـبـك تحـديـداً كذلك , لكن

524
00:44:09.465 --> 00:44:13.852
بيلا ) , أنـا أحسـدكِ ) -
مـاذا ؟ -

525
00:44:15.085 --> 00:44:17.563
هذا سخيـف -
لا , ليس كذلك -

526
00:44:19.623 --> 00:44:22.883
أنت لديـك خيـار
أمـا أنـا فلم يكن لـديّ

527
00:44:23.747 --> 00:44:25.262
لا أحـد منـا كان يمتلك ذاك الخيـار
علـى عكسـك

528
00:44:25.263 --> 00:44:28.463
و أنت تخـتـاريـن الخيـار الخـاطـئ

529
00:44:28.498 --> 00:44:31.573
لا يهمنـي إلـى أي مـدى
حـيـاتـك تعيسـة

530
00:44:32.302 --> 00:44:35.486
حيـاتـي ليست تعيسـة

531
00:44:38.146 --> 00:44:41.773
إنهـا ليست مثاليـة أيضـاً
لكن ما مـن شخـص حيـاتـه مثـاليـة

532
00:44:41.773 --> 00:44:46.075
حيـاتـي كانـت كذلك
مثـاليـة بكل معنـى الكلمـة

533
00:44:47.614 --> 00:44:49.865
هنـالـك أشيـاء مـا زلـت أريـدهـا

534
00:44:50.736 --> 00:44:52.822
... أن أتـزوج فـي منـزل منسّـق و زوج

535
00:44:52.822 --> 00:44:54.905
يقبلـنـي عندمـا يعـود للمنـزل

536
00:44:54.905 --> 00:44:57.059
عـائلـة لـي

537
00:44:57.743 --> 00:45:01.545
<i>رويـس كينـغ ) كان أكثـر العـزّاب كفـاءة )
فـي البلـدة</i>

538
00:45:02.340 --> 00:45:04.108
<i>كنت بالكـاد أعـرفـه</i>

539
00:45:08.420 --> 00:45:12.936
<i>لكنني كنت شـابـة
كنت أعشـق شيئـاً اسمـه حـب</i>

540
00:45:13.943 --> 00:45:15.509
<i>فـي آخـر ليلـة من حيـاتـي</i>

541
00:45:15.510 --> 00:45:17.508
<i>غـادرت منـزل صديـقـة لـي
في سـاعـة متـأخـرة</i>

542
00:45:17.509 --> 00:45:20.842
<i>و لم أكن بعيـدة عـن المنـزل -
هـا هـي ذا -</i>

543
00:45:20.842 --> 00:45:23.845
( روز )
تعالـي هنـا

544
00:45:23.845 --> 00:45:25.535
أمسـك هذا

545
00:45:26.122 --> 00:45:29.877
تعالـي هنـا
لقد كنـا ننتظـرك

546
00:45:31.499 --> 00:45:33.533
ها هـي ذا

547
00:45:35.104 --> 00:45:36.321
( رويـس )

548
00:45:37.457 --> 00:45:39.275
أنت ثمـل

549
00:45:39.575 --> 00:45:43.042
أليست جميلـة , ( جـون ) ؟
أخبـرتـك أنهـا جـذّابـة

550
00:45:43.042 --> 00:45:45.964
من الصعـب قـول هذا
و هـي مـرتـديـة كل هذه الملابـس

551
00:45:45.964 --> 00:45:50.269
مـا رأيـك يـا ( روز ) ؟
لمَ لا نخلـع بعضـاً من ملابسنـا ؟

552
00:45:50.269 --> 00:45:52.498
كف عن هذا

553
00:45:54.742 --> 00:45:57.291
سـأراك غـداً بينمـا تكون واعيـاً

554
00:45:58.965 --> 00:46:00.505
إلـى أين تظنيـن نفسك ذاهبـة ؟

555
00:46:00.505 --> 00:46:04.619
تـوقـف , اتـركنـي -
عـودي , ستفعليـن مـا آمـرك بـه -

556
00:46:09.977 --> 00:46:13.374
تـركـونـي ملقـاة فـي الشـارع
معتقدون أننـي ميتـة

557
00:46:13.374 --> 00:46:15.424
صدقينـي , لقد أردت أن أكون كذلك

558
00:46:16.974 --> 00:46:19.478
كاريـال ) وجـدنـي )
... لقد اشتـم رائـحـة الدم

559
00:46:19.478 --> 00:46:22.381
اعتقـدت أنـه كان يساعدنـي -
أنـا آسفـة -

560
00:46:25.156 --> 00:46:27.369
لقد أخـذت بثـأري منهـم

561
00:46:28.987 --> 00:46:30.985
كل علـى حـدة

562
00:46:30.985 --> 00:46:34.378
أبقيـت ( رويـس ) للنهايـة
حـتـى يعلـم أننـي قـادمـة

563
00:46:52.421 --> 00:46:55.028
لقد كنت دراميّـة قليلاً وقتهـا

564
00:47:03.641 --> 00:47:05.890
الأمـور تحسنـت
( بعدمـا عثـرت علـى ( إيميـت

565
00:47:08.964 --> 00:47:10.903
لكننـا سنظـل هكذا علـى الـدوام

566
00:47:14.921 --> 00:47:20.575
مجمـدون
لا نشيـخ أبـداً

567
00:47:20.610 --> 00:47:24.691
هذا أكثـر مـا أفتقـده
الامكـانيـات

568
00:47:25.470 --> 00:47:27.689
أن أكون جالسـة فـي شـرفـة أمـاميـة
... فـي مكـان مـا

569
00:47:28.264 --> 00:47:30.928
... بينمـا شعـر ( إيميـت ) الـرمـادي بجانبـي

570
00:47:30.928 --> 00:47:33.716
... محـاطيـن بـأحفـادنـا

571
00:47:34.902 --> 00:47:37.024
ضحكـاتهـم

572
00:47:38.652 --> 00:47:41.621
أتفهـم رغبتـكِ

573
00:47:48.435 --> 00:47:52.173
لكن مـا مـن شـيء أبـداً
... سـأريـده أكثـر مـن

574
00:47:53.786 --> 00:47:55.699
( إدوارد )

575
00:47:56.380 --> 00:47:58.059
أنت مخطئـة ثـانـيـة

576
00:48:00.225 --> 00:48:03.448
بعدمـا تتحـوليـن
... أكثـر شـيء ستـرغبـيـن بـه

577
00:48:04.561 --> 00:48:06.584
الشـيء الـذي
... ستقتليـن من أجلـه

578
00:48:08.518 --> 00:48:10.263
الـدم

579
00:48:16.044 --> 00:48:19.460
مـاذا قلـت بشأن
عـدم الظهـور علنـاً ؟

580
00:48:31.809 --> 00:48:33.739
... شـيء مـا قـادم

581
00:48:35.774 --> 00:48:40.450
شـيء أكبـر منـا كلنـا

582
00:48:41.268 --> 00:48:43.244
... و إذا كان لا يمكنكـم

583
00:48:44.384 --> 00:48:46.701
السيطـرة علـى أنفسكـم

584
00:48:48.565 --> 00:48:50.501
جميعنـا سنمـوت

585
00:48:55.023 --> 00:48:57.713
مـا حـدث قد حـدث
... فقط

586
00:49:00.059 --> 00:49:02.361
لا تتـركـوا شيئـاً خلفكـم

587
00:49:11.010 --> 00:49:14.142
لقد لفتـوا الكثيـر من الأنظـار

588
00:49:14.042 --> 00:49:16.454
" و كذلك " سكوتنـا

589
00:49:16.454 --> 00:49:19.991
لعـلّ الآخـريـن بـدأوا يشكـون فـي
" كفـاءة جمـاعـة الـ " فـولتـوري

590
00:49:20.685 --> 00:49:22.383
دعهـم

591
00:49:27.995 --> 00:49:30.315
( ربمـا علينـا استشـارة ( آرو

592
00:49:35.215 --> 00:49:37.589
قـرارات ( آرو ) مُـراقـبـة

593
00:49:39.665 --> 00:49:41.545
علينـا نـحـن اتخـاذ القـرار

594
00:49:43.640 --> 00:49:47.588
قـرري إذاً يـا أخـتـاه
لقـد حـان الـوقـت

595
00:49:48.850 --> 00:49:50.718
نعـم , هذا صحيـح

596
00:49:55.535 --> 00:49:59.376
إمـا أن نتـرك الجيـش يفعل
... مـا تم تكوينـه لأجـلـه

597
00:49:59.376 --> 00:50:01.134
أو ننهيـه

598
00:50:02.163 --> 00:50:04.751
... قـرارات , قـرارات

599
00:50:14.547 --> 00:50:15.661
... عندمـا كنا فـي الخـامسـة من عمـرنـا

600
00:50:15.661 --> 00:50:18.995
سألـونـا مـاذا نـريـد أن نصبـح
... عندمـا نكبـر

601
00:50:18.995 --> 00:50:23.657
....أجـوبـتـنـا كانت أشيـاء كـ
... " رائـد فضـاء " , " رئيـس "

602
00:50:23.657 --> 00:50:26.459
أو فـي حـالتـي , أميـرة

603
00:50:26.459 --> 00:50:28.999
عندمـا بلغنـا العاشـرة من عمـرنـا
... سألـونـا مـرة أخـرى

604
00:50:28.999 --> 00:50:32.055
و كانـت أجـوبتنـا
... " نـجـم مـوسيقـي " , " راعـي بقـر "

605
00:50:32.055 --> 00:50:34.894
أو فـي حـالتـي
" حـائـزة أوسمـة ذهبيـة "

606
00:50:34.894 --> 00:50:38.308
لكن و بمـا أننـا كبـرنـا الآن
يـريـدون منّـا جـوابـاً جـديـاً

607
00:50:39.365 --> 00:50:42.157
... حسـن , مـا رأيكـم بالتـالـي

608
00:50:42.157 --> 00:50:44.231
و مـن يـدري ؟

609
00:50:47.995 --> 00:50:50.198
هذا ليس وقـت اتـخـاذ
... قـرارات صعبـة و سـريـعـة

610
00:50:50.198 --> 00:50:52.873
هذا وقـت ارتكـاب الأخطـاء

611
00:50:52.873 --> 00:50:55.976
أن تستقـل القطـار الخـاطـئ
و تعلـق فـي مكـان مـا

612
00:50:55.976 --> 00:50:59.447
تقـع فـي الحـب ... كثيـراً

613
00:51:00.075 --> 00:51:01.496
... تتخصـص فـي الفلسفـة

614
00:51:01.531 --> 00:51:04.288
لأنـه من المستحيـل أن تـخـرج
بحيـاة مهنيـة محتـرمـة منهـا

615
00:51:04.290 --> 00:51:07.807
تغيـر رأيـك مـراراً و تكـراراً
لأنـه مـا مـن شـيء دائـم

616
00:51:08.983 --> 00:51:11.476
لذا فلترتـكـب أكبـر عـدد
... ممكـن من الأخطـاء

617
00:51:12.267 --> 00:51:14.724
بهذه الطـريـقـة , يـومـاً مـا
... عندمـا يسألونـا مـا نـريـد أن نكون

618
00:51:15.439 --> 00:51:20.418
لن يكون علينـا التخميـن
بل سنكون متـأكديـن

619
00:51:26.899 --> 00:51:30.715
* إذا كنت أمتلك تلك اللحظـة *

620
00:51:30.749 --> 00:51:33.539
* كنت لأجـمّـد العالـم *

621
00:51:33.574 --> 00:51:37.167
* و أُوقـف الساعـة من الـدوران *

622
00:51:37.202 --> 00:51:42.734
* هـذا الـوقـت ملكنـا *

623
00:51:44.227 --> 00:51:47.879
* هـذا الـوقـت ملكنـا *

624
00:51:47.914 --> 00:51:49.301
لقد أتيـتِ

625
00:51:49.601 --> 00:51:52.077
أهـلاً -
مـا رأيـك بخطـابـي ؟ -

626
00:51:52.077 --> 00:51:54.657
سلساً أو مستقـلاً أكثـر من اللازم ؟
هل كـرهتـه ؟

627
00:51:55.087 --> 00:51:57.945
لا , لقد أبليـت بـلاءاً مذهـلاً -
فعـلاً ؟ -

628
00:51:57.945 --> 00:52:02.303
و كـأننـي خُلقـت لأكون قـائـدة -
عظيـم , أحـب هذه الأغنيـة , هيـا بنـا -

629
00:52:04.289 --> 00:52:11.390
* و إذا متنـا , سنمـوت معـاً *

630
00:52:11.991 --> 00:52:26.451
لكننـا لن نمـوت *
* لأن حـبـنـا سيظـل للأبـد

631
00:52:26.993 --> 00:52:30.784
مـاذا تفعـل هنـا ؟ -
لقد دعـوتنـي , تتذكريـن ؟ -

632
00:52:31.513 --> 00:52:34.093
هل كانـت لكمتـي
غيـر كـافيـة بالنسبـة لك ؟

633
00:52:34.093 --> 00:52:36.316
لقد كنت أقصـد بهـا
سحـب دعـوتـي لك

634
00:52:36.316 --> 00:52:40.338
... اسمعي يـا ( بيلا ) , أعتـذر عـن

635
00:52:41.382 --> 00:52:44.724
... القبلـة و يـدكِ

636
00:52:44.724 --> 00:52:46.367
كنت لألقـي اللـوم علـى
... جـزئـي الحيـوانـي الـداخـلـي

637
00:52:46.367 --> 00:52:51.115
لكن أنـا فعـلاً من كـان
يتصـرف بغبـاء

638
00:52:51.954 --> 00:52:53.710
أنـا جـد آسـف

639
00:52:55.066 --> 00:52:56.634
أحضـرت لك شيئـاً

640
00:52:57.153 --> 00:53:00.817
هـديـة تخـرج
لقد صنعتهـا بيـدي

641
00:53:01.372 --> 00:53:04.611
صنعـت هذه ؟

642
00:53:05.557 --> 00:53:08.735
إنهـا جميـلـة جـداً
شكـراً

643
00:53:23.393 --> 00:53:24.853
سأعـود فـي الحـال

644
00:53:27.710 --> 00:53:30.871
أليـس ) , مـاذا تـريـن ؟ ) -
لقد تم حسـم القـرار -

645
00:53:30.871 --> 00:53:34.244
مـا الخطـب ؟ -
لستم ذاهبيـن لـ ( سياتـل ) ؟ -

646
00:53:34.244 --> 00:53:36.263
لا

647
00:53:36.263 --> 00:53:37.958
هـم الذيـن سيأتـون لهنـا

648
00:53:38.707 --> 00:53:42.240
سيكونـون هنـا خـلال 4 أيـام -
قـد يتحـول هذا لمـجـزرة -

649
00:53:42.612 --> 00:53:45.591
مـن خلـف هذا ؟ -
لـم أرَ شخصـاً أعـرفـه -

650
00:53:46.746 --> 00:53:48.856
ربمـا واحـد

651
00:53:48.856 --> 00:53:52.539
أعـرف وجـهـه
( إنـه مـواطـن , ( رايلـي بيـرز

652
00:53:53.058 --> 00:53:54.160
لا يُعقـل أنـه هو من بـدأ هذا

653
00:53:54.160 --> 00:53:56.610
أيـاً كـان من بـدأ هذا , فهـو لا يـريـد
أن يكون ظـاهـراً لنـا

654
00:53:56.610 --> 00:53:58.968
لا بـد من أنـه يحتّـل
البقـع العميـاء فـي رؤيـاكِ

655
00:53:58.968 --> 00:54:00.578
... بـأي حـال , الجيـش قـادم

656
00:54:00.578 --> 00:54:02.877
و ليس هنـالك عـدد
كـافٍ منـا لحمـايـة البلـدة

657
00:54:02.877 --> 00:54:05.594
مهلاً لحظـة
أي جـيـش ؟

658
00:54:05.594 --> 00:54:09.162
مولـودون حـديثـاً " , من نـوعنـا " -
مـا الذي يسعـون خلفـه ؟ -

659
00:54:09.162 --> 00:54:12.701
لقد كانـوا يتنـاوبـون علـى تمييـز
رائـحـة ( بيلا ) من قميـصهـا الأحمـر

660
00:54:12.701 --> 00:54:14.828
يسعـون خلـف ( بيـلا ) ؟

661
00:54:14.828 --> 00:54:17.950
مـا معنـى هذا ؟ -
... يعنـي معركـة عنيفـة -

662
00:54:17.950 --> 00:54:20.173
و أرواح مفقـودة

663
00:54:24.075 --> 00:54:25.780
... حسنـاً

664
00:54:26.080 --> 00:54:28.585
نـحـن معكم -
لا -

665
00:54:28.585 --> 00:54:30.679
سوف تتسببـون في
قتل أنفسكـم لا محـالـة

666
00:54:30.679 --> 00:54:35.201
لـم أكن أطلـب إذنـك -
( إدوارد ) -

667
00:54:38.552 --> 00:54:40.839
هذا سيـوفّـر لك حمـايـة أكثـر

668
00:54:41.454 --> 00:54:46.557
( جـايكـوب ) , هل تعتقـد أن ( سـام )
لـن يمـانـع فـي أن نتفـق ؟

669
00:54:47.873 --> 00:54:50.635
مـا دمنـا سنقتـل بعض مصـاصـي الدمـاء

670
00:54:50.635 --> 00:54:55.032
جـاسبـر ) ؟ ) -
سـوف يـزيـدونـا عـدداً -

671
00:54:55.032 --> 00:54:57.676
و المـولـودون حـديـثـاً لن
يعلمـوا بـوجـودهـم حـتـى

672
00:54:57.676 --> 00:55:00.393
هذا سيمنحنـا الأفضليّـة -
سـوف نـحـتـاج للتنسيـق -

673
00:55:00.393 --> 00:55:04.465
كـارليـال ) , سوف يتـأذون ) -
جميعنـا نـحتـاج لبعض التـدريـب -

674
00:55:04.465 --> 00:55:07.494
مقاتلـة المولـودون حـديـثـاً تتطلب
( معـرفـة كتلك التي يمتلكهـا ( جاسبـر

675
00:55:07.494 --> 00:55:09.349
أهـلاً بكم معنـا

676
00:55:10.892 --> 00:55:14.123
حسـن
أخبـرنـي الـزمـان و المكان

677
00:55:14.123 --> 00:55:15.746
... ( جـايـك )

678
00:55:15.746 --> 00:55:18.508
لا تعلـم مـا الذي تقحـم
نفسـك بـه

679
00:55:19.447 --> 00:55:21.324
... ( بيـلا )

680
00:55:21.424 --> 00:55:25.698
هذا عملنـا
يجـدر بك أن تكونـي سعيـدة

681
00:55:25.698 --> 00:55:28.768
انظـري إلينـا
نعمـل معـاً

682
00:55:28.768 --> 00:55:32.081
أنـت من أردتنـا أن نكون متفقيـن , تتذكريـن ؟

683
00:55:41.658 --> 00:55:43.111
مـجـدداً

684
00:55:56.285 --> 00:55:59.118
إنهـا هـديـة تـخـرج

685
00:56:17.624 --> 00:56:20.402
لا يثقـوا بنـا كفايـة لأن
يكونـوا فـي هيئتهـم البشـريّـة

686
00:56:20.402 --> 00:56:22.911
لقد قـدمـوا
هذا مـا يهـم

687
00:56:23.858 --> 00:56:25.783
هلا تـرجـمـت

688
00:56:30.793 --> 00:56:32.559
( أهلاً يـا ( جـايـك

689
00:56:37.817 --> 00:56:39.573
أهـلاً بكم

690
00:56:41.716 --> 00:56:44.269
جاسبـر ) لديـه خبـرة )
مـع المولـوديـن حـديثـاً

691
00:56:44.269 --> 00:56:46.464
سـوف يعلّمنـا كيف نهـزمهـم

692
00:56:48.916 --> 00:56:50.959
يـريـدون أن يعلمـوا كيـف المولـودين
حـديـثـاً يختلفـون عنّـا

693
00:56:52.085 --> 00:56:53.712
... إنهـم أقـوى منـا بكثيـر

694
00:56:53.712 --> 00:56:56.677
لأن دمهـم البشـري يقـل
فـي نسيجهـم

695
00:56:57.371 --> 00:57:01.134
نـوعنـا لا يكون أبـداً أكثـر
... قـوة جسديـة

696
00:57:01.134 --> 00:57:03.716
ممـا يكـون فـي الشهـور
القليلـة الأولـى من هذه الحيـاة

697
00:57:06.837 --> 00:57:09.002
كـارليـال ) محـق )

698
00:57:09.002 --> 00:57:11.362
لهذا السبب تم تكويـن جيشـاً منهـم

699
00:57:11.947 --> 00:57:15.846
" جيش من " المـولـوديـن حـديـثـاً
لا يـحتـاج للآلاف منهـم كجيـش البشـر

700
00:57:16.569 --> 00:57:18.947
و لا جيـش من البشـر
يمكن الـوقـوف ضـدهـم

701
00:57:20.818 --> 00:57:23.899
أهـم شيئيـن عليكم تـذكـره
... أولاً

702
00:57:23.899 --> 00:57:25.562
لا تسمحـوا لهـم
بـأن يمسكـوا بكـم أبـداً

703
00:57:25.562 --> 00:57:28.700
سـوف يسحقـونكـم فـي الحـال
... و ثـانـيـاً

704
00:57:30.274 --> 00:57:33.091
لا تستخدمـوا أبـداً وسـائل
قتلكـم الـواضـحـة

705
00:57:34.558 --> 00:57:39.660
سيتـوقـعـون هذا
و أنتـم ستخسـرون

706
00:57:41.201 --> 00:57:41.500
إيميـت ) ؟ )

707
00:57:41.501 --> 00:57:44.602
تـدعـو كل النـاس الذيـن تحبهـم *
* ليغنـوا لـك أغنيـة

708
00:57:44.603 --> 00:57:47.999
* حـتـى إذا كانـوا متمسكيـن بالهمهمـة *

709
00:57:48.000 --> 00:57:49.621
* ... تـأخـذ الأغنيـة كعذر لتـراهـم *

710
00:57:49.622 --> 00:57:54.187
لا تتـراجـع -
ليـس من طبيعتـي هـذا -

711
00:57:56.742 --> 00:58:01.460
عندمـا انهـزمـت *
* الجميـع أتـى ينـاديـك

712
00:58:02.809 --> 00:58:06.605
فقدت القدرة علـى الـتـحـرك *
* بعدمـا تـألمـت من الهزيـمـة

713
00:58:07.301 --> 00:58:08.860
لا تفقـد التـركيـز أبـداً

714
00:58:15.767 --> 00:58:19.686
عندمـا انهـزمـت *
* الجميـع أتـى ينـاديـك

715
00:58:22.110 --> 00:58:26.246
تلاشيـت بعدمـا تـألمـت *
* من الهـزيـمـة

716
00:58:29.978 --> 00:58:31.292
... شـيء آخـر

717
00:58:32.191 --> 00:58:34.803
لا تـدر أبـداً ظهـرك للعـدو

718
00:58:34.804 --> 00:58:38.881
* و بالمناسبـة , كلنـا تـم استدعـائـنـا *

719
00:58:42.722 --> 00:58:46.172
* نـحـن مستعديـن يـا عـزيـزتـي *

720
00:58:46.173 --> 00:58:47.912
* أمتلك كل المهـارات *

721
00:58:47.913 --> 00:58:55.093
* لقد سمـحـتِ لنـا بمنـح حـبـنـا لكِ *

722
00:58:55.231 --> 00:58:58.754
* كل شـيء علمتنـي إيـاه يـا عـزيـزتـي *

723
00:58:58.755 --> 00:59:01.496
* لـم يهمّنـا فعـلاً حـتـى *

724
00:59:01.497 --> 00:59:07.521
* بـل حـبـنـا لكِ هـو مـا يهـم *

725
00:59:21.955 --> 00:59:23.735
بعضكـم سيتـأذى

726
00:59:27.057 --> 00:59:30.859
بعضكـم قد يتعـرض
للقتـل بسببـي

727
00:59:33.498 --> 00:59:35.956
سيكون الأمـر أسـوء من هـذا
ألـف مـرة , صحيـح ؟

728
00:59:59.062 --> 01:00:01.099
لقد انتهينـا لليـوم

729
01:00:13.668 --> 01:00:15.695
... ( جاسبـر )

730
01:00:18.188 --> 01:00:21.122
متـأكـد أنـه ما مـن شـيء
يمكننـي فعلـه للمسـاعـدة ؟

731
01:00:21.122 --> 01:00:24.751
حضـورك وحـده سيساعدنـا
رائحتـك ستجذب المـولـوديـن حـديـثـاً

732
01:00:24.751 --> 01:00:29.161
غـريـزة الصيـد لديهـم ستسيطـر
عليهـم و تفقدهـم صـوابهـم

733
01:00:30.283 --> 01:00:32.417
جـيـد , يسرنـي هذا

734
01:00:34.209 --> 01:00:35.795
لحظـة

735
01:00:36.095 --> 01:00:38.250
كيف تعـرف الكثيـر بشأن هذا ؟

736
01:00:39.773 --> 01:00:44.232
لم أحـظَ تمـامـاً بنفس التنشئـة التـي
حظـي بهـا أشقـائـي بالتبنـي

737
01:00:50.168 --> 01:00:51.797
هذه العضـات تشبـه عضتـي

738
01:00:52.640 --> 01:00:54.193
نـدوب معـارك

739
01:00:55.744 --> 01:00:58.477
كل التـدريـب الذي حظيت عليـه من
... " الجيـش المتحـالـف "

740
01:00:58.477 --> 01:01:00.775
كـان عـديـم الفـائـدة
" أمـام " المـولـوديـن حـديـثـاً

741
01:01:01.836 --> 01:01:05.785
و مـع ذلك لم يسبـق
لـي أن خسـرت معـركـة

742
01:01:10.616 --> 01:01:13.590
هذا حصـل خـلال
الحـرب الأهليـة ؟

743
01:01:13.590 --> 01:01:16.442
" لقد كنت أصغـر " رائـد
" فـي خـيّـالـة " تكسـاس

744
01:01:16.442 --> 01:01:19.288
كل هذا مـن دون حـتـى
حضـور معـركـة حقيقيـة

745
01:01:19.288 --> 01:01:20.504
... إلـى أن

746
01:01:22.298 --> 01:01:24.657
حـتـى قابلـت خـالِـدة معينـة

747
01:01:24.975 --> 01:01:26.809
( مـاريـا )

748
01:01:31.510 --> 01:01:36.107
" كنت عائـداً أدراجـي إلـى " غالفيستـون
... بعـد إجـلاء عـدداً من النسـاء و الأطفـال

749
01:01:36.240 --> 01:01:37.632
... عندهـا رأيتهـن

750
01:01:38.781 --> 01:01:40.936
عـرضـت عليهن مساعدتـي فـي الحـال

751
01:01:48.615 --> 01:01:51.803
جميـل , و ضـابـط

752
01:01:58.770 --> 01:02:00.643
( يجـدر بك فعل هذا يـا ( مـاريـا

753
01:02:00.644 --> 01:02:06.256
لا يمكننـي التـوقـف أبـداً مـا دمـت قـد بـدأت

754
01:02:06.773 --> 01:02:11.559
مـا اسمك , أيهـا الجنـدي ؟ -
الـرائـد ( جاسبـر ويتلـوك ) , سيدتـي -

755
01:02:11.559 --> 01:02:13.308
آمـل أن تنجـو

756
01:02:14.429 --> 01:02:17.790
قد تساعدنـي كثيـراً

757
01:02:22.656 --> 01:02:24.685
مـاريـا ) كانت تكوّن جيشـاً ؟ )

758
01:02:24.685 --> 01:02:26.825
لقد كانت الجيـوش
شائـعـة جـداً فـي الجنـوب

759
01:02:26.825 --> 01:02:30.535
معـارك شنيعـة مستمـرة
للاستيـلاء علـى أراضـي الدولـة

760
01:02:30.535 --> 01:02:32.570
مـاريـا ) انتصـرت فـي كل المعـارك )

761
01:02:33.424 --> 01:02:38.427
كانت ذكيـة , حـذرة
و كـانـت مستحـوذة علـيّ

762
01:02:40.875 --> 01:02:43.721
<i>كنت نـائبهـا</i>

763
01:02:43.721 --> 01:02:47.568
<i>قـدراتـي علـى التـحـكـم
بمشـاعـري خـدمتهـا جـيـداً</i>

764
01:02:48.468 --> 01:02:50.477
<i>لقد دربـت مـولـوديهـا الحـديثيـن</i>

765
01:02:53.535 --> 01:02:57.951
<i>مهنـة لا نهائيـة كونهـا لا تجعلهـم
يعيشـوا أكثـر من سنـة كمصاصـي دمـاء</i>

766
01:03:00.951 --> 01:03:03.373
<i>كان عملـي هـو التخلص منهـم</i>

767
01:03:23.959 --> 01:03:26.835
<i>كان يمكننـي الشعـور
بكل مـا كـانـوا يشعـرون بـه</i>

768
01:03:39.427 --> 01:03:42.150
اعتقـدت أننـي أنـا
و ( مـاريـا ) كنا نتشـارك الحـب

769
01:03:43.539 --> 01:03:48.241
لكننـي كنت دميتهـا , و هـي
كـانـت المتحكمـة بـي

770
01:03:49.409 --> 01:03:51.868
لم أكـن أعلـم
... أنـه كان هنالك سبيـلاً آخـر

771
01:03:53.755 --> 01:03:55.794
( حـتـى التقيـت بـ ( أليـس

772
01:03:57.295 --> 01:04:00.306
لا بـد مـن أنهـا رأتنـي قـادمـاً

773
01:04:00.306 --> 01:04:02.691
جعلتنـي أنتظـر طـويـلاً

774
01:04:06.251 --> 01:04:08.225
أعتـذر يـا سيـدتـي

775
01:04:09.882 --> 01:04:11.970
لا أعلـم مـاذا كنت لأصبـح
مـن دونـهـا

776
01:04:14.743 --> 01:04:17.226
ليس عليك أن تكون هكذا ثـانيـة

777
01:04:44.931 --> 01:04:47.034
( جـاسبـر )

778
01:04:47.341 --> 01:04:49.388
أريـدك أن تفعل شيئـاً

779
01:04:49.235 --> 01:04:53.072
اقتلهـا

780
01:05:06.265 --> 01:05:07.342
مـا الأمـر ؟

781
01:05:11.022 --> 01:05:14.126
... الـدخـيـل

782
01:05:14.126 --> 01:05:16.422
جيش المـولـوديـن حـديـثـاً

783
01:05:18.046 --> 01:05:20.528
كلهـم دمـى فـي يدهـا

784
01:05:22.480 --> 01:05:23.941
( فيكتـوريـا )

785
01:05:25.032 --> 01:05:28.320
كانت لتـرى ( أليـس ) قـرارهـا
بـأن تكـوّن جيشـاً

786
01:05:28.320 --> 01:05:31.497
... إلا إذا كـانـت تختبـئ خلفهـم

787
01:05:31.197 --> 01:05:33.482
و تـدع شخصـاً آخـر يقـرر عنهـا

788
01:06:02.054 --> 01:06:04.306
أهـلاً بك فـي الجيـش

789
01:06:13.487 --> 01:06:14.344
... لـن أختبـئ فحسـب

790
01:06:14.344 --> 01:06:16.345
بينمـا تعـرضـون أنفسكم
للخطـر من أجـلـي ؟

791
01:06:18.001 --> 01:06:18.862
( إذا كـانـت ( فيكتـوريـا
... هـي من وراء هـذا

792
01:06:18.862 --> 01:06:21.412
علـي أن أبقيـك بعيـدة
كفـايـة عـن المعـركـة

793
01:06:21.412 --> 01:06:23.713
جاسبـر ) قـال أنـه )
يمكننـي مساعدتكـم

794
01:06:23.713 --> 01:06:25.073
لن نـحتـاج لمساعـدتـك

795
01:06:25.073 --> 01:06:27.866
انتصـارنـا مضمـون مـا دامـت
الذئـاب فـي صفنـا

796
01:06:27.866 --> 01:06:30.034
بقيتنـا لـن يـجـدوا
شيئـاً يفعلـوه

797
01:06:30.657 --> 01:06:32.885
حسـن , هـل الأمـر خطـر
... لـدرجـة أنـه علـي الاخـتـبـاء

798
01:06:32.885 --> 01:06:35.015
أو أنـه سهل لدرجـة أنكـم ستكـونـوا
مجـرد متفـرجـيـن , أيـاً منهـم ؟

799
01:06:35.015 --> 01:06:37.693
الأمـر خطـر بالنسبـة لك
و سهـل علينـا

800
01:06:39.533 --> 01:06:41.803
أعتقـد أنـه من الخطـر أن ننفصـل

801
01:06:42.634 --> 01:06:44.628
كم مـرة علينـا أن نثبـت هذا ؟

802
01:06:45.303 --> 01:06:48.755
أنـا سأكون قلقـة
أنت ستكون قلقـاً

803
01:06:48.755 --> 01:06:51.030
و سيكون كـلاً منـا مستضعفـاً أكثـر

804
01:06:52.810 --> 01:06:53.896
حسـن , أنـت محقـة

805
01:06:55.301 --> 01:06:56.672
لذلك أنا قادمـة معكـم

806
01:06:56.672 --> 01:06:58.617
لا , علينـا الابتعـاد عـن المعـركـة سـويـاً

807
01:06:59.391 --> 01:07:02.299
لا يمكننـي أن أجعلك تختـار
... بينـي و بين عائلتـك , إن هذا

808
01:07:02.299 --> 01:07:04.953
الوسيلـة الـوحـيـدة التي يمكننـي بهـا
حمـايتـك هـي البقـاء معـكِ

809
01:07:09.493 --> 01:07:11.334
لـن تقـاتـل ؟

810
01:07:11.334 --> 01:07:13.490
هل عضلاتـك مـرهـقـة أو ما شـابـه ؟

811
01:07:13.490 --> 01:07:16.453
إنـه يفعـل هذا لأجـلـي , حسنـاً ؟ -
لا يهـم -

812
01:07:17.272 --> 01:07:18.669
فقط أعلمـونـي بالخطـة

813
01:07:19.411 --> 01:07:21.687
هذا المـوقـع سيمنحنـا
الأفضليّـة فـي المعـركـة

814
01:07:21.687 --> 01:07:24.219
" علينـا إغـراء " المـولـوديـن حـديـثـاً
( بـرائـحـة ( بيـلا

815
01:07:25.079 --> 01:07:26.783
و الـرائـحـة عليهـا
ألا تتعـدى هذا المكـان

816
01:07:26.783 --> 01:07:28.450
أنـا و ( إدوارد ) سنذهـب
لمكـان للتخييـم

817
01:07:28.450 --> 01:07:31.402
حـتـى إذا حملنـي , سيظـل
فـي وسعهـم التقـاط رائـحـتـنـا

818
01:07:31.833 --> 01:07:33.956
" لكن رائـحـتـك علـى أي حـال " مقـززة

819
01:07:33.956 --> 01:07:36.131
لا أظنـك تـريـد أن تبـدأ فـي المقـارنـة
بيـن روائـح كلاً منـا يـا صـاح

820
01:07:36.131 --> 01:07:40.685
مـا يقصـده هـو أن رائـحتـك ستغطـي
علـى رائـحـتـي إذا حملتنـي

821
01:07:40.685 --> 01:07:42.159
عُلـم

822
01:07:42.159 --> 01:07:43.723
هذه ليست بفكـرة جـيـدة

823
01:07:43.723 --> 01:07:44.902
( إدوارد )

824
01:07:44.902 --> 01:07:49.110
لـن يـرغبـوا فـي أن يقتـربـوا
و لـو بقليـل مـن ... رائـحـتهـم

825
01:07:49.110 --> 01:07:50.875
حسـن , لنـجـرب الأمـر

826
01:07:53.876 --> 01:07:56.747
ها هـي رائـحـة الذئـاب قادمـة -
اركـض -

827
01:08:06.434 --> 01:08:09.307
ستطلبيـن منـي الانسحـاب
من المعـركـة أنـا الآخـر ؟

828
01:08:09.307 --> 01:08:11.746
أو أن سلامتـي لا تهمـك ؟

829
01:08:11.746 --> 01:08:15.088
بالتـأكيـد تهمنـي
لكنك كنت لتـرفـض

830
01:08:15.682 --> 01:08:17.446
لم يعـد بيـدي خيـاراً بـأيـة حـال

831
01:08:18.381 --> 01:08:21.093
( بمـا أننـي جعلـت ( سـام
يكـون هـو القـائـد

832
01:08:21.093 --> 01:08:23.303
علـي تقبّـل الأوامـر التـي يلقيهـا

833
01:08:23.902 --> 01:08:26.118
( أنـت من تـرك ( سـام
يكون القـائـد ؟

834
01:08:27.119 --> 01:08:28.962
أنـا لم أرد أصـلاً أن أكون ضمـن
... مجمـوعـة الذئـاب

835
01:08:29.067 --> 01:08:32.739
نـاهيـكِ عـن أن أكون قـائـدهـم

836
01:08:32.878 --> 01:08:34.319
عجبـاً

837
01:08:35.403 --> 01:08:39.395
( أيهـا القائـد ( جـايكـوب -
... لقد تخليـت عن هذا المنصـب -

838
01:08:39.395 --> 01:08:42.355
لكن كل خيـار لـه عـواقبـه

839
01:08:42.355 --> 01:08:45.381
بعضهـم أكثـر من الآخـر -
لا تبـدأ إذاً -

840
01:08:45.381 --> 01:08:48.317
الجميـع يتـخـذون قـرارات
و سيتعيـن عليك تقبـل قـراري

841
01:08:48.317 --> 01:08:51.018
يمكنك أن تحبـي أكثـر
من شخـص فـي الـوقـت عينـه

842
01:08:51.864 --> 01:08:55.623
لقد رأيـت هذا , مـع
( سـام ) , ( إيميلـي ) و ( ليـا )

843
01:08:57.022 --> 01:08:58.107
... حسـن

844
01:08:58.107 --> 01:09:02.388
" لست ذئبـة , لا يمكننـي " الشغـف -
" ليس لهذا علاقـة بـ " الشغـف -

845
01:09:03.069 --> 01:09:06.847
إن هذا يتعلـق ... بـامتـلاكـك
لشعـور معيـن تـجـاه شخـص مـا

846
01:09:07.388 --> 01:09:10.226
و أعـرف أنـك تشعـريـن
بشـيء حـيـالـي

847
01:09:11.239 --> 01:09:13.505
يمكننـي أن أشعـر
... بمـا أجعلك تشعـريـن بـه

848
01:09:13.505 --> 01:09:15.132
جسديـاً

849
01:09:16.271 --> 01:09:18.103
أنـا أجعلـك متـوتـرة

850
01:09:22.433 --> 01:09:23.873
( جـايـك )

851
01:09:25.677 --> 01:09:26.926
لا تقلقـي

852
01:09:28.034 --> 01:09:30.655
لقد وعـدتـك بـأننـي لن أقبلك
إلا ذا طلبـتِ منـي

853
01:09:31.990 --> 01:09:34.962
و ستضطـر لأن تبقـى علـى وعـدك
لفتـرة مـن الـزمـن , أيهـا القـائـد

854
01:09:38.663 --> 01:09:42.751
كل ما التقطتـه هـو رائـحـة الذئـب
( و لم ألتقـط التـي تخص ( بيـلا

855
01:09:45.387 --> 01:09:48.656
هذا سيفلـح -
عظيـم -

856
01:09:58.344 --> 01:10:00.597
حسـن يـا ( أليـس ) , لا تحـرمينـا زيـارتـكِ -
حسـن -

857
01:10:02.933 --> 01:10:05.074
حـجـة غيـابـك للمعـركـة
باتـت جـاهـزة

858
01:10:05.074 --> 01:10:06.369
حـقـاً ؟

859
01:10:06.369 --> 01:10:09.065
أخبـرت أبيك أن عائلتـي ستذهـب
للتخييـم نهايـة هذا الأسبـوع

860
01:10:09.065 --> 01:10:12.013
لذا ستضطـريـن للمبيـت
فـي منـزلـي

861
01:10:12.829 --> 01:10:15.391
تشـارلـي ) ذاهـب للصيـد علـى كلٍ ) -
تشـارلـي ) ؟ ) -

862
01:10:16.372 --> 01:10:18.540
أصبحتـم تنـادون بعضكـم
بأسمـائـكم الأولـى الآن ؟

863
01:10:18.540 --> 01:10:20.381
هـو المعجـب بـي

864
01:10:21.367 --> 01:10:24.370
فـي الحقيقـة , المنـزل سيكون
لكِ أنـتِ و ( إدوارد ) فحسـب الليلـة

865
01:10:28.113 --> 01:10:29.924
بمفـردنـا ؟

866
01:10:29.924 --> 01:10:33.488
جميعنـا ذاهبـون للصيـد
نستجمـع قـوانـا لأجـل المعـركـة

867
01:10:36.083 --> 01:10:37.717
علـى الـرحـب

868
01:10:39.438 --> 01:10:43.714
أهلاً , تـريـديـن شطيـرة ؟ -
لا , شكـراً -

869
01:10:45.224 --> 01:10:48.314
حسـن , تعجبنـي شقيقتـه

870
01:10:48.314 --> 01:10:51.864
( أليس )
نعـم , إنهـا رائـعـة

871
01:10:59.117 --> 01:11:01.523
أبـي
... لقد كنت أتسـاءل

872
01:11:02.656 --> 01:11:06.173
لـمَ لـم تتـزوج ثـانـيـة
بعـد أمـي ؟

873
01:11:10.244 --> 01:11:11.595
... لا أعلـم

874
01:11:13.085 --> 01:11:15.515
أعتقـد أننـي لم أقـابـل
المـرأة المناسبـة بعـد

875
01:11:17.444 --> 01:11:20.068
لمـاذا ؟ -
لا أعلـم -

876
01:11:22.883 --> 01:11:24.575
... خـلـت فقط أنـك

877
01:11:24.575 --> 01:11:26.963
ربمـا استسلمـت تمـامـاً
... فيمـا يتعلـق بـه

878
01:11:27.963 --> 01:11:29.626
فيمـا يتعلـق بالـزواج

879
01:11:31.039 --> 01:11:33.199
لكن هل تعتقـد
أن لـه أيـة قيمـة ؟

880
01:11:35.077 --> 01:11:37.059
نعـم

881
01:11:37.059 --> 01:11:38.616
