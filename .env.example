# ── TMDB Server Token (ضع التوكن هنا وفي إعدادات Vercel Environment Variables) ──
TMDB_TOKEN=your_tmdb_read_access_token_here

# ── API-Football server key (keep server-only; never use a VITE_ prefix) ──
API_FOOTBALL_KEY=your_api_football_key_here

# ── Optional deployed API-Football proxy URL for Electron builds ──
# VITE_API_FOOTBALL_PROXY_URL=https://your-site.vercel.app/api/football

# ── GitHub Subtitles Repository Base URL (اختياري - رابط مستودع الترجمات على GitHub) ──
VITE_SUBTITLES_BASE_URL=https://raw.githubusercontent.com/hwto-kurd/subtitles/main/subtitles

# ── Firebase Auth Configuration (أو ضعها مباشرة داخل src/utils/firebase.js) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
