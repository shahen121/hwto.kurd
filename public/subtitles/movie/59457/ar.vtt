307
01:11:15.400 --> 01:11:18.684
طـابت لَـيـلتُـكَ ، ـ(تـومـي)ـ

308
01:11:34.574 --> 01:11:37.775
سـيـكـونُ كـلَّ شـيءٍ عـلـى مـايـرام ، حـبـيـبـي

309
01:12:31.302 --> 01:12:34.170
!.صـبـاحُ الـخـيـر

310
01:12:36.472 --> 01:12:41.095
..أمـيّ
!.صـبـاحُ الـخـيـر

311
01:12:41.930 --> 01:12:47.266
غـريـب .. كأنـي بـالـمـرحـلـة الجـامـعـيـه

312
01:12:48.849 --> 01:12:52.181
ومـاحـولـي كـأنـه صـفـيـحٌ صـدئ

313
01:12:52.182 --> 01:12:56.851
أعـتـقـدُ بـأنـه لـيـسَ حـتـى صـفـيـحً .. بـل كـانَ
صـهـريـج

314
01:13:00.835 --> 01:13:05.010
وإذ بـي أمـشـي وأصـدرُ صَـريـراً ، كـأنـي رجـلٌ
آلـي طـاعـنٌ بـالـسـن

315
01:13:09.106 --> 01:13:14.346
عـنـدمـا مِـلـتُ إلـى الأسـفـل، تـدفـق سـائـل
مـن الـنـوع الـصـدئ مـن فـمـي

316
01:13:16.692 --> 01:13:19.442
كـانَ بـارداً

317
01:13:23.737 --> 01:13:26.938
طـابَ صـبـاحـك

318
01:13:30.989 --> 01:13:34.854
أمـي ، هـذه ـ(مـونـيـكـا)ـ
ـ(مـونـيـكـا)ـ ، هـذه أمّـي

319
01:13:35.824 --> 01:13:38.906
مـرحـبـاً -
أهـلـن -

320
01:13:42.535 --> 01:13:45.569
بـمـاذا حـلـمـتـي .؟

321
01:13:47.620 --> 01:13:50.572
لا شـيء

322
01:13:54.872 --> 01:13:58.073
فـلـتـنـعـمـوا بـ

323
01:14:10.854 --> 01:14:13.997
هـل أيـقـضـنـاكِ عـنـدمـا أتـيـنـا ليـلـةَ أمـس .؟

324
01:14:15.671 --> 01:14:18.753
لـم أكـن نـائـمـه -
لاكـن كـان بـوقـتِ الـفـجـر -

325
01:14:19.547 --> 01:14:22.879
ألا تـنـامـيـنَ أبـداً ، أمـي .؟

326
01:14:24.549 --> 01:14:27.501
أحـيـانـاً

327
01:14:33.427 --> 01:14:36.841
ـ(مـونـيـكـا)ـ خـرجـت لـتـحـضـر بـعـض الأشـيـاء
سـتـكـونُ هـنـا قـريـبـاً

328
01:14:38.262 --> 01:14:42.008
سـتـمـكـثُ هـنـا لـفـتـرة ، أعـنـي بـالـطـبـع إذا لـم
يـكـن لـديـكِ مـانـعـاً فـي ذلـك

329
01:14:46.080 --> 01:14:47.052
أمّـي .؟

330
01:14:49.555 --> 01:14:51.886
هـيَ فـتـاه لـطـيـفـه

331
01:14:53.817 --> 01:14:57.224
يـسـرّنـي تـواجـدهـا هـنـا

332
01:15:11.440 --> 01:15:15.270
لـديِّ هـذه الـفـكـره
وأحـبُ أن أفـكـرَ بـهـا

333
01:15:15.425 --> 01:15:20.275
..تـخـيـلـي عـاصـفـةٌ ثـلـجـيـه فـوق الـمـحـيـطـات
تـكـون عـلـى الـجـبـال فـي أعـمـاق الـغـيـوم

334
01:15:20.276 --> 01:15:22.212
لـمـلايـيـن الـسـنـيـن عـلـى هـذا الـكـوكـب

335
01:15:22.213 --> 01:15:24.556
لـديـهـا الـبـلايـيـن مـن بـلـورات الـثـلـج الـصـغـيـره
الـمـتـجـمـعـه

336
01:15:24.557 --> 01:15:28.763
ولايـوجـد شـبـيـه لـكـل زوجـيـن مـنـهـمـا
مـثـلـنـا فـي الـحـقـيـقـه

337
01:15:28.998 --> 01:15:32.060
نـحـنُ الـبـشـر .؟ -
نـعـم ، ومثـلـنـا الإثـنـيـن -

338
01:15:32.068 --> 01:15:35.253
أفـكـرُ بـكـل الأشـيـاء الـحـيـه ، لـيـسـت فـقـط الـلـتي
لـديـهـا وجـوهٌ وبـصـمـات أصـابع

339
01:15:35.254 --> 01:15:39.241
لاكـن كـوظـيـفـة عـمـل الـرئـه مـن الـداخـل
أو قـرنـيـة الـعـيـن أو بـيـئـة عـمـل أدمـغـتـنـا

340
01:15:39.241 --> 01:15:41.094
أو أضـافـرنـا ، كـمـا تعـلـمـيـن ، كـل مـايـتـعـلـقُ بـنـا

341
01:15:41.246 --> 01:15:45.040
أعـنـيّ فـكـري بـالـمـوضـوع ، مـنـذُ مـتـى والـطـيـورُ هـنـا .؟
بـالـطـبـع لـم يـكـونـوا أبـعـدَ مـن عـهـد الـديـنـاصـورات

342
01:15:45.041 --> 01:15:48.637
أسـاسـاً، قـبـلـنـا بـكـثـيـر ، هـل لـكِ أن تـتـخـيـلـي بـلايـيـن
الـريـش الـلـتـي خُـلـقـت بـهـا الأنـواع

343
01:15:48.995 --> 01:15:52.326
لـنـقـل ، الـنـعـامـة إلـى طـيـور الـخـرشـنـة الـمـائـي ، إلـى
الـطـيـور الـطـنـانـة ، إلـى الأطـيـش ، إلـى الـبـطـاريـق

344
01:15:52.746 --> 01:15:55.043
فـي كـل مـكـان فـي الـعـالـم ، يـجـب أن يـكـون مـداريـاً

345
01:15:55.044 --> 01:15:58.115
الـبـلايـيـن مـن بـلايـيـن الـمـرات مـن الـبـلايـيـن
كـمـا تعـرفـيـن

346
01:15:58.680 --> 01:16:02.620
لايـوجـد تـشـابـه بـيـن إثـنـيـن ، هـذه ريـش الـبـطـه

347
01:16:03.250 --> 01:16:07.149
مـبـهـم تـقـريـبـاً ، الـبـلايـيـن مـنـهـا عـيـّنـات مـن
خـلـيـط بـشـكـلٍ مـذهـل

348
01:16:07.150 --> 01:16:10.035
يـلـتـفُ بـشـكـل دائـم حـولـنـا
ولاتـتـكـررُ أنـواعـهـم أبـداً

349
01:16:14.027 --> 01:16:15.675
مـالـخـطـب .؟

350
01:16:15.676 --> 01:16:19.245
..لا أعـرف ، ـ(تـومـي)ـ
إنـه لـ ـ

351
01:16:21.514 --> 01:16:23.973
لـكـلامٍ غـيـر نـاضـج

352
01:16:23.974 --> 01:16:28.068
حـقـاً .؟ -
نـعـم ، حـقـاً -

353
01:16:29.426 --> 01:16:31.221
لـذا .؟

354
01:16:33.001 --> 01:16:36.981
لـذا ، مـاذا .؟ -
هـل تـحـبـي الأطـفـال .؟ -

355
01:17:17.642 --> 01:17:18.934
تـفـضـل بـالـدخـول

356
01:17:20.211 --> 01:17:21.589
مـرحـبـاً أمّـي

357
01:17:22.152 --> 01:17:24.855
رائـحـه زكـيـه ، ألـيـسَ كـذلـك .؟

358
01:17:25.203 --> 01:17:28.653
أعـدتـهـا ـ(مـونـيـكـا)ـ ، كـنـتُ الـطـاهـي فـقـط
(يـنـقـلُ لـهـا الـوصـفـات)

359
01:17:29.089 --> 01:17:32.481
كـانَ طـاهـيـاً مـطـيـعاً جـداً -
شـكـراً لـكِ -

360
01:17:35.824 --> 01:17:38.657
