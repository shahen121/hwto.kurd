rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // كل مستخدم مسجل يملك فقط صلاحية القراءة والكتابة لبياناته الشخصية (المشاهدات، المفضلة، السجل)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
